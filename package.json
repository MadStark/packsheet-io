{
  "name": "packsheet-io",
  "type": "module",
  "version": "0.0.1",
  "license": "AGPL-3.0-only",
  "author": "Queensway Studios Limited",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MadStark/packsheet-io.git"
  },
  "engines": {
    "node": ">=22.12.0 <23"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "build:production": "cross-env PUBLIC_SITE_ENV=production CLOUDFLARE_ENV=production astro build",
    "build:staging": "cross-env PUBLIC_SITE_ENV=staging CLOUDFLARE_ENV=staging astro build",
    "preview": "astro preview",
    "preview:production": "npm run build:production && astro preview",
    "astro": "astro",
    "check": "astro check && tsc --noEmit && eslint . && prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "db": "scripts/supabase.sh",
    "db:start": "scripts/supabase.sh start",
    "db:stop": "scripts/supabase.sh stop",
    "db:reset": "scripts/supabase.sh db reset",
    "db:status": "scripts/supabase.sh status",
    "db:types": "scripts/database-types.sh write",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.2.0",
    "@astrojs/sitemap": "^3.7.3",
    "@astrojs/vue": "^7.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.2.0",
    "lucide-vue-next": "^1.0.0",
    "tailwindcss": "^4.3.3",
    "vue": "^3.5.40"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "@eslint/js": "^10.0.1",
    "@supabase/supabase-js": "^2.112.2",
    "@types/pg": "^8.21.0",
    "astro-eslint-parser": "^1.4.0",
    "cross-env": "^10.1.0",
    "eslint": "^10.7.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-astro": "^1.7.0",
    "eslint-plugin-vue": "^10.10.0",
    "globals": "^17.7.0",
    "jsonc-parser": "^3.3.1",
    "pg": "^8.23.0",
    "postcss": "^8.5.25",
    "prettier": "^3.9.5",
    "prettier-plugin-astro": "^0.14.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.65.0",
    "vitest": "^4.1.10",
    "vue-eslint-parser": "^10.4.1",
    "wrangler": "^4.120.0",
    "yaml": "^2.9.0"
  }
}
