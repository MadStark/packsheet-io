# build output
dist/
# generated types
.astro/

# dependencies
node_modules/

# logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*


# environment variables
# Deny-by-default: this repo is public, and the default Astro ignore only listed
# .env and .env.production, which would have let .env.local or .env.staging through.
.env*
!.env.example

# macOS-specific files
.DS_Store

# jetbrains setting folder
.idea/

# wrangler's local state: build cache, the miniflare data directory used by
# `wrangler dev`, and any temp config it writes. Machine-local and often large.
.wrangler/

# Supabase CLI local state. `supabase link` writes the linked project ref and a
# temporary access token under supabase/.temp — which is why supabase/.gitignore
# also excludes it, and why that file must not be deleted as redundant.
supabase/.branches/
supabase/.temp/

# Throwaway build output from tests/anonymous-read-path.test.ts. That test builds the
# real site (and its fixture) into a fresh directory and removes it in a `finally`;
# one of these surviving means a run was killed mid-build. It has to live inside the
# project rather than in tmpdir() because workerd prerendering cannot reach outside
# the project root — see the comment at the mkdtempSync call.
.astro-build-out-*/
