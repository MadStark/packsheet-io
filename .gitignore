# build output
dist/
# generated types
.astro/

# dependencies
node_modules/

# logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*


# environment variables
# Deny-by-default: this repo is public, and the default Astro ignore only listed
# .env and .env.production, which would have let .env.local or .env.staging through.
.env*
!.env.example

# macOS-specific files
.DS_Store

# jetbrains setting folder
.idea/

# A stray hand-run of scripts/write-origin-lock.sh leaves one of these at the repo root
# carrying the origin-verify secret, and this repository is public. Anchored to the root
# on purpose: dist/ is already ignored above, and an unanchored pattern would also make a
# future *legitimate* staticwebapp.config.json — route rules, security headers — silently
# un-addable and silently never deployed.
/staticwebapp.config.json
