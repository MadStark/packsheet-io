---
// On-demand: this page requires a session and reads Astro.locals.user, which only
// exists for a request the Worker actually handled. See src/middleware.ts for why
// that never touches the anonymous read path.
export const prerender = false;

import Layout from '../../layouts/Layout.astro';
import { deleteOwnAccount, signOut } from '../../lib/auth';
import { SIGN_IN_PATH } from '../../lib/auth-routes';
import { GEAR_PATH } from '../../lib/gear/routes';
// This page redirects a visitor with no session, so the wordmark below is only ever
// clicked by somebody signed in — and `/` now takes them to their closet rather than to
// the anonymous landing page. See src/lib/routes.ts.
import { HOME_PATH } from '../../lib/routes';
import {
  confirmsAccountDeletion,
  CONFIRMATION_MISMATCH_MESSAGE,
  DELETE_ACCOUNT_CONFIRMATION_FIELD,
  DELETE_ACCOUNT_INTENT,
} from '../../lib/account-deletion';
import {
  parseWeightSystemForm,
  readWeightSystem,
  saveWeightSystem,
  WEIGHT_SYSTEM_ERROR_MESSAGE,
  WEIGHT_SYSTEM_FIELD,
  WEIGHT_SYSTEM_INTENT,
  WEIGHT_SYSTEM_SAVED_MESSAGE,
} from '../../lib/profile';
import { WEIGHT_SYSTEM_LABELS, WEIGHT_SYSTEMS, type WeightSystem } from '../../lib/units';
import { createAuthClient } from '../../lib/auth';

// src/middleware.ts has already resolved this with a verified getUser() call; reading
// it here rather than calling getUser() again is the whole point of doing it once in
// middleware. A null user redirects to sign-in with `next` set back to this page, so
// signing in returns here rather than dropping the visitor on the account page's own
// default.
const user = Astro.locals.user;
// `astro check` reports SIGN_IN_PATH as an unused import here — a false positive of
// its diagnostic engine specifically for a symbol used only inside a top-level
// early-return guard in frontmatter (confirmed by moving the same expression into an
// intermediate variable: the warning just moves to the variable instead). tsc itself
// has no complaint; `eslint`'s no-unused-vars — the rule that actually matters for a
// genuinely dead import — is silent on this file too.
if (!user) {
  return Astro.redirect(`${SIGN_IN_PATH}?next=${encodeURIComponent(Astro.url.pathname)}`);
}

// The two-step confirmation the ticket requires: `?confirm-delete=1` is a plain GET
// navigation (nothing is deleted by loading this state) that reveals a form asking the
// visitor to type their own email address back, checked against `user.email` below
// before deleteOwnAccount() is ever called. Neither step alone is "a single unguarded
// button" — reaching the destructive action needs a deliberate link click AND a typed
// match, and no client-side `confirm()` dialog is involved at any point.
const confirmingDelete = Astro.url.searchParams.get('confirm-delete') === '1';

let deleteError: string | null = null;

// PK-67's Preferences section. The client is created unconditionally rather than inside
// the POST branch because the GET path needs it too — the radio group has to render with
// the stored choice already selected.
const client = createAuthClient(Astro.cookies, Astro.request);

/** Set after a Preferences POST: the confirmation or the failure sentence. Null on a GET,
 *  which is what keeps the message from reappearing on a later plain page load. */
let preferenceMessage: string | null = null;
let preferenceFailed = false;

// The stored preference, with a missing profiles row read as the default — which is the
// ordinary case here, since this page is where a row first gets created. A POST below may
// replace this before it is rendered, so that a successful save re-renders as selected
// without a second round trip to read back what was just written.
let weightSystem: WeightSystem = (await readWeightSystem(client, user.id)).system;

// CSRF: same protection as sign-in.astro and sign-up.astro — Astro's on-demand origin
// check (security.checkOrigin, set explicitly in astro.config.mjs) plus the session
// cookie's sameSite: 'lax'. PK-67 adds a second form to this page and deliberately adds
// NO new mechanism: the Preferences POST is same-origin-checked by exactly the pair above,
// which is the whole of what a preference write needs. Deletion additionally requires the
// typed-confirmation match below, so a forged cross-site POST that somehow arrived here
// still could not delete the account without also guessing the visitor's own email address.
if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();

  // Two forms, one handler, dispatched on `intent` — see WEIGHT_SYSTEM_INTENT's own
  // comment. Neither branch may act on the other's submission, which is why this is an
  // equality check on a hidden field rather than "did the request contain a weight_units
  // key": the delete form posting a stray field must not save a preference.
  if (form.get('intent') === WEIGHT_SYSTEM_INTENT) {
    const chosen = parseWeightSystemForm(form);
    if (chosen === null) {
      // Nothing checked, or a value that is not one of the two. Refused rather than
      // defaulted: writing a preference the visitor did not pick is worse than asking
      // again. The stored value stays selected below.
      preferenceMessage = WEIGHT_SYSTEM_ERROR_MESSAGE;
      preferenceFailed = true;
    } else {
      const { error } = await saveWeightSystem(client, user.id, chosen);
      if (error) {
        // Never render a raw Supabase error string.
        preferenceMessage = WEIGHT_SYSTEM_ERROR_MESSAGE;
        preferenceFailed = true;
      } else {
        weightSystem = chosen;
        preferenceMessage = WEIGHT_SYSTEM_SAVED_MESSAGE;
      }
    }
  }

  if (form.get('intent') === DELETE_ACCOUNT_INTENT) {
    // The gate itself lives in src/lib/account-deletion.ts, and it is there rather than
    // inline for one reason: frontmatter is code no test in this repository can reach
    // (vitest excludes src/pages/, because every file there becomes a route), so written
    // here it was the only piece of authorization logic in the codebase with no test at
    // all. See that file for what the comparison does and does not tolerate, and why.
    const typed = form.get(DELETE_ACCOUNT_CONFIRMATION_FIELD);
    if (!confirmsAccountDeletion(typeof typed === 'string' ? typed : null, user.email)) {
      deleteError = CONFIRMATION_MISMATCH_MESSAGE;
    } else {
      const result = await deleteOwnAccount({ cookies: Astro.cookies, request: Astro.request });
      if (result.ok) {
        // The account row and everything it owned are already gone server-side —
        // deleted by name, five WHERE clauses all scoped to `auth.uid()`, in
        // `public.delete_own_account()`. NOT by RLS: that function is SECURITY DEFINER,
        // so it runs as its owner and row-level security does not apply to a single
        // statement in it. What confines it is that it takes no arguments and can name
        // no user but the caller. (Nor is it the foreign-key cascade from auth.users,
        // which the migration deletes by hand around for a referential-integrity race —
        // see the comment above the function.)
        //
        // The session cookies themselves are still sitting in this browser until
        // something clears them, so sign out explicitly rather than leaving a cookie
        // that points at nobody.
        await signOut({ cookies: Astro.cookies, request: Astro.request });
        return Astro.redirect('/', 303);
      }
      // Never render a raw Supabase error string.
      deleteError = 'Something went wrong deleting your account. Please try again.';
    }
  }
}
---

<Layout title="Your account — Packsheet" description="Manage your Packsheet account.">
  {
    /* One sheet, the title inside it, its three sections separated by .sheet-rule hairlines
       rather than three sheets or bordered boxes (DESIGN.md §2.3, §2.6). Status and error
       banners are page-level notes ABOVE the sheet — see the preferenceMessage block below —
       because §2.5 says a note may only lie directly on the paper, never on a sheet. The
       delete-confirmation mismatch stays a field-level error instead: it names what is wrong
       with one specific field rather than announcing a page-level state, and a note could not
       render inside the sheet at all. */
  }
  <main class="paper-col flex flex-col gap-[30px] py-[30px]">
    <div class="mx-auto w-full max-w-md">
      {
        preferenceMessage && (
          /* `role="status"` for the confirmation and `role="alert"` for the failure: a save
             that worked is polite news, a save that did not is interrupting news. The delete
             form below uses `role="alert"` for its own error the same way. */
          <div
            class={preferenceFailed ? 'note note-danger mb-[30px]' : 'note mb-[30px]'}
            role={preferenceFailed ? 'alert' : 'status'}
          >
            <p>{preferenceMessage}</p>
          </div>
        )
      }

      <div class="sheet">
        <div class="sheet-body">
          <a href={HOME_PATH} class="eyebrow no-underline"> Packsheet </a>
          <h1 class="page-title mt-2">Your account</h1>
          <hr class="sheet-rule" />

          <p class="lead">
            Signed in as <span class="text-ink font-medium">{user.email}</span>
          </p>

          <p class="hint mt-2">
            <a href={GEAR_PATH} class="text-blue-deep hover:text-blue-ink underline">
              Go to your gear closet
            </a>
          </p>

          <form method="POST" action="/auth/signout" class="mt-6">
            <button type="submit" class="btn"> Sign out </button>
          </form>

          <hr class="sheet-rule" />

          {
            /*
            PK-67's Preferences section. Order is deliberate: the destructive action stays
            last on the page, so adding an everyday setting does not push it up next to the
            controls a visitor uses routinely.

            ONE SEGMENTED CONTROL, NOT A RADIO STACK — DESIGN.md §6: a choice of three or
            fewer says "exactly one of these is true", which a segmented control states and a
            row of radios only implies. Real `<input type="radio">` elements still drive it
            (the segment styling lives on the `<label>`s, see .segment in paper.css), which is
            what keeps this a plain POST that works with JavaScript disabled and gives
            assistive technology the same grouping a fieldset with a legend always did. A
            toggle switch would additionally have to decide which system is the "on" state,
            which is a claim neither metric nor imperial has any business making about the
            other.

            NO CLIENT-SIDE PERSISTENCE ANYWHERE. This is an account setting, so it has to
            follow the user to another browser — `localStorage` would make it a property of
            the device instead, and the ticket's own acceptance criterion is that signing in
            elsewhere shows the same choice. The server is the only place it is written.
          */
          }
          <h2 class="section-title">Preferences</h2>
          <form method="POST" class="mt-4">
            <input type="hidden" name="intent" value={WEIGHT_SYSTEM_INTENT} />
            <fieldset>
              <legend class="field-label">Weight units</legend>
              <div class="segmented mt-3">
                {
                  WEIGHT_SYSTEMS.map((system) => (
                    <label class="segment">
                      {/*
                        `checked` is server-rendered from the stored value, which is what makes
                        a successful save re-render as selected — the acceptance criterion the
                        frontmatter's `weightSystem = chosen` line exists to satisfy. It is also
                        why a REFUSED save leaves the previous choice checked rather than the
                        one that failed to parse.
                      */}
                      <input
                        type="radio"
                        name={WEIGHT_SYSTEM_FIELD}
                        value={system}
                        checked={system === weightSystem}
                      />
                      <span>{WEIGHT_SYSTEM_LABELS[system]}</span>
                    </label>
                  ))
                }
              </div>
            </fieldset>
            <button type="submit" class="btn mt-4"> Save preferences </button>
          </form>

          <hr class="sheet-rule" />

          {
            !confirmingDelete && (
              <div>
                <h2 class="section-title">Delete account</h2>
                <p class="hint mt-2">
                  This permanently deletes your account and everything in it. This cannot be undone.
                </p>
                <a href="?confirm-delete=1" class="btn btn-danger mt-4 no-underline">
                  Delete account
                </a>
              </div>
            )
          }

          {
            confirmingDelete && (
              <div>
                <h2 class="section-title text-rust">Confirm account deletion</h2>
                <p class="hint mt-2">
                  This cannot be undone. Type <span class="text-ink font-medium">{user.email}</span>{' '}
                  below to confirm.
                </p>
                <form method="POST" class="mt-4 flex flex-col gap-3">
                  <input type="hidden" name="intent" value={DELETE_ACCOUNT_INTENT} />
                  <div>
                    <input
                      type="text"
                      name={DELETE_ACCOUNT_CONFIRMATION_FIELD}
                      autocomplete="off"
                      required
                      aria-label="Type your email address to confirm"
                      aria-invalid={deleteError ? 'true' : undefined}
                      class="field w-full"
                    />
                    {deleteError && (
                      <p role="alert" class="field-error">
                        {deleteError}
                      </p>
                    )}
                  </div>
                  <div class="flex gap-3">
                    <button type="submit" class="btn btn-danger">
                      Permanently delete my account
                    </button>
                    <a href="/account" class="btn btn-quiet no-underline">
                      Cancel
                    </a>
                  </div>
                </form>
              </div>
            )
          }
        </div>
      </div>
    </div>
  </main>
</Layout>
