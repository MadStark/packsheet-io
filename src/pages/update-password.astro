---
// On-demand: this page depends on the session the recovery link was exchanged for, reads
// a POST body, and writes cookies through updatePassword. None of that is a prerendered
// file. See src/middleware.ts for why this never touches the anonymous read path.
export const prerender = false;

import Layout from '../layouts/Layout.astro';
import { updatePassword } from '../lib/auth';
// `astro check` reports ACCOUNT_PATH as an unused import here, as a HINT rather than an
// error or a warning. It is the same false positive src/pages/account/index.astro
// documents on its own SIGN_IN_PATH import — that diagnostic engine loses track of a
// symbol used only inside a `return` in frontmatter, and the redirect below is exactly
// that shape. tsc and eslint's no-unused-vars, which are what would catch a genuinely
// dead import, are both silent on this file.
import { ACCOUNT_PATH, FORGOT_PASSWORD_PATH, SIGN_IN_PATH } from '../lib/auth-routes';

/**
 * "Choose a new password" — the second half of the reset journey (PK-56), reached from the
 * emailed link by way of src/pages/auth/callback.ts.
 *
 * HOW A VISITOR GETS HERE WITH A SESSION, because nothing on this page creates one.
 * `requestPasswordReset` (src/lib/auth/index.ts) points GoTrue's `redirectTo` at
 * AUTH_CALLBACK_PATH with `?next=/update-password`, so the link in the email lands on the
 * existing PKCE exchange route — the same one Google sign-in uses — which exchanges the
 * one-time code for a session, writes the cookies, and redirects here. By the time this
 * frontmatter runs, src/middleware.ts has already verified that session with a real
 * `getUser()` round trip and put it in `Astro.locals.user`. There is deliberately no
 * second code-exchange implementation on this page: one exchange route, already tested,
 * already re-validating its `next` through `safeNextPath`.
 *
 * WHY A MISSING SESSION IS A RENDERED STATE AND NOT AN ERROR. Every ordinary way of
 * arriving here without one is innocent: the link was clicked twice (the code is
 * single-use), it sat in an inbox past its expiry, it was opened in a different browser
 * from the one that asked — PKCE keeps the verifier in a cookie, so the exchange only
 * completes where the request started — or somebody typed the URL. A 500, a redirect to
 * sign-in, or a bare "unauthorised" all answer a routine outcome as if it were a fault,
 * and the last of them strands the one person who most needs the "send me another link"
 * control. So the page renders a neutral expired-or-used state with the route back to
 * FORGOT_PASSWORD_PATH, and says nothing about whose link it was — the copy is the same
 * for a stranger typing the URL and for the account holder who waited a day.
 */
const user = Astro.locals.user;

let errorMessage: string | null = null;

// CSRF: same protection as every other mutating route here — Astro's on-demand origin
// check (security.checkOrigin, set explicitly in astro.config.mjs) plus the session
// cookie's sameSite: 'lax'. That pair matters more on this page than on most: the whole
// point of the form is that holding the session IS the authorisation, so a cross-site POST
// that rode along on the visitor's cookies would be a password takeover. The origin check
// refuses it before this code runs, and 'lax' means the cookie was never attached to it.
//
// Gated on `user` as well as on the method so a POST arriving with no session falls
// through to the expired-link state below rather than into updatePassword, where the same
// outcome would cost a round trip to the auth server and come back as a mapped error
// sentence in place of the sentence that actually helps.
if (user && Astro.request.method === 'POST') {
  const password = String((await Astro.request.formData()).get('password') ?? '');
  const result = await updatePassword({
    cookies: Astro.cookies,
    request: Astro.request,
    password,
  });
  if (result.ok) {
    // Signed in already — the recovery session is a real one, and changing the password
    // has just revoked this user's OTHER sessions on Supabase's side, which is the point
    // of the flow for somebody who came here because they think their password leaked.
    return Astro.redirect(ACCOUNT_PATH, 303);
  }
  // Already neutralised by passwordUpdateErrorMessage in src/lib/auth/index.ts — chosen
  // from the error's CODE, never relayed from Supabase's own text.
  errorMessage = result.error;
}
---

<Layout
  title="Choose a new password — Packsheet"
  description="Set a new password for your Packsheet account."
>
  <main class="mx-auto flex min-h-svh max-w-sm flex-col justify-center px-6 py-16">
    <a href="/" class="text-ink-3 font-mono text-xs tracking-[0.18em] uppercase">Packsheet</a>
    <h1 class="mt-6 text-3xl">Choose a new password</h1>

    {
      user ? (
        <Fragment>
          {errorMessage && (
            <p
              role="alert"
              class="border-rust/40 bg-rust/10 text-ink mt-6 rounded-[var(--r-sm)] border px-4 py-3 text-sm"
            >
              {errorMessage}
            </p>
          )}

          <p class="text-ink-2 mt-4 text-sm">
            Setting a new password for <span class="text-ink">{user.email}</span>. This signs out
            your other devices.
          </p>

          <form method="POST" class="mt-8 space-y-4">
            <div>
              <label for="password" class="text-ink-2 block text-sm">
                New password
              </label>
              <input
                id="password"
                name="password"
                type="password"
                autocomplete="new-password"
                required
                minlength="6"
                class="border-hairline bg-surface text-ink mt-1 w-full rounded-[var(--r-sm)] border px-3 py-2 text-sm"
              />
            </div>
            <button
              type="submit"
              class="border-blue-deep text-blue-deep hover:bg-blue-tint w-full rounded-[var(--r-sm)] border px-4 py-2 text-sm font-medium transition-colors"
            >
              Save new password
            </button>
          </form>
        </Fragment>
      ) : (
        <Fragment>
          <p class="text-ink-2 mt-6 text-sm">
            This link has expired or was already used. Reset links work once, and only in the
            browser that asked for them.
          </p>
          <p class="text-ink-2 mt-6 text-sm">
            <a href={FORGOT_PASSWORD_PATH} class="text-blue-deep hover:text-blue-ink underline">
              Send me a new link
            </a>{' '}
            — or{' '}
            <a href={SIGN_IN_PATH} class="text-blue-deep hover:text-blue-ink underline">
              sign in
            </a>{' '}
            if you remember your password.
          </p>
        </Fragment>
      )
    }
  </main>
</Layout>
