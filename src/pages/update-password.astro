---
// On-demand: this page depends on the session the recovery link was exchanged for, reads
// a POST body, and writes cookies through updatePassword. None of that is a prerendered
// file. See src/middleware.ts for why this never touches the anonymous read path.
export const prerender = false;

import Layout from '../layouts/Layout.astro';
import { updatePassword } from '../lib/auth';
// `astro check` reports ACCOUNT_PATH as an unused import here, as a HINT rather than an
// error or a warning. It is the same false positive src/pages/account/index.astro
// documents on its own SIGN_IN_PATH import — that diagnostic engine loses track of a
// symbol used only inside a `return` in frontmatter, and the redirect below is exactly
// that shape. tsc and eslint's no-unused-vars, which are what would catch a genuinely
// dead import, are both silent on this file.
import { ACCOUNT_PATH, FORGOT_PASSWORD_PATH, SIGN_IN_PATH } from '../lib/auth-routes';
// HOME_PATH rather than WELCOME_PATH for the wordmark, unlike sign-in.astro. This page is
// reached WITH a live recovery session as often as without one (an expired link renders
// its own state here), so it cannot assume which kind of visitor is reading it — and `/`
// is precisely the route that answers that question correctly for either. See
// src/lib/routes.ts.
import { HOME_PATH } from '../lib/routes';

/**
 * "Choose a new password" — the second half of the reset journey (PK-56), reached from the
 * emailed link by way of src/pages/auth/callback.ts.
 *
 * HOW A VISITOR GETS HERE WITH A SESSION, because nothing on this page creates one.
 * `requestPasswordReset` (src/lib/auth/index.ts) points GoTrue's `redirectTo` at
 * AUTH_CALLBACK_PATH with `?next=/update-password`, so the link in the email lands on the
 * existing PKCE exchange route — the same one Google sign-in uses — which exchanges the
 * one-time code for a session, writes the cookies, and redirects here. By the time this
 * frontmatter runs, src/middleware.ts has already verified that session with a real
 * `getUser()` round trip and put it in `Astro.locals.user`. There is deliberately no
 * second code-exchange implementation on this page: one exchange route, already tested,
 * already re-validating its `next` through `safeNextPath`.
 *
 * WHY A MISSING SESSION IS A RENDERED STATE AND NOT AN ERROR. Every ordinary way of
 * arriving here without one is innocent: the link was clicked twice (the code is
 * single-use), it sat in an inbox past its expiry, it was opened in a different browser
 * from the one that asked — PKCE keeps the verifier in a cookie, so the exchange only
 * completes where the request started — or somebody typed the URL. A 500, a redirect to
 * sign-in, or a bare "unauthorised" all answer a routine outcome as if it were a fault,
 * and the last of them strands the one person who most needs the "send me another link"
 * control. So the page renders a neutral expired-or-used state with the route back to
 * FORGOT_PASSWORD_PATH, and says nothing about whose link it was — the copy is the same
 * for a stranger typing the URL and for the account holder who waited a day.
 *
 * ---------------------------------------------------------------------------
 * A SESSION IS THE ONLY THING THIS PAGE ASKS FOR — DELIBERATELY (PK-56 review)
 * ---------------------------------------------------------------------------
 *
 * There is no current-password field and no reauthentication step. ANY live session for
 * an account can set that account a new password here, and doing so revokes that user's
 * other sessions on Supabase's side. A reviewer flagged that as an escalation path —
 * steal a session, lock the owner out — and it is one; it is accepted rather than
 * unnoticed, for two reasons that should be read together:
 *
 *   1. THE MARGINAL ESCALATION IS SMALL. Somebody already holding a session can call
 *      `deleteOwnAccount` (src/lib/auth/index.ts, reachable from
 *      src/pages/account/index.astro) and destroy the account and everything in it
 *      outright. Against an adversary who can already do that irreversibly, "can also
 *      change the password" buys very little. The session cookie is the boundary, and it
 *      is defended where boundaries are defended — `httpOnly` so no script can read it,
 *      `secure` off the dev server, `sameSite: 'lax'` plus Astro's origin check so no
 *      cross-site POST can ride it, and `getUser()` rather than `getSession()` so a
 *      revoked or forged token is not merely decoded and believed.
 *   2. REQUIRING THE OLD PASSWORD WOULD BREAK THE ONLY JOURNEY THAT REACHES THIS PAGE.
 *      The premise of arriving here is that the visitor does not know their password —
 *      that is what "Forgot your password?" means. A current-password field on the far
 *      end of a recovery link is a field nobody in that journey can fill in.
 *
 * WHAT WOULD CHANGE THE DECISION, written down so it is re-opened on purpose rather than
 * by accident:
 *
 *   - THE REALISTIC TRIGGER: this page becoming reachable from a SIGNED-IN SETTINGS
 *     SCREEN — a "change my password" control on the account page — rather than only from
 *     a recovery link. That inverts reason 2 completely. A signed-in visitor changing
 *     their password DOES know the current one, so asking for it costs them nothing and
 *     closes the stolen-session case, and the two audiences then want opposite things
 *     from the same form. If that control is ever added, it needs the old-password check
 *     even though the recovery path still must not have one — which most likely means two
 *     entry points into `updatePassword`, not one form trying to serve both.
 *   - `secure_password_change` in supabase/config.toml being turned on. It is `false`
 *     today (top-level, and overridden by neither remote, so it is `false` on both hosted
 *     projects too). Turning it on makes GoTrue itself demand a recent login or a
 *     reauthentication token before accepting a password change — which is the same
 *     protection reason 1 declines to build here, enforced a layer down, and which would
 *     start REJECTING this recovery flow unless a freshly exchanged recovery session
 *     counts as recent enough. Walk the reset journey end to end before flipping it:
 *     nothing in this repository fails if it silently stops working.
 */
const user = Astro.locals.user;

let errorMessage: string | null = null;

// CSRF: same protection as every other mutating route here — Astro's on-demand origin
// check (security.checkOrigin, set explicitly in astro.config.mjs) plus the session
// cookie's sameSite: 'lax'. That pair matters more on this page than on most: the whole
// point of the form is that holding the session IS the authorisation, so a cross-site POST
// that rode along on the visitor's cookies would be a password takeover. The origin check
// refuses it before this code runs, and 'lax' means the cookie was never attached to it.
//
// Gated on `user` as well as on the method so a POST arriving with no session falls
// through to the expired-link state below rather than into updatePassword, where the same
// outcome would cost a round trip to the auth server and come back as a mapped error
// sentence in place of the sentence that actually helps.
if (user && Astro.request.method === 'POST') {
  const password = String((await Astro.request.formData()).get('password') ?? '');
  const result = await updatePassword({
    cookies: Astro.cookies,
    request: Astro.request,
    password,
  });
  if (result.ok) {
    // Signed in already — the recovery session is a real one, and changing the password
    // has just revoked this user's OTHER sessions on Supabase's side, which is the point
    // of the flow for somebody who came here because they think their password leaked.
    return Astro.redirect(ACCOUNT_PATH, 303);
  }
  // Already neutralised by passwordUpdateErrorMessage in src/lib/auth/index.ts — chosen
  // from the error's CODE, never relayed from Supabase's own text.
  errorMessage = result.error;
}
---

<Layout
  title="Choose a new password — Packsheet"
  description="Set a new password for your Packsheet account."
>
  {
    /* One sheet, the title inside it. errorMessage can only be set inside the `user` branch
       of the frontmatter above, so the note above the sheet is safe to gate on it alone —
       it never fires alongside the expired-link state. */
  }
  <main class="paper-col flex min-h-svh flex-col items-center justify-center py-16">
    <div class="flex w-full max-w-sm flex-col gap-[30px]">
      {
        errorMessage && (
          <div class="note note-danger" role="alert">
            <p>{errorMessage}</p>
          </div>
        )
      }

      <div class="sheet">
        <div class="sheet-body">
          <a href={HOME_PATH} class="eyebrow no-underline"> Packsheet </a>
          <h1 class="page-title mt-2">Choose a new password</h1>
          <hr class="sheet-rule" />

          {
            user ? (
              <Fragment>
                <p class="lead">
                  Setting a new password for <span class="text-ink font-medium">{user.email}</span>.
                  This signs out your other devices.
                </p>

                <form method="POST" class="mt-8 flex flex-col gap-4">
                  <div>
                    <label for="password" class="field-label">
                      New password
                    </label>
                    <input
                      id="password"
                      name="password"
                      type="password"
                      autocomplete="new-password"
                      required
                      minlength="6"
                      class="field mt-1 w-full"
                    />
                  </div>
                  <button type="submit" class="btn btn-primary w-full">
                    Save new password
                  </button>
                </form>
              </Fragment>
            ) : (
              <Fragment>
                <p class="lead">
                  This link has expired or was already used. Reset links work once, and only in the
                  browser that asked for them.
                </p>
                <p class="hint mt-6">
                  <a
                    href={FORGOT_PASSWORD_PATH}
                    class="text-blue-deep hover:text-blue-ink underline"
                  >
                    Send me a new link
                  </a>{' '}
                  — or{' '}
                  <a href={SIGN_IN_PATH} class="text-blue-deep hover:text-blue-ink underline">
                    sign in
                  </a>{' '}
                  if you remember your password.
                </p>
              </Fragment>
            )
          }
        </div>
      </div>
    </div>
  </main>
</Layout>
