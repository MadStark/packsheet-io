---
// On-demand: this page requires a session, reads Astro.locals.user, inserts into
// gear_items on POST and redirects — none of which a prerendered file can do. See
// src/middleware.ts for why GEAR_PATH carries the no-store rule the same way /account
// does, and src/pages/gear/index.astro for the page this one shares its shape with.
export const prerender = false;

import Layout from '../../layouts/Layout.astro';
import GearNav from '../../components/GearNav.astro';
import GearItemForm from '../../components/GearItemForm.astro';
import { createAuthClient } from '../../lib/auth';
import { SIGN_IN_PATH, NEXT_PARAM } from '../../lib/auth-routes';
import {
  EMPTY_GEAR_FORM_VALUES,
  parseGearItemForm,
  rawGearFormValues,
  type GearFormValues,
} from '../../lib/gear/form';
import { GEAR_PATH } from '../../lib/gear/routes';
import { extractGearOptions, loadGearOptions } from '../../lib/gear/options';
import { gearReturnPathFromFormOrNull, gearReturnPathOrNull } from '../../lib/gear/return-path';

// src/middleware.ts has already resolved this with a verified getUser() call; reading
// it here rather than calling getUser() again is the whole point of doing it once in
// middleware. A null user redirects to sign-in with `next` set back to this exact URL,
// so signing in returns here rather than dropping the visitor on the closet's default.
const user = Astro.locals.user;
if (!user) {
  const next = `${Astro.url.pathname}${Astro.url.search}`;
  return Astro.redirect(`${SIGN_IN_PATH}?next=${encodeURIComponent(next)}`);
}

// CSRF: same protection as sign-in.astro and src/pages/gear/index.astro — Astro's
// on-demand origin check (security.checkOrigin, set explicitly in astro.config.mjs)
// plus the session cookie's sameSite: 'lax'. No separate CSRF token is needed on top of
// that pair for the same reason it isn't on those pages.
const client = createAuthClient(Astro.cookies, Astro.request);

// Never render a raw PostgREST/Supabase error string — mirrors src/lib/auth/index.ts
// and src/lib/gear/form.ts's own "NEVER A RAW POSTGRES OR POSTGREST STRING" rule.
const GENERIC_WRITE_ERROR = 'Something went wrong adding this item. Please try again.';

// The category suggestions offered under the Category field's <datalist> — see
// GearItemForm's own comment on that field for why a datalist rather than a <select>.
// A query error here degrades to an empty suggestion list rather than failing the whole
// page: a missing suggestion list costs a visitor nothing but the convenience of
// autocomplete, and refusing to render the add-item form over that would turn a minor
// inconvenience into a hard block on the one thing this page exists for.
const { data: optionRows, error: optionsError } = await loadGearOptions(client, user.id);
const categories = optionsError ? [] : extractGearOptions(optionRows ?? []).categories;

let values: GearFormValues = EMPTY_GEAR_FORM_VALUES;
let errors: Readonly<Record<string, string>> = {};
let writeError: string | null = null;

// The return-to-caller destination (PK-63) — "saving returns you where you were": the
// same filtered/sorted/paged closet view Cancel would also send the visitor back to.
// `null` means "nothing usable was carried" — no `?next=` on this GET, or a refused/
// absent value on a POST — so the hidden `next` field this component renders (see
// GearItemForm's own comment on it) never carries a value the visitor did not actually
// supply. `GEAR_PATH` is substituted only where a concrete destination is required: the
// redirect on a successful insert, and cancelHref/next below. See
// src/lib/gear/return-path.ts for why GEAR_PATH is the right fallback here rather than
// reusing safeNextPath's own HOME_PATH default. Computed up front from the query string
// so the GET render has a value even before any POST is seen; the POST branch
// overwrites it with the form's own carried value the moment the form is available,
// since a hidden field can disagree with the query string that produced this same page
// (see gearReturnPathFromFormOrNull's own comment on precedence).
let returnPath: string | null = gearReturnPathOrNull(Astro.url.searchParams.get(NEXT_PARAM));

// ---------------------------------------------------------------------------
// POST: create the item.
//
// Method discipline: this page answers GET and POST, nothing else — Astro itself
// returns 405 for any other method, since no other handler is exported. The one
// mutating branch redirects with 303, so a refresh can never resubmit the insert.
// ---------------------------------------------------------------------------
if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  returnPath = gearReturnPathFromFormOrNull(form, Astro.url);
  const result = parseGearItemForm(form);

  if (!result.ok) {
    // Re-render with the visitor's own values and the errors describing what to fix —
    // never clear a form someone has just filled in.
    errors = result.errors;
    values = result.values;
  } else {
    // No `user_id` in this payload: the column defaults from `auth.uid()` and
    // `gear_items_insert_own` checks the same value (core_schema.sql:50-53), so a
    // client that sends nothing gets the right answer and a client that sent someone
    // else's id would have been refused rather than quietly corrected.
    const { data, error } = await client
      .from('gear_items')
      .insert(result.values)
      .select('id')
      .single();

    if (error || data === null) {
      writeError = GENERIC_WRITE_ERROR;
      // The submission validated; the database write did not. Re-render with exactly
      // what the visitor typed — see rawGearFormValues's own comment for why this is
      // the right values to show back, rather than the blank EMPTY_GEAR_FORM_VALUES or
      // a value reconstructed from the already-reformatted GearItemInput.
      values = rawGearFormValues(form);
    } else {
      // PK-63: "saving returns you where you were" — redirect to the carried return
      // path (the closet view the visitor came from, or GEAR_PATH if none was carried)
      // rather than the fresh item's own detail page. This replaces the previous
      // behaviour of always redirecting to gearItemPath(data.id), so `gearItemPath` is
      // no longer imported here. The `.select('id').single()` above stays as the thing
      // that makes `data === null` a meaningful check that the insert produced a row —
      // the id itself is not read by anything any more.
      return Astro.redirect(returnPath ?? GEAR_PATH, 303);
    }
  }
}
---

<Layout title="Add gear — Packsheet" description="Add a new item to your Packsheet gear closet.">
  <GearNav />
  <main class="mx-auto max-w-2xl px-6 py-10">
    <h1 class="text-3xl">Add gear</h1>
    <p class="text-ink-2 mt-2 text-sm">
      Photos aren't supported yet — that's a separate piece of work still to come.
    </p>

    {
      writeError && (
        <p
          role="alert"
          class="border-rust/40 bg-rust/10 text-ink mt-6 rounded-[var(--r-sm)] border px-4 py-3 text-sm"
        >
          {writeError}
        </p>
      )
    }

    <div class="mt-8">
      <GearItemForm
        values={values}
        errors={errors}
        submitLabel="Add item"
        cancelHref={returnPath ?? GEAR_PATH}
        categories={categories}
        next={returnPath ?? undefined}
      />
    </div>
  </main>
</Layout>
