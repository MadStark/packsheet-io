---
// On-demand: this page requires a session, reads Astro.locals.user, mutates
// gear_items on POST and redirects — none of which a prerendered file can do. See
// src/middleware.ts for why GEAR_PATH carries the no-store rule the same way
// /account does.
export const prerender = false;

import Layout from '../../layouts/Layout.astro';
import GearNav from '../../components/GearNav.astro';
import GearStatusIcon from '../../components/GearStatusIcon.astro';
import { createAuthClient } from '../../lib/auth';
import { readWeightSystem } from '../../lib/profile';
import { formatWeight } from '../../lib/units';
import { SIGN_IN_PATH } from '../../lib/auth-routes';
import {
  GEAR_IMPORTED_PARAM,
  GEAR_IMPORT_PATH,
  GEAR_NEW_PATH,
  GEAR_PATH,
  gearItemPath,
} from '../../lib/gear/routes';
// PK-65: what a finished import is allowed to say on arrival here. In src/lib/ because
// `vitest.config.ts` excludes src/pages/**, and this reads a visitor-editable parameter.
import { importedBannerMessage } from '../../lib/gear/import-form';
import {
  gearListPath,
  gearQueryToSearchParams,
  hasUnsurfacedFilters,
  loadGearCloset,
  loadGearItemsForExport,
  parseGearQuery,
  sortLinkSearchParams,
  unsurfacedFilterParams,
  type GearQuery,
} from '../../lib/gear/query';
// PK-65: the export half of the JSON round-trip. The page's job is to answer with the
// bytes; what is IN them is json-schema.ts's decision, tested directly.
import {
  buildGearItemsDocument,
  gearItemsFilename,
  serialiseGearItemsDocument,
} from '../../lib/gear/json-schema';
import {
  GEAR_LIST_COLUMNS,
  GEAR_PAGE_SIZE,
  GEAR_STATUSES,
  effectiveGearStatuses,
  isGearStatus,
  type GearSortKey,
} from '../../lib/gear/fields';
import {
  BULK_FORM_FIELD,
  BULK_INTENT,
  GEAR_DELETE_CONFIRMATION_VALUE,
  GEAR_DELETE_FAILED_MESSAGE,
  confirmsGearDeletion,
  parseBulkAction,
  type BulkAction,
} from '../../lib/gear/bulk';
// `loadGearOptions` only — `extractGearOptions` is NOT called here any more. PK-62
// removed the Category and Brand filter checkboxes this page built from it, but the
// QUERY still runs, because `closetIsEmpty` below is derived from its row count and
// nothing else on this page can tell "your closet is empty" from "these filters matched
// nothing". `extractGearOptions` itself lives in src/lib/gear/options.ts and IS called —
// by new.astro and [id].astro, for the item form's category autocomplete (PK-63). It was
// briefly caller-less between PK-62 and PK-63 landing, which is why PK-62 kept it rather
// than deleting it; that bet has now paid off and this comment no longer describes an
// open question.
import { loadGearOptions } from '../../lib/gear/options';
// `deleteGearItems` rather than the bulkSoftDelete/undoBulkDelete pair: PK-60 dropped the
// soft delete, the trash page and the undo banner, so a delete is now final.
import { bulkSetCategory, bulkSetStatus, deleteGearItems } from '../../lib/gear/mutations';
// `formatGearAcquiredOn` (PK-61) left this import with PK-64: the Notebook Paper
// conversion dropped the Added column from this page's markup (see GEAR_LIST_COLUMNS's
// own comment in src/lib/gear/fields.ts for why), and that formatter had no other call
// site here. It stays exported from format.ts and covered by tests/gear-format.test.ts,
// because `?sort=added` is still a live, bookmarkable URL — only the header and the cell
// are gone. `WEIGHT_UNITS` came in on the same import block on staging and is
// deliberately NOT carried across: PK-62 removed the weight-range fieldset that was its
// only consumer on this page.
//
// `GEAR_MARKER_ROW_CLASS` LEFT THIS IMPORT BLOCK WITH PK-70, and it did not move — it was
// deleted from format.ts outright. It mapped a `GearStatusMarker` onto the row-wash class
// that painted a 5.5% wash and a 3px left bar down every non-owned row. DESIGN.md §7 was
// AMENDED by this ticket to stop prescribing that treatment for gear statuses (the appendix
// records the change): two of the three statuses are ordinary states of a closet rather than
// faults, so a coloured rail down a third of the list was repeated colour carrying no
// urgency. `gearStatusMarker` stays, because the ICON beside the name stays; what went is
// only the row class it also used to key.
import { formatGearPrice, formatGearStatus, gearStatusMarker } from '../../lib/gear/format';
// PK-63: every link out of this list carries the current view as a return target, so
// saving the item form lands the visitor back on the same filters, sort and page.
import { gearFormHrefReturningTo } from '../../lib/gear/return-path';

// src/middleware.ts has already resolved this with a verified getUser() call; reading
// it here rather than calling getUser() again is the whole point of doing it once in
// middleware. A null user redirects to sign-in with `next` set back to this exact URL
// (path + query), so signing in returns to the same filtered/sorted/paginated view
// rather than dropping the visitor on the closet's own default.
const user = Astro.locals.user;
if (!user) {
  const next = `${Astro.url.pathname}${Astro.url.search}`;
  return Astro.redirect(`${SIGN_IN_PATH}?next=${encodeURIComponent(next)}`);
}

// CSRF: same protection as sign-in.astro and account/index.astro — Astro's on-demand
// origin check (security.checkOrigin, set explicitly in astro.config.mjs) plus the
// session cookie's sameSite: 'lax'. No separate CSRF token is needed on top of that
// pair for the same reason it isn't on those pages.
const client = createAuthClient(Astro.cookies, Astro.request);

// Never render a raw PostgREST/Supabase error string — mirrors src/lib/auth/index.ts
// and src/lib/gear/form.ts's own "NEVER A RAW POSTGRES OR POSTGREST STRING" rule.
const GENERIC_LOAD_ERROR = 'Something went wrong loading your gear. Please try again.';
// The two bulk UPDATES only. A failed bulk DELETE reports GEAR_DELETE_FAILED_MESSAGE
// (src/lib/gear/bulk.ts) instead: this sentence says "updating", which a delete is not,
// and "please try again", which promises the write did not happen — see that constant's
// own comment for the committed-then-lost-response case where that promise is false.
const GENERIC_WRITE_ERROR = 'Something went wrong updating your gear. Please try again.';
// PK-65. Says the selection is gone rather than "something went wrong", because nothing
// did: the query ran fine and matched nothing. The likeliest cause is a stale page whose
// items were deleted elsewhere, and reloading is the action that fixes it.
const EXPORT_FOUND_NOTHING_MESSAGE =
  'None of the items you selected are in your closet any more. Reload the page and try again.';

let bulkError: string | null = null;
/** Set only for a `bulk-delete` submission that has not yet been confirmed — see
 *  "Method discipline" below. Carries exactly the ids `parseBulkAction` validated, so
 *  the confirmation form can re-post the identical, already-validated selection rather
 *  than re-reading (and re-trusting) anything from the request a second time. */
let pendingDelete: { readonly ids: readonly string[] } | null = null;

// ---------------------------------------------------------------------------
// POST: the three bulk actions.
//
// Method discipline: this page answers GET and POST, nothing else — Astro itself
// returns 405 for any other method, since no other handler is exported. Every
// state-changing branch below redirects with 303, so a refresh can never resubmit a
// mutation; the one branch that does NOT redirect (an unconfirmed bulk-delete) has not
// changed anything yet, which is the entire point of it — and for delete that point is
// now the whole of the safety net, because deleteGearItems removes the rows for good.
// ---------------------------------------------------------------------------
if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();

  const result = parseBulkAction(form);
  if (!result.ok) {
    bulkError = Object.values(result.errors)[0] ?? 'Choose a valid bulk action.';
  } else {
    const action = result.action;
    const ids = [...action.ids];

    if (action.intent === BULK_INTENT.delete) {
      // Bulk delete is irreversible, so — following the house precedent in
      // account/index.astro's own two-step account deletion — the first submission
      // never writes anything. It only reveals a confirmation naming the count, built
      // from the SAME validated `ids` the second submission will re-post as hidden
      // fields. No client-side confirm() dialog anywhere in this.
      //
      // What counts as confirmation is confirmsGearDeletion's decision, not this page's
      // (PK-60 review, F1): it used to be an inline `=== '1'` here and a second,
      // separate one in src/pages/gear/[id].astro, in the directory
      // vitest.config.ts:64 excludes — the only guard in front of the gear closet's one
      // irreversible write, duplicated, and untestable in both copies. See that
      // function's own comment for why it refuses ' 1 ', 'true' and a File.
      const confirmed = confirmsGearDeletion(form.get(BULK_FORM_FIELD.confirm));
      if (!confirmed) {
        pendingDelete = { ids };
      } else {
        // deleteGearItems (src/lib/gear/mutations.ts) removes these rows from
        // gear_items outright — see that function's own comment for what the BEFORE
        // DELETE trigger freezes into any pack still referencing them, which is what
        // makes a real delete safe to offer at all. Its `count` is deliberately not
        // read here: with no banner to report a figure into (the item's absence from
        // the list below IS the feedback), the only thing this page needs from the
        // write is whether it failed.
        const { error } = await deleteGearItems(client, user.id, ids);
        if (error) {
          // Not GENERIC_WRITE_ERROR: this branch is also where a delete that COMMITTED
          // and then lost its response lands, so the message must not promise the rows
          // are still there — see GEAR_DELETE_FAILED_MESSAGE's own comment. Still not a
          // raw PostgREST string, exactly like every other error on this page.
          bulkError = GEAR_DELETE_FAILED_MESSAGE;
        } else {
          // The same filtered/sorted/paged view the visitor was on, exactly like the
          // other two actions below — a delete is not a reason to throw away the
          // filter they are working through.
          return Astro.redirect(gearListPath(parseGearQuery(Astro.url.searchParams)), 303);
        }
      }
    } else if (action.intent === BULK_INTENT.setCategory) {
      const { error } = await bulkSetCategory(client, user.id, ids, action.category);
      if (error) {
        bulkError = GENERIC_WRITE_ERROR;
      } else {
        // Same filtered/sorted/paged view, via gearListPath rather than
        // `${GEAR_PATH}${Astro.url.search}` verbatim: this form's own action defaults
        // to the current document URL, so the verbatim version would carry every
        // param sitting in it forward — including any this page does not own (a stray
        // `?utm_source=`, a typo'd `?cagegory=`, a param a future feature adds
        // elsewhere). Routing through parseGearQuery means the redirect target is
        // rebuilt from the filter state alone; see gearListPath's own comment for why
        // that is done through GearQuery rather than by deleting params by name.
        return Astro.redirect(gearListPath(parseGearQuery(Astro.url.searchParams)), 303);
      }
    } else if (action.intent === BULK_INTENT.export) {
      // THE ONE BRANCH THAT DOES NOT REDIRECT AND MUST NOT (PK-65). Every other action
      // here answers with a 303 so a refresh cannot resubmit a mutation; this one answers
      // with the file itself. The 303 rule exists to stop a repeated POST repeating a
      // WRITE, and this POST writes nothing — re-submitting it produces the same bytes
      // again, which is what a download that failed halfway ought to do. Routing it
      // through a redirect would additionally mean parking the selection somewhere a GET
      // could find it (a query string of 500 ids, or a server-side scratch row), which is
      // a great deal of machinery to arrive back at the same bytes.
      //
      // WHY IT IS A POST AT ALL, then, when it only reads: the selection is the input,
      // and a selection lives in checkboxes. A GET carrying 500 `?id=` parameters is a
      // URL past every practical length limit, logged in full by every proxy between here
      // and the visitor, and bookmarkable into a link that silently means something
      // different tomorrow.
      const { items, error } = await loadGearItemsForExport(client, user.id, ids);
      if (error) {
        bulkError = GENERIC_LOAD_ERROR;
      } else if (items.length === 0) {
        // AN EMPTY SELECTION THAT MATCHED NOTHING IS NOT AN EXPORT (PK-65 review, F6).
        // `parseBulkAction` has already refused a genuinely empty selection, so arriving
        // here means every id the visitor ticked has since stopped being theirs to read —
        // deleted in another tab, or a crafted id list. Answering 200 with a file whose
        // `items` array is `[]`, under a confident dated filename, hands somebody a
        // download they may well file away as a backup of a closet that is not in it.
        // A refusal they can see beats a file that is quietly empty.
        bulkError = EXPORT_FOUND_NOTHING_MESSAGE;
      } else {
        // `exportedAt` is taken ONCE and threaded into both the document and the
        // filename, so the timestamp inside the file and the date on it can never
        // disagree — two `new Date()` calls either side of midnight is a small, real bug
        // that would be found by nobody.
        const exportedAt = new Date();
        const body = serialiseGearItemsDocument(buildGearItemsDocument(items, exportedAt));
        return new Response(body, {
          status: 200,
          headers: {
            // `charset=utf-8` is explicit rather than assumed: gear names carry accents,
            // CJK and emoji routinely, and a browser guessing the encoding of a file it
            // was handed without one gets them wrong.
            'content-type': 'application/json; charset=utf-8',
            'content-disposition': `attachment; filename="${gearItemsFilename(exportedAt)}"`,
            // BELT AND BRACES, AND THE BRACES ALREADY HOLD: src/middleware.ts sets
            // `private, no-store` on every response for a signed-in visitor on this path,
            // and does it AFTER this handler returns, so it overwrites whatever is set
            // here. This header is therefore doing nothing today. It is kept, and this
            // comment written, rather than deleted, because what it asserts is a property
            // of THIS RESPONSE rather than of the route: the body is a visitor's own gear
            // including notes and prices, and it must never sit in a shared cache or come
            // back from a private one after a sign-out. If the middleware rule is ever
            // narrowed to HTML — an entirely reasonable future change — this line is what
            // stops that narrowing from silently making a JSON download cacheable.
            'cache-control': 'no-store',
          },
        });
      }
    } else if (action.intent === BULK_INTENT.setStatus) {
      const { error } = await bulkSetStatus(client, user.id, ids, action.status);
      if (error) {
        bulkError = GENERIC_WRITE_ERROR;
      } else {
        // Same reasoning as bulk-set-category immediately above.
        return Astro.redirect(gearListPath(parseGearQuery(Astro.url.searchParams)), 303);
      }
    } else {
      // Unreachable, and typed so that it stays unreachable (PK-60 review, F2).
      // `parseBulkAction` has already refused every intent that is not one of the three
      // BULK_INTENT values, so no request can arrive here; the assignment to `never` is
      // what makes that a guarantee the COMPILER keeps rather than a fact somebody has
      // to re-verify by reading bulk.ts.
      //
      // What this replaced was a plain `else` holding the bulk-set-status write, with a
      // comment claiming a future fourth BULK_INTENT could not slip through because it
      // would land here "typed without a `status` field, which is a compile error". That
      // was only two-thirds true, and it was tested: a fourth member without a `status`
      // field does fail to compile, but one that HAPPENS TO CARRY a `status` field (a
      // plausible future `bulk-retire`, say) compiles cleanly and silently performs a
      // status write under a different action's name — a wrong write, in the branch
      // meant to be the safe one. Narrowing the write to its own explicit `=== setStatus`
      // test and leaving `never` here makes the guarantee structural instead: ANY new
      // member of the union fails to compile on the line below, whatever fields it
      // carries, because reaching this branch with a member left unhandled is exactly
      // what stops `action` narrowing to `never` — and `never` accepts nothing.
      const unhandled: never = action;
      throw new Error(`Unhandled bulk intent: ${(unhandled as BulkAction).intent}`);
    }
  }
}

// ---------------------------------------------------------------------------
// GET (and the render that follows every POST that did not redirect): parse the
// query, fetch the filter options and the current page of rows.
// ---------------------------------------------------------------------------
const query: GearQuery = parseGearQuery(Astro.url.searchParams);

// PK-65. Read straight off the URL and rendered; `parseGearQuery` deliberately does not
// know this parameter, so it never survives into the links the list rebuilds and the
// banner disappears on the visitor's next click. What counts as a believable number is
// `importedBannerMessage`'s decision, in src/lib/ where a test can reach it — a hand-typed
// `?imported=abc` or `?imported=-4` has to mean "no banner" rather than a rendered NaN.
const importedMessage = importedBannerMessage(Astro.url.searchParams.get(GEAR_IMPORTED_PARAM));

// Both queries are owner-scoped and live in src/lib/gear/ now — loadGearOptions
// (src/lib/gear/options.ts) and loadGearCloset (src/lib/gear/query.ts) — so a test can
// reach the `.eq('user_id', user.id)` scoping directly rather than only through a page
// vitest.config.ts excludes. See loadGearCloset's own module comment for why that
// filter is load-bearing rather than belt-and-braces (the short version: gear_items
// carries a second SELECT policy, granted to authenticated visitors too, that a bare
// `.select()` would UNION in — "your gear closet" silently showing a stranger's gear
// the moment that stranger publishes a pack).
//
// loadGearCloset ALSO performs the C2 (PK-4 review) page clamp: `page` below is
// whatever page was actually queried, which may be LOWER than `query.page` if the
// visitor's own `?page=` was past the end of the result set — see that function's own
// comment for why this makes an over-range page land on the last real page instead of
// PGRST103's "Requested range not satisfiable" replacing the whole render with an error
// that could never resolve.
const { data: optionRows, error: optionsError } = await loadGearOptions(client, user.id);
const { items: rows, error: listError, count, page } = await loadGearCloset(client, user.id, query);

// PK-67: the account's system, applied to every weight cell below. Read once per request
// rather than per row — it is one value for the whole list, and forty identical queries to
// render one column would be forty round trips for a display preference.
const { system: weightSystem } = await readWeightSystem(client, user.id);

const loadError = optionsError || listError ? GENERIC_LOAD_ERROR : null;
const items = rows ?? [];
const totalCount = count ?? 0;
const totalPages = Math.max(1, Math.ceil(totalCount / GEAR_PAGE_SIZE));
const rangeStart = totalCount === 0 ? 0 : (page - 1) * GEAR_PAGE_SIZE + 1;
const rangeEnd = totalCount === 0 ? 0 : rangeStart + items.length - 1;

// "The closet has no items at all" is exactly optionRows being empty: that query
// carries no filter beyond the owner scope (see loadGearOptions), so an empty result
// there can only mean there is nothing to filter — never that today's filters merely
// matched nothing.
// This is what lets the two empty states below say two different, honest things
// instead of collapsing "you have no gear" and "no gear matches these filters" into
// one sentence that would be wrong for whichever case it wasn't written for.
const closetIsEmpty = !loadError && (optionRows ?? []).length === 0;

// ZERO CHECKED RENDERS AS OWNED + WISHLIST (PK-70), AND THE QUERY AGREES BY CONSTRUCTION.
// This line used to read `checkedGearStatuses(query.statuses)` under a comment headed "ZERO
// CHECKED RENDERS AS ALL THREE CHECKED (PK-62)", and both halves of that changed at once:
// the function is now `effectiveGearStatuses` and an empty selection resolves to
// `GEAR_DEFAULT_STATUSES` — owned and wishlist, retired excluded — rather than to all three.
// The rename is not cosmetic; see that function's own comment in src/lib/gear/fields.ts.
//
// WHAT THE RENAME BUYS THIS PAGE. `applyGearFilters` (src/lib/gear/query.ts) now calls the
// SAME function to decide what the query filters by, so the ticked boxes below and the rows
// in the list cannot disagree: there is no state where a visitor sees Retired unticked next
// to a retired row, or ticked next to one the query just filtered out. That agreement is a
// property of there being one function, not of two files being kept in step by hand — which
// is also why the rule still lives in src/lib/ rather than here, `vitest.config.ts` excluding
// `src/pages/**` from collection exactly as it did for PK-62.
const checkedStatuses = effectiveGearStatuses(query.statuses);

// See `unsurfacedFilterParams` (src/lib/gear/query.ts) for what these are and why the
// page has to both re-emit and disclose them. `[...params]` rather than the object form
// because `category` and `brand` legitimately repeat.
const unsurfacedFilters = [...unsurfacedFilterParams(query)];
const closetIsSilentlyFiltered = hasUnsurfacedFilters(query);

/**
 * The labelled column headers live in `GEAR_LIST_COLUMNS` (src/lib/gear/fields.ts), not
 * here, so that "the Brand header is a sort link" is a testable claim rather than a line
 * in a file `vitest.config.ts` excludes. See that constant's own comment — including its
 * warning that the `<tbody>` cells below are a separate hand-maintained list in the same
 * order that nothing checks. The first and last cells (the select-all checkbox and the
 * Photo column's sr-only heading) are not in it, because neither carries a visible label.
 */

function sortHref(key: GearSortKey): string {
  return `${GEAR_PATH}?${sortLinkSearchParams(query, key).toString()}`;
}

function sortAriaSort(key: GearSortKey): 'ascending' | 'descending' | undefined {
  if (query.sort !== key) return undefined;
  return query.direction === 'asc' ? 'ascending' : 'descending';
}

function sortIndicator(key: GearSortKey): string {
  if (query.sort !== key) return '';
  return query.direction === 'asc' ? ' ▲' : ' ▼';
}

function pageHref(target: number): string {
  return `${GEAR_PATH}?${gearQueryToSearchParams({ ...query, page: target }).toString()}`;
}

/**
 * PK-63: "saving returns you where you were" starts here — every route INTO the gear
 * item form (Add item, the empty-state's own copy of it, and each row's item-name
 * link) has to carry the current view so new.astro/[id].astro can hand it back to
 * gearReturnPath (src/lib/gear/return-path.ts) on Cancel and on a successful save. The
 * current view is exactly `${Astro.url.pathname}${Astro.url.search}` — this page's own
 * URL, filters/sort/page and all — passed to gearFormHrefReturningTo at each of the
 * three call sites below so they cannot drift into three slightly different ideas of
 * "here". See that function's own comment (src/lib/gear/return-path.ts) for why it
 * lives there rather than as a page-local helper.
 */
// REBUILT FROM `query` RATHER THAN COPIED FROM THE URL (PK-65). `gearListPath` assembles
// the path from the parsed `GearQuery` alone, so anything this page does not own is left
// behind by construction — which is the same argument the POST branches above make for
// redirecting through it instead of `${GEAR_PATH}${Astro.url.search}`.
//
// It became necessary rather than merely tidier when import gained its `?imported=N`
// banner. Copied verbatim, that parameter rode into the "Add item" link's `next=`, so
// saving an unrelated item afterwards landed back on `/gear?imported=4` and re-announced
// an import that had not just happened — a banner lying about something a visitor did
// minutes ago. Rebuilding drops it, along with any stray `?utm_source=` and any parameter
// a future feature adds elsewhere.
const currentView = gearListPath(query);

// ---------------------------------------------------------------------------
// THERE ARE NO PAGE-LOCAL PRESENTATION HELPERS LEFT, and the last one to go is worth
// recording (PK-70). PK-64 kept an `isNumericColumn(label)` here — `label === 'Qty' ||
// label === 'Weight' || label === 'Price'` — under a header arguing that a pure display
// decision belongs on the page because getting it "wrong" skips a right-align rather than
// stating a wrong fact.
//
// That argument was fine about WHERE the decision could live and wrong about WHAT it could
// be keyed off. Reading it off the display copy means renaming Qty to Quantity compiles,
// ships, and quietly loses the alignment on a whole column — which is precisely the footgun
// `GEAR_LIST_COLUMNS`'s own comment in src/lib/gear/fields.ts says its `numeric` field
// exists to remove, and the field has been there since PK-64 with this page not reading it.
// The `<th>` below now destructures `numeric` straight off the column, so a new column
// cannot be added without answering the question, and the answer sits somewhere
// `vitest.config.ts` lets a test reach. The reasoning the old helper's doc comment carried
// survives at that call site: §7, "figures are written, and right-aligned".
// ---------------------------------------------------------------------------

// WHICH BRANCH OF THE FOUR-STATE CHAIN BELOW RENDERS THE LIST (PK-70). The filter bar used
// to sit inside that chain, immediately above the list, so "only shown when the list is"
// was structural. PK-70 merges it into the header sheet — a different part of the document
// entirely — so the condition has to be named here instead and read in two places. It is
// exactly the negation of the three states that render something else: a load error, an
// unconfirmed bulk delete, and a closet with nothing in it. Do NOT loosen it. A filter bar
// above a load error offers controls over rows that failed to load; above the delete
// confirmation it invites a navigation that abandons the confirmation mid-gesture; and above
// "Your closet is empty" it is a control for narrowing nothing.
const listIsRendered = !loadError && !pendingDelete && !closetIsEmpty;
---

<Layout
  title="Your gear closet — Packsheet"
  description="Search, filter and manage the gear in your Packsheet closet."
>
  <GearNav />
  <main class="paper-col flex flex-col gap-[30px] py-[30px]">
    {
      /* ONE HEADER SHEET (PK-70), holding the title and its actions, the filter bar, and
         the headline figures in that order. It used to be two sheets with the filter bar in
         its own — which meant the visitor's eye crossed a sheet boundary between "Your gear
         closet" and the controls that decide what is in it, and the count sat two sheets
         above the list it counts.

         THE COUNT NOW SITS DIRECTLY ABOVE THE LIST, WHICH IS HONEST RATHER THAN MERELY
         TIDIER: `totalCount` is the count of rows matching the CURRENT filters, not of the
         closet, so putting it at the foot of the filter bar puts it where the thing it
         describes was decided. `.ledger-figures` draws its own top hairline (paper.css, §7),
         so nothing else separates it — a second <hr> there would be a rule above a rule.

         STILL ONE SHEET AND NO INNER BOXES (DESIGN.md §13). The form carries no border or
         background of its own; the sheet is the only box, exactly as PK-64 left it when it
         un-nested the form from a bordered fieldset inside a bordered form. */
    }
    <div class="sheet">
      <div class="sheet-body">
        {
          /* PK-70 DELETED TWO PIECES OF COPY FROM THIS HEADER, and both deletions are
             recorded here rather than left invisible.

             The `<p class="eyebrow">Gear</p>` above the title said "Gear" immediately above
             "Your gear closet", one line under a nav whose current section is already Gear.
             DESIGN.md §4 gives the eyebrow to the system voice for orientation; there was
             nothing left here to orient.

             The `<p class="aside">everything, weighed once</p>` below it carried a comment
             calling it "the one written phrase this sheet is allowed" (§4's .aside). It was
             allowed and it was still marketing copy sitting on the visitor's own working
             screen, repeated on every visit and every filter change. The written voice is
             not being withdrawn from the language; this particular phrase is withdrawn from
             this particular sheet, which now opens straight onto the title. */
        }
        <header class="flex items-start justify-between gap-6">
          <h1 class="page-title">Your gear closet</h1>
          {
            /* C1 (PK-4 review): a primary action in the heading row, rendered whether the
               closet is empty or full. THIS IS NOW THE ONLY LINK TO GEAR_NEW_PATH ON THIS
               PAGE'S CHROME — PK-62 removed GearNav's "Add item" link (see that file's own
               comment for why), so this button is load-bearing rather than the second, more
               prominent copy of a nav link it used to be. Do not remove it on the grounds
               that the nav covers it; the nav no longer does. The empty state below carries
               its own copy for the case where there is no table to put this above.
               .btn-primary matches the empty state's already-established button styling
               rather than inventing a second vocabulary for "add an item".

               WHY THIS DIV IS A LIVE REGION (PK-70), when nothing about "Import" or "Add
               item" looks filter-dependent: both hrefs carry
               `gearFormHrefReturningTo(..., currentView)` — a `next=` naming the view the
               server rendered them for. After an in-place filter change the URL, the list
               and the count have all moved on and these two links have not, so saving an
               item would land the visitor back on the PRE-filter view: the right page, the
               wrong query, and nothing anywhere to say why. Re-rendered from the same
               response as the list, the `next=` moves with everything else. The attribute
               name is `LIVE_REGION_ATTRIBUTE` in src/lib/gear/live-list.ts — see the note on
               the filter form below for why every one of these names is written here as a
               literal. */
          }
          <div id="gear-actions" data-gear-live-region class="flex shrink-0 items-center gap-3">
            {
              /* PK-65. The only route to the import page, and it is here rather than in
                 GearNav for the reason that file's own comment gives for keeping the nav to
                 DESTINATIONS: importing is something you do to your closet, from your closet,
                 not a section of the product. Rendered as a quiet secondary action beside the
                 primary one — "Add item" is what a visitor does daily and this is what they
                 do once, so it must not compete with it. Unlike the export button, this is a
                 plain link: it starts a page, not an action on a selection. */
            }
            <a href={GEAR_IMPORT_PATH} class="btn"> Import </a>
            <a href={gearFormHrefReturningTo(GEAR_NEW_PATH, currentView)} class="btn btn-primary">
              Add item
            </a>
          </div>
        </header>

        {
          /* The search-plus-status bar (PK-62), all that is left of what was a filter panel
              heavier than the closet it filtered: Category, Brand and Weight-range fieldsets,
              over a list that is a few hundred rows at most. Search and three status
              checkboxes replace the lot — brand and category are now column sorts instead of
              a checkbox per value the visitor owns.

              RENDERED ONLY WHEN THE LIST IS (PK-70). Living inside the header sheet, it has
              lost the structural guarantee it had while it sat immediately above the list in
              the same ternary chain, so the condition is named explicitly — see
              `listIsRendered` in the frontmatter for what each of the three excluded states
              would mean with a filter bar over it.

              STILL A SINGLE GET FORM, so applying it is a plain, bookmarkable navigation, and
              so the in-place update below has a real navigation to degrade to. sort/dir are
              carried as hidden fields so changing the search or a status does not silently
              reset the visitor's chosen sort; page is deliberately NOT carried, since a new
              filter set changes what "page 3" even means.

              THE ATTRIBUTE AND ID LITERALS BELOW ARE DECLARED IN src/lib/gear/live-list.ts —
              `GEAR_FILTERS_FORM_ID`, `LIVE_REGION_ATTRIBUTE`, `LIVE_LINK_ATTRIBUTE`,
              `LIVE_SUMMARY_ATTRIBUTE`, `GEAR_LIVE_STATUS_ID` — and are written here as
              literals rather than interpolated from those imports, for the reason
              `src/components/Modal.astro` gives for doing the same with `MODAL_ATTRIBUTE`:
              `{...{ [LIVE_REGION_ATTRIBUTE]: '' }}` in markup costs more legibility than the
              join is worth. What stops the two sides drifting is not the spelling, it is
              `tests/gear-closet-markup.test.ts`, which reads this file and asserts every one
              of those literals against the exported constant. That test is not decoration:
              rename either side and `initGearLiveList` finds nothing, every control falls
              back to a full navigation, and the result is indistinguishable from the
              intended no-JS path — a dead feature with a green suite.

              NO "Apply filters" BUTTON ONCE SCRIPTING IS CONFIRMED WORKING, AND THE FORM
              STILL WORKS WITHOUT IT. Two independent mechanisms, neither relying on the
              other:

                - The search field submits on Enter. HTML's implicit submission fires for
                  a form with no submit button when AT MOST ONE field blocks it (zero
                  blocking fields submits too; two or more is what does nothing). Here
                  there is exactly one: `type="search"` is on the blocking list, and
                  neither the three checkboxes nor the two `type="hidden"` inputs are.
                  Add a second text-like input and Enter silently stops working — and
                  note the rule keys off FORM OWNERSHIP, not nesting, so an input
                  elsewhere in the document carrying form="gear-filters" breaks it just
                  as surely as one added between these tags.
                - The status checkboxes are submitted by the Apply button below when the
                  inline script has not removed it, and by that script's own change
                  listener when it has — unless the bundled module has taken over, which
                  the two scripts at the foot of this file settle between them. See the
                  button's comment for why this is not a <noscript>, which guards the wrong
                  condition. */
        }
        {
          listIsRendered && (
            <form method="GET" action={GEAR_PATH} id="gear-filters" class="mt-8">
              <div class="flex flex-col gap-6 sm:flex-row sm:items-start sm:justify-between">
                <div class="sm:max-w-md sm:flex-1">
                  <label for="q" class="field-label">
                    Search
                  </label>
                  <div class="search mt-1">
                    <svg
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      aria-hidden="true"
                      focusable="false"
                    >
                      <circle cx="11" cy="11" r="8" />
                      <path d="m21 21-4.3-4.3" />
                    </svg>
                    <input
                      id="q"
                      name="q"
                      type="search"
                      value={query.search}
                      placeholder="Search name or brand"
                    />
                  </div>
                </div>

                {/* A fieldset with a visible legend rather than no grouping at all: the
                    three boxes are one control ("which statuses am I looking at"), and a
                    screen reader needs that said once rather than inferred from three
                    adjacent labels. PK-64 gives the legend the same .field-label
                    treatment as "Search" beside it, matching the reference design;
                    "Owned / Wishlist / Retired" was already self-describing on sight,
                    and the visible label now says what the group of three IS. */}
                <fieldset class="sm:shrink-0">
                  <legend class="field-label">Status</legend>
                  <div class="mt-1 flex flex-wrap items-center gap-x-5 gap-y-2">
                    {GEAR_STATUSES.map((status) => (
                      <label class="text-ink flex items-center gap-2 text-sm">
                        <input
                          type="checkbox"
                          name="status"
                          value={status}
                          checked={checkedStatuses.includes(status)}
                          class="checkbox"
                        />
                        {formatGearStatus(status)}
                      </label>
                    ))}
                  </div>
                  {/* THE WCAG 3.2.2 ADVISORY THAT USED TO LIVE HERE IS GONE (PK-70), AND
                      THIS IS THE ARGUMENT FOR REMOVING IT, because the comment it replaces
                      insisted at length that it was load-bearing — "it is not decoration and
                      it is not a tooltip: remove it and this auto-submit becomes an
                      unannounced change of context".

                      The sentence was `<p class="hint mt-1.5">Changing a status updates the
                      list.</p>`, and it was the advisory WCAG 3.2.2 (On Input, Level A)
                      requires where changing a setting causes a change of context "unless the
                      user has been advised of the behavior before using the component". What
                      made it required was the BEHAVIOUR: ticking a box submitted the form and
                      RELOADED THE PAGE. A new page is a change of context, so the advisory was
                      owed.

                      PK-70 removes that behaviour. A tick now updates a region of this page in
                      place — no new window, no new page, no focus moved, nothing opened. None
                      of those is a change of context under 3.2.2, so the success criterion has
                      nothing to say about it and there is no advisory to owe. The requirement
                      was never attached to the checkbox; it was attached to the navigation, and
                      the navigation is what went. Removing the behaviour is what removes the
                      requirement — not a decision that the advisory was surplus.

                      THE NO-JS PATH DOES NOT PUT IT BACK. With no script running, these boxes
                      change nothing until the visitor presses Apply — a button they pressed on
                      purpose, which is a submission and not an "on input" event, and so was
                      never 3.2.2's concern in the first place. The one behaviour that WOULD owe
                      an advisory again is the inline fallback's own auto-submit, and that path
                      only exists where the module failed to arrive; it is the same auto-submit
                      as before and the same cost, now confined to a case nobody should be in.
                      If that fallback ever becomes the ordinary path again, this sentence
                      comes back with it. */}
                </fieldset>
              </div>

              <input type="hidden" name="sort" value={query.sort} />
              <input type="hidden" name="dir" value={query.direction} />

              {/* Category, brand and the weight range: honoured by the query layer, with
                  no control on this page since PK-62. Re-emitted so that submitting this
                  form preserves them exactly as the sort headers and the pager already do,
                  instead of being the one path that silently discards them. The notice
                  below is what stops that from being an undisclosed filter. They are also
                  what `filterFormUrl` (src/lib/gear/live-list.ts) reads back out of this
                  form on an in-place update, so the two paths carry them identically. */}
              {unsurfacedFilters.map(([name, value]) => (
                <input type="hidden" name={name} value={value} />
              ))}

              {/* ALWAYS RENDERED, AND REMOVED BY THE INLINE SCRIPT BELOW ONCE IT HAS
                  ACTUALLY WIRED THE CHECKBOXES UP. This started as a <noscript> block, which
                  was wrong in a way worth recording so it does not come back: <noscript> keys
                  on SCRIPTING BEING ENABLED, not on this page's script having run. Those
                  are different conditions, and every way they diverge left all three
                  checkboxes as dead controls with no button and no feedback — a blocked or
                  404'd bundle after a deploy, a Content-Security-Policy that refuses the
                  script, an extension, or simply an exception thrown earlier in the same
                  bundle. Rendering the button unconditionally and deleting it only on the
                  success path inverts that: the worst case is now one redundant button,
                  not a filter bar that silently does nothing. */}
              <button type="submit" id="gear-filters-apply" class="btn btn-primary mt-4">
                Apply
              </button>

              {/* THE ONLY DISCLOSURE, AND THE ONLY ESCAPE, for a filter with no control.
                  Without this, a visitor arriving on a bookmarked `?category=Shelter` — a
                  URL PK-4 shipped and this ticket removed the UI for — sees a closet
                  missing most of its gear with nothing on the page saying why, and the
                  "Clear filters" link in the no-results state never renders because the
                  filter DID match something. Deliberately not a reconstruction of the old
                  filter panel: it says the closet is filtered and offers one link that
                  removes every such filter, which is the whole of what a visitor can
                  usefully do about a control that no longer exists. */}
              {closetIsSilentlyFiltered && (
                <p role="status" class="hint mt-4">
                  This closet is filtered by settings this page no longer shows.{' '}
                  <a href={GEAR_PATH} class="text-blue-deep hover:text-blue-ink underline">
                    Clear filters
                  </a>
                </p>
              )}
            </form>
          )
        }

        {
          /* DESIGN.md §9: an empty page has no figures to report, so the count above an
             empty closet is hidden rather than showing zero — see closetIsEmpty below. A
             load error leaves totalCount at its `count ?? 0` fallback, which is not a real
             count either, so the figures are withheld there too.

             A LIVE REGION OF ITS OWN (PK-70), because the figure is filtered. `totalCount`
             counts the rows the CURRENT query matched, and it is rendered here in the header
             sheet, outside the list region an in-place update swaps. Without this attribute
             a visitor who searches a 47-item closet down to 3 keeps reading "Items 47" above
             a list of three — not a lie exactly, but a stale number stated with total
             confidence, which is worse than no number at all. */
        }
        {
          !closetIsEmpty && !loadError && (
            <dl id="gear-figures" data-gear-live-region class="ledger-figures mt-8">
              <div>
                <dt>Items</dt>
                <dd class="numeric">{totalCount}</dd>
              </div>
            </dl>
          )
        }
      </div>
    </div>

    {
      /* THE ONE LIVE REGION THAT IS NEVER SWAPPED, and it is outside every sheet above and
         below for exactly that reason. `initGearLiveList` writes the new result count in
         here after each in-place update so a screen reader is told what changed; an element
         that is itself replaced wholesale by the same update does not reliably announce,
         because the node the assistive technology was observing stops existing. Keep it out
         of every `data-gear-live-region` — nesting it inside one would look identical in a
         screenshot and be silent in use.

         `role="status"` (implicitly polite) rather than an assertive region: this is the
         result of something the visitor just did, and it must wait its turn rather than
         interrupt whatever they are reading. `aria-live="polite"` is stated as well as
         implied, which costs nothing and survives a future change of role. It renders empty
         and stays empty where no script runs, which is right: with a full navigation the new
         count is simply on the page. */
    }
    <p id="gear-live-status" class="sr-only" role="status" aria-live="polite"></p>

    {
      bulkError && (
        <div class="note note-danger" role="alert">
          <p>{bulkError}</p>
        </div>
      )
    }

    {
      /* PK-65: the only confirmation an import gets. `role="status"` rather than
         `role="alert"` — this is not an error and must not interrupt a screen reader
         mid-sentence the way an assertive live region does. It is a plain `.note` — the
         one card DESIGN.md §2.5 allows to lie directly on the paper — rather than a
         coloured one, because CONTRIBUTING reserves blue for interactive elements and
         base weight, and there is no "success green" in tokens.css to reach for. */
    }
    {
      importedMessage && (
        <div class="note" role="status">
          <p>{importedMessage}</p>
        </div>
      )
    }

    {
      loadError && (
        <div class="note note-danger" role="alert">
          <p>{loadError}</p>
        </div>
      )
    }

    {
      loadError ? null : pendingDelete ? (
        <div class="note note-danger">
          <h2 class="section-title text-rust">Confirm delete</h2>
          {/* Names the irreversibility in the same breath as the count, and then the
              one thing a visitor might reasonably fear losing along with the item: a
              pack that lists it. gear_items_snapshot_before_delete (core_schema.sql)
              freezes the row's name, weight and price into every pack_items row still
              pointing at it, so the pack keeps its line rather than losing it — see
              deleteGearItems's own comment in src/lib/gear/mutations.ts. Deliberately
              NOT a typed-word confirmation like account/index.astro's: that gate is
              reserved for the one action that takes everything, and asking someone to
              type a word before deleting a tent would spend the gesture's whole force
              on the wrong thing.

              THE PACK CLAUSE IS PLURALISED AS A WHOLE, not just its opening words
              (PK-60 review, B4). Switching only "If it appears"/"If any appear" left the
              rest of the sentence singular — "…on a saved pack, that pack keeps a frozen
              copy" — which both reads wrong after a plural subject and describes the
              wrong mechanic: three deleted items can sit on three DIFFERENT packs, and
              the trigger freezes each one separately, so there is no single "that pack"
              to point at. */}
          <p class="hint mt-2">
            Delete {pendingDelete.ids.length} item{pendingDelete.ids.length === 1 ? '' : 's'}{' '}
            permanently? This cannot be undone.{' '}
            {pendingDelete.ids.length === 1
              ? 'If it appears on a saved pack, that pack keeps a frozen copy.'
              : 'If any appear on saved packs, those packs keep a frozen copy.'}
          </p>
          <form method="POST" class="mt-4 flex gap-3">
            <input type="hidden" name={BULK_FORM_FIELD.intent} value={BULK_INTENT.delete} />
            {/* The value comes from the same constant confirmsGearDeletion compares
                against, never a bare "1": the writer and the reader of this gate must
                not be able to drift apart — see GEAR_DELETE_CONFIRMATION_VALUE in
                src/lib/gear/bulk.ts. */}
            <input
              type="hidden"
              name={BULK_FORM_FIELD.confirm}
              value={GEAR_DELETE_CONFIRMATION_VALUE}
            />
            {pendingDelete.ids.map((id) => (
              <input type="hidden" name={BULK_FORM_FIELD.id} value={id} />
            ))}
            <button type="submit" class="btn btn-danger">
              Delete permanently
            </button>
            <a href={`${GEAR_PATH}${Astro.url.search}`} class="btn">
              Cancel
            </a>
          </form>
        </div>
      ) : closetIsEmpty ? (
        <div class="sheet">
          {/* .blank stands in for .sheet-body — it carries the same padding and
              isolation itself (paper.css's own comment on the class) — centred, with
              real air, per DESIGN.md §9. Not a bordered box. */}
          <div class="blank">
            <p class="section-title">Your closet is empty.</p>
            <p class="hint mt-2">
              Add the first thing you carry and Packsheet will start keeping the arithmetic.
            </p>
            <a
              href={gearFormHrefReturningTo(GEAR_NEW_PATH, currentView)}
              class="btn btn-primary mt-6"
            >
              Add your first item
            </a>
          </div>
        </div>
      ) : (
        /* THE LIST REGION (PK-70) — everything an in-place update replaces, wrapped in one
           element so there is one thing to swap rather than a run of siblings. It has to
           span BOTH arms of the ternary inside it, because a filter change routinely moves
           the page between them: narrowing a search to nothing turns the table into the
           "no items match" block, and widening it again turns it back. A region that only
           wrapped the table would have nothing to match against in the empty case, and
           `swapLiveRegions` (src/lib/gear/live-list.ts) would leave the previous, wrong list
           on screen rather than replacing it.

           `data-gear-live-region` is `LIVE_REGION_ATTRIBUTE` and the `id` is what pairs this
           element with its counterpart in the fetched response — matched by `id`, never by
           position, so the two arms above are free to differ in shape. Written as literals
           for the reason the filter form's own comment gives, and pinned against the
           module's constants by `tests/gear-closet-markup.test.ts`. */
        <div id="gear-list" data-gear-live-region>
          {items.length === 0 ? (
            <div class="sheet">
              <div class="blank">
                <p class="text-ink text-sm font-medium">No items match these filters.</p>
                <a
                  href={GEAR_PATH}
                  class="hint text-blue-deep hover:text-blue-ink mt-2 inline-block underline"
                >
                  Clear filters
                </a>
              </div>
            </div>
          ) : (
            <div class="sheet">
              <div class="sheet-body">
                <form method="POST">
                  <div class="overflow-x-auto">
                    <table class="ledger">
                      <caption class="sr-only">Your gear closet</caption>
                      <thead>
                        <tr>
                          <th scope="col">
                            <input
                              type="checkbox"
                              id="select-all"
                              aria-label="Select all items on this page"
                              class="checkbox"
                            />
                          </th>
                          {/* CATEGORY BECAME A SORT LINK WITH NO CHANGE HERE (PK-70), which
                              is the payoff `GEAR_LIST_COLUMNS`' own comment claims: its entry
                              gained a `key`, `GEAR_SORT_KEYS`/`GEAR_SORT_COLUMNS` gained the
                              matching pair, and this map rendered a link for it without a line
                              being touched. Same substitution PK-62 made for Brand — the
                              Category filter checkboxes went, and a sort gives back the one
                              grouping they provided without a panel of every category the
                              visitor owns.

                              ALIGNMENT COMES FROM `numeric`, NOT FROM THE LABEL. This read
                              `isNumericColumn(label)` — a page-local helper matching 'Qty',
                              'Weight' and 'Price' by name — until PK-70 deleted it. §7 puts
                              figures on the right, and which columns hold figures is a fact
                              about the column, not about the word at the top of it: keyed off
                              the copy, renaming Qty to Quantity compiled, shipped and silently
                              lost the alignment down a whole column. The `numeric` field has
                              been on `GEAR_LIST_COLUMNS` since PK-64 for exactly this and this
                              page was not reading it. The `<td>`s below hardcode `numeric
                              text-right` and are a separate hand-maintained list — see that
                              constant's own warning.

                              `data-gear-live-link` IS `LIVE_LINK_ATTRIBUTE` and its value is
                              the `sort:<key>` shape `liveLinkKind` parses. The `<a>` keeps a
                              real `href` underneath it: with no module the click is an ordinary
                              navigation to the same URL, which is the whole degradation story
                              here. */}
                          {GEAR_LIST_COLUMNS.map(({ key, label, numeric }) => (
                            <th
                              scope="col"
                              aria-sort={key === null ? undefined : sortAriaSort(key)}
                              class={numeric ? 'text-right' : undefined}
                            >
                              {key === null ? (
                                label
                              ) : (
                                <a href={sortHref(key)} data-gear-live-link={`sort:${key}`}>
                                  {label}
                                  {sortIndicator(key)}
                                </a>
                              )}
                            </th>
                          ))}
                          <th scope="col">
                            <span class="sr-only">Photo</span>
                          </th>
                        </tr>
                      </thead>
                      <tbody>
                        {items.map((item) => {
                          const marker = gearStatusMarker(item.status);
                          return (
                            /* THE ROW CARRIES NO CLASS AT ALL NOW (PK-70), and what it used
                               to carry is worth stating rather than diffing for. It was
                               `class={marker === null ? undefined : GEAR_MARKER_ROW_CLASS[marker]}`,
                               under a comment defending the TOTAL map behind it: a 5.5% wash
                               of the state's colour across the row and a 3px bar of it at the
                               left edge, ochre for wishlist and rust for retired.

                               The map was the right shape and it was marking the wrong kind of
                               thing. DESIGN.md §7 reserves the wash and the bar for a row that
                               is "genuinely exceptional — one that FAILED, rather than one
                               that is merely a different kind of ordinary", and wishlist and
                               retired are both ordinary states of a closet. So a third of the
                               list wore an alert treatment carrying no urgency, which is what
                               design feedback read as noise. §7 was AMENDED by this ticket
                               rather than quietly contradicted (the appendix records it), and
                               the wash and bar survive in paper.css as `.row-invalid`, in rust,
                               for the gear import's preview of a row it could not accept.

                               WHAT CARRIES A NON-OWNED STATUS NOW IS SHAPE, NOT HUE: the icon
                               before the name and the strike through a retired one. That is
                               what §12 asks for anyway — colour is never the only signal — and
                               it is the same argument the unmarked-owned default already made,
                               one step further out. `gearStatusMarker` is still called, and
                               still total; only the class it also used to key is gone. */
                            <tr>
                              <td>
                                <input
                                  type="checkbox"
                                  name={BULK_FORM_FIELD.id}
                                  value={item.id}
                                  aria-label={`Select ${item.name}`}
                                  class="checkbox"
                                />
                              </td>
                              <td>
                                {/* THE RAGGED LEFT EDGE HERE IS DELIBERATE. `gap-1.5`
                                    applies BETWEEN children, so an owned row — which renders
                                    no icon at all — has its name start flush at the cell's
                                    padding while wishlist and retired rows are indented by the
                                    glyph. PK-62 accepts that and explicitly forbids evening it
                                    up with a spacer or a placeholder glyph.

                                    THE `gearStatusMarker` GUARD IS WHAT KEEPS OWNED UNMARKED
                                    HERE, and it has to live at this call site rather than in
                                    the component. GearStatusIcon draws all three statuses,
                                    because PK-63's radio group presents them as equal choices
                                    and an icon-less "Owned" option there would read as a bug.
                                    This list wants the opposite: owned is its unmarked default.
                                    Policy per caller, drawing in the component — see that
                                    file's own comment.

                                    THE STRIKE ON A RETIRED NAME (DESIGN.md §7) USED TO BE THE
                                    THIRD SIGNAL AND IS NOW THE SECOND OF TWO. This said it
                                    "carries the same information as row-retired's wash and bar
                                    in a third, non-colour form — §12's colour is never the only
                                    signal". PK-70 removed the wash and the bar from gear rows
                                    (see the `<tr>` above and §7's own amendment), so the strike
                                    is no longer redundant reinforcement of a colour: together
                                    with the icon it is now the whole of how a retired item
                                    reads, which is precisely the state §12 asks for — the
                                    signal was never allowed to be the colour, and now there is
                                    no colour to be tempted by. */}
                                <span class="flex items-center gap-1.5">
                                  {marker && <GearStatusIcon status={item.status} />}
                                  {/* THE ONLY PLACE A MALFORMED STATUS SURFACES ANYWHERE.
                                      Removing the Status column took away the one cell that
                                      rendered `item.status` as text, and `gearStatusMarker`
                                      returns null for a value it does not recognise — so such
                                      a row draws nothing, identical to `owned`. The trash page
                                      used to render a status verbatim and was the fallback
                                      this once pointed at; PK-60 deleted it, so this span is
                                      now the whole of it. sr-only costs no layout, so the
                                      ragged left edge is untouched; nothing renders here at
                                      all for the three real statuses. */}
                                  {!isGearStatus(item.status) && (
                                    <span class="sr-only">{formatGearStatus(item.status)}</span>
                                  )}
                                  <a
                                    href={gearFormHrefReturningTo(
                                      gearItemPath(item.id),
                                      currentView,
                                    )}
                                    class={`text-blue-deep hover:text-blue-ink underline${item.status === 'retired' ? ' line-through' : ''}`}
                                  >
                                    {item.name}
                                  </a>
                                </span>
                              </td>
                              <td>{item.brand ?? '—'}</td>
                              {/* NO CATEGORY DOT HERE, deliberately, and this is a departure
                                  from the reference mockup — read before adding one back.

                                  DESIGN.md §7 does put a 10px colour dot beside a category,
                                  and the mockup shows one, because the mockup was drawn on
                                  five invented categories that could be hand-mapped onto
                                  tokens.css's ten fills. The real column is unconstrained
                                  user-typed free text (see src/lib/gear/options.ts), so there
                                  is no mapping to make. Deriving one — a keyword list, or a
                                  hash of the category string — was tried and removed: it
                                  gives two unrelated categories the same colour, changes a
                                  category's colour when someone renames it, and encodes
                                  nothing a reader can decode. §5 is explicit that colour is
                                  semantic or absent and never decorative, and an arbitrary
                                  colour is decorative by definition.

                                  A real category→colour mapping is a product decision worth
                                  its own ticket. Until it exists the name is set in ink,
                                  which is honest. */}
                              <td>{item.category ?? '—'}</td>
                              <td class="numeric text-right">{item.quantity}</td>
                              {/* PK-67: through the formatter, not `{weight} {unit}`. Every
                                  row is a gram figure now, so this cell is the one place the
                                  account's system turns it back into something to read — which
                                  is what makes the column comparable by eye, the complaint the
                                  ticket opens with. */}
                              <td class="numeric text-right">
                                {formatWeight(item.weight_grams, weightSystem)}
                              </td>
                              <td class="numeric text-right">
                                {formatGearPrice(item.price, item.currency)}
                              </td>
                              <td>
                                {/* The photo chip sits on --paper-deep, so its text takes
                                    --ink-2 rather than --ink-3: tokens.css measures the
                                    third ink at 4.11:1 on --paper-deep, which fails AA. */}
                                {item.photo_path ? (
                                  <span
                                    class="bg-paper-deep text-ink-2 inline-flex h-6 items-center justify-center rounded-[var(--radius)] px-1.5 text-[10px] font-medium"
                                    aria-hidden="true"
                                  >
                                    IMG
                                  </span>
                                ) : null}
                                <span class="sr-only">
                                  {item.photo_path ? 'Has a photo' : 'No photo'}
                                </span>
                              </td>
                            </tr>
                          );
                        })}
                      </tbody>
                    </table>
                  </div>

                  <div class="mt-6 flex flex-wrap items-center gap-3">
                    <input
                      id="bulk-category"
                      name={BULK_FORM_FIELD.category}
                      type="text"
                      placeholder="New category"
                      aria-label="New category for selected items"
                      class="field w-40"
                    />
                    <button
                      type="submit"
                      name={BULK_FORM_FIELD.intent}
                      value={BULK_INTENT.setCategory}
                      class="btn"
                    >
                      Set category
                    </button>

                    {/* DESIGN.md §4: a bulk-action select is the SYSTEM voice, because
                        "Owned" here is an instruction to the app, not part of an item's
                        record — the opposite of the unit select `.field` was designed
                        around. This is THE call site that `.system` exists for, and the
                        reason paper.css writes it as `.system.system`: as a single class
                        it tied with `.field` on specificity and lost on source order, so
                        `field system` read as though it worked and did nothing. */}
                    <select
                      id="bulk-status"
                      name={BULK_FORM_FIELD.status}
                      aria-label="New status for selected items"
                      class="field system w-auto"
                    >
                      {GEAR_STATUSES.map((status) => (
                        <option value={status}>{formatGearStatus(status)}</option>
                      ))}
                    </select>
                    <button
                      type="submit"
                      name={BULK_FORM_FIELD.intent}
                      value={BULK_INTENT.setStatus}
                      class="btn"
                    >
                      Set status
                    </button>

                    {/* PK-65. Placed BEFORE the delete button, not after it: this toolbar
                         ends with the one irreversible action in the closet, and putting a
                         harmless button below it would mean a mis-aimed click at the bottom
                         of the row lands on delete. Styled as a neutral secondary action
                         like the two set-* buttons, deliberately not in blue — CONTRIBUTING
                         reserves blue for interactive elements and base weight, and this
                         toolbar has already established that vocabulary for its buttons. */}
                    <button
                      type="submit"
                      name={BULK_FORM_FIELD.intent}
                      value={BULK_INTENT.export}
                      class="btn"
                    >
                      Export selected
                    </button>

                    <button
                      type="submit"
                      name={BULK_FORM_FIELD.intent}
                      value={BULK_INTENT.delete}
                      class="btn btn-danger"
                    >
                      Delete selected
                    </button>
                  </div>
                </form>

                {/* PK-64: the pager moves inside the list sheet, separated from the bulk
                    bar by a hairline rule — DESIGN.md §13 refuses text sitting directly on
                    the paper, which is where this used to render. */}
                <hr class="sheet-rule" />

                <nav aria-label="Pagination" class="flex items-center justify-between gap-4">
                  {/* `data-gear-summary` is `LIVE_SUMMARY_ATTRIBUTE`. This line is the ONE
                      place the result count is written in words on this page, so it is also
                      what `liveStatusMessage` reads and announces into `#gear-live-status`
                      after an in-place update — reading the rendered text rather than
                      recomputing the count in client JS, which would be a second
                      implementation of `rangeStart`/`rangeEnd`/`totalCount` with no way to
                      stay honest against this one. Note the "no items match" arm above
                      renders no pager and therefore no summary at all; the module answers
                      `NO_RESULTS_ANNOUNCEMENT` for that case rather than announcing nothing. */}
                  <p class="hint" data-gear-summary>
                    Showing {rangeStart}–{rangeEnd} of {totalCount}
                  </p>
                  <div class="flex gap-2">
                    {/* `data-gear-live-link` again (`LIVE_LINK_ATTRIBUTE`), in its `page:`
                        form. These two are the only live links whose click also scrolls: a
                        multi-page list is taller than the viewport, so paging from row 50
                        without scrolling leaves the visitor looking at whatever rows happen to
                        sit at that offset in the NEW page, which is not the top of anything.
                        `initGearLiveList` finds the region to scroll by walking up from the
                        link to its enclosing `data-gear-live-region`, which is why the pager
                        has to be INSIDE the list region rather than beside it. */}
                    {page > 1 && (
                      <a href={pageHref(page - 1)} class="btn" data-gear-live-link="page:prev">
                        Previous
                      </a>
                    )}
                    {page < totalPages && (
                      <a href={pageHref(page + 1)} class="btn" data-gear-live-link="page:next">
                        Next
                      </a>
                    )}
                  </div>
                </nav>
              </div>
            </div>
          )}
        </div>
      )
    }
  </main>
</Layout>

{
  /* THE STATUS FILTER'S OWN SCRIPT, is:inline and deliberately NOT in the bundled module
    below. Two properties depend on both of those choices:

      1. An inline script cannot fail to load. The failure this design replaces was
         exactly "scripting is enabled but the module never arrived" — a hashed bundle
         404ing after a deploy, a CSP or extension refusing it, or an exception thrown
         earlier in the same bundle. <noscript> cannot see any of those, which is why the
         Apply button is a real button removed here rather than <noscript> content.
      2. It runs during parsing rather than after it, so the Apply button is gone before
         first paint instead of appearing and then vanishing. It sits at the FOOT of the
         document, after the form it operates on has been parsed — an inline script is
         synchronous, so "later in the document" is all the guarantee it needs.

    The removal happens FIRST, so anything that throws afterwards leaves the button in
    place and the form still usable. requestSubmit() is preferred over submit(), which
    skips both the submit event and constraint validation, but it is absent in Safari
    below 16 — where calling it unguarded would throw inside the change handler and
    produce the very dead control this exists to prevent.

    ---------------------------------------------------------------------------
    THE HANDSHAKE WITH THE BUNDLED MODULE (PK-70)
    ---------------------------------------------------------------------------

    Since PK-70 there are TWO things that could answer a status tick — this script, by
    submitting the whole form and navigating, and `initGearLiveList` in the bundled module
    below, by fetching the same URL and swapping the list in place. They must never both
    fire for one tick: that is an in-place update immediately thrown away by a full
    navigation to the same URL, which reads as a flicker and costs a request.

    `data-gear-live-ready` is what settles it, and it is `LIVE_READY_ATTRIBUTE` in
    src/lib/gear/live-list.ts — read that constant's own header for the module's half of
    this. The module sets it on the form synchronously, first thing, before it installs a
    single listener of its own; from that moment the handler below returns without
    submitting and this script is inert.

    THE CHECK IS INSIDE THE HANDLER, NOT AT INSTALL TIME, AND THE TWO ARE NOT
    INTERCHANGEABLE. This script runs during parsing; the bundled module runs after it. At
    the moment the listeners below are installed the attribute is necessarily absent, so a
    check there would pass on every visit and arm the fallback every time. By the time a
    visitor actually ticks a box the module has long since initialised — or has demonstrably
    failed to, which is the case this fallback exists for. (`live-list.ts`'s own header
    describes this as checking "before installing its listener"; the check has to be where
    it is for the parse order that same paragraph sets out.)

    IT IS `hasAttribute`, NOT `=== 'true'`. The module writes the attribute with an EMPTY
    value — `form.setAttribute(LIVE_READY_ATTRIBUTE, '')` — so PRESENCE is the signal, and
    comparing against any particular string would be a fallback that never stands down.

    IF THE MODULE NEVER ARRIVES — a 404'd bundle, a CSP refusal, an exception earlier in the
    same bundle — nothing sets the attribute, this handler submits, and ticking a status
    still works by full navigation exactly as it did before PK-70. That is the same
    degradation the Apply button's own comment argues for, one layer further in. */
}
<script is:inline>
  (function () {
    const form = document.getElementById('gear-filters');
    if (!form) return;
    const apply = document.getElementById('gear-filters-apply');
    if (apply) apply.remove();
    const submit = function () {
      // The stand-down. See this block's comment: the attribute being PRESENT means the
      // bundled module owns these checkboxes, and this fallback must do nothing at all.
      if (form.hasAttribute('data-gear-live-ready')) return;
      if (typeof form.requestSubmit === 'function') form.requestSubmit();
      else form.submit();
    };
    form.querySelectorAll('input[type="checkbox"][name="status"]').forEach(function (box) {
      box.addEventListener('change', submit);
    });
  })();
</script>

<script>
  import { initGearLiveList } from '../../lib/gear/live-list';

  // A DELEGATED LISTENER ON THE DOCUMENT, NOT ONE BOUND TO #select-all (PK-70). This was
  // `document.getElementById('select-all')` plus a `change` listener on the element itself,
  // bound once at module load — correct for as long as the row holding that box was only
  // ever replaced by a full navigation, and wrong the moment PK-70 landed, because
  // #select-all lives INSIDE `#gear-list`, which `swapLiveRegions` replaces wholesale on
  // every filter, sort and page change. Replacing a region's innerHTML detaches every node
  // in it, listeners included: the listener is not broken afterwards, it is attached to an
  // element that is no longer in the document. Select-all would have gone silently dead
  // after the first in-place update — a perfectly healthy-looking checkbox, nothing in the
  // console, and no way for a visitor to tell it apart from having forgotten to tick it.
  // That is exactly the kind of breakage this ticket could have shipped without noticing.
  //
  // Delegating to `document` — the one node this feature never replaces — is what survives
  // the swaps. Same reasoning `initGearLiveList` gives for binding its live links this way;
  // see point (d) in its header.
  //
  // Progressive enhancement only, as before: every bulk action is a real form submission and
  // works with this script never running. All this does is let a visitor tick one box
  // instead of every row's own checkbox individually.
  document.addEventListener('change', (event) => {
    const target = event.target;
    if (!(target instanceof HTMLInputElement)) return;
    if (target.id !== 'select-all') return;
    const checked = target.checked;
    document.querySelectorAll('input[type="checkbox"][name="id"]').forEach((box) => {
      if (box instanceof HTMLInputElement) box.checked = checked;
    });
  });

  // THE IN-PLACE LIST (PK-70). Every decision about what to fetch, what to swap, what to
  // announce and when to give up and navigate lives in src/lib/gear/live-list.ts, because
  // `vitest.config.ts:64` excludes `src/pages/**` and a <script> block here is code no test
  // in this repository can execute. What is left in this file is the four platform calls
  // that module deliberately does not make itself — the seams `GearLiveListDeps` exists to
  // name, so a test can drive a debounce with no clock and assert a fetch with no network.
  //
  // THIS REPLACES THE PK-62 BLOCK THAT USED TO SIT HERE: a `change` listener per status
  // checkbox calling `filters.requestSubmit()`, described in its own comment as "the JS
  // one" opposite the Apply button's no-JS one. `initGearLiveList` installs that listener
  // itself now (its point (c)), so keeping this copy would have raced a full navigation
  // against the in-place update on every tick — the same collision the inline script above
  // stands down from, and there is no reason for this file to avoid it in one place and
  // walk into it in another.
  initGearLiveList(document, {
    // `null` FOR EVERY FAILURE, NEVER A THROW, because the module treats null as ordinary
    // control flow — "the server said no" — and falls back to a real navigation for it. A
    // rejected promise would reach the same place through the module's own `catch`, but
    // returning the value the interface documents keeps the contract honest at the seam
    // rather than leaning on its belt-and-braces.
    //
    // `accept: 'text/html'` states what this request is for: this same page, as a document,
    // to be parsed and grafted. There is no JSON endpoint behind this and deliberately never
    // will be — the server is the only thing that knows how to turn a GearQuery into rows,
    // which is the whole argument of live-list.ts's "not a second renderer" section.
    fetchPage: async (url) => {
      try {
        const response = await fetch(url, { headers: { accept: 'text/html' } });
        return response.ok ? await response.text() : null;
      } catch {
        return null;
      }
    },
    // `assign`, not `replace`: this is the navigation that SHOULD have happened, so it
    // belongs in the visitor's history exactly as clicking the link would have.
    navigate: (url) => {
      location.assign(url);
    },
    // `replaceState`, not `pushState` — the module's point (e) argues it at length: every
    // keystroke in the search box is an update, and one history entry per character would
    // mean pressing Back once per letter typed before leaving this page at all.
    replaceUrl: (url) => {
      history.replaceState(null, '', url);
    },
    // Called with no options, deliberately: DESIGN.md §11 says paper does not animate, so
    // this is a plain jump rather than `{ behavior: 'smooth' }`.
    scrollIntoView: (element) => {
      element.scrollIntoView();
    },
  });
</script>
