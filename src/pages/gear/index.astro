---
// On-demand: this page requires a session, reads Astro.locals.user, mutates
// gear_items on POST and redirects — none of which a prerendered file can do. See
// src/middleware.ts for why GEAR_PATH carries the no-store rule the same way
// /account does.
export const prerender = false;

import Layout from '../../layouts/Layout.astro';
import GearNav from '../../components/GearNav.astro';
import GearStatusIcon from '../../components/GearStatusIcon.astro';
import { createAuthClient } from '../../lib/auth';
import { SIGN_IN_PATH } from '../../lib/auth-routes';
import { GEAR_NEW_PATH, GEAR_PATH, gearItemPath } from '../../lib/gear/routes';
import {
  gearListPath,
  gearQueryToSearchParams,
  hasUnsurfacedFilters,
  loadGearCloset,
  parseGearQuery,
  sortLinkSearchParams,
  unsurfacedFilterParams,
  type GearQuery,
} from '../../lib/gear/query';
import {
  GEAR_LIST_COLUMNS,
  GEAR_PAGE_SIZE,
  GEAR_STATUSES,
  checkedGearStatuses,
  isGearStatus,
  type GearSortKey,
} from '../../lib/gear/fields';
import {
  BULK_FORM_FIELD,
  BULK_INTENT,
  UNDO_COUNT_PARAM,
  UNDO_INTENT,
  UNDO_PARAM,
  makeUndoToken,
  parseBulkAction,
  parseUndoCount,
  parseUndoToken,
} from '../../lib/gear/bulk';
// `loadGearOptions` only — `extractGearOptions` is NOT called here any more. PK-62
// removed the Category and Brand filter checkboxes this page built from it, but the
// QUERY still runs, because `closetIsEmpty` below is derived from its row count and
// nothing else on this page can tell "your closet is empty" from "these filters matched
// nothing". `extractGearOptions` itself stays in src/lib/gear/options.ts, tested and
// unused for now, for the item form's category autocomplete (PK-63) — deleting it here
// would only mean writing it again there.
import { loadGearOptions } from '../../lib/gear/options';
import {
  bulkSetCategory,
  bulkSetStatus,
  bulkSoftDelete,
  undoBulkDelete,
} from '../../lib/gear/mutations';
// `formatGearAcquiredOn` arrives with PK-61, which moved the "Added" column off
// `created_at` and onto the visitor's own `acquired_on` date. `WEIGHT_UNITS` came in on
// the same import block on staging and is deliberately NOT carried across: PK-62 removed
// the weight-range fieldset that was its only consumer on this page.
import {
  formatGearAcquiredOn,
  formatGearPrice,
  formatGearStatus,
} from '../../lib/gear/format';

// src/middleware.ts has already resolved this with a verified getUser() call; reading
// it here rather than calling getUser() again is the whole point of doing it once in
// middleware. A null user redirects to sign-in with `next` set back to this exact URL
// (path + query), so signing in returns to the same filtered/sorted/paginated view
// rather than dropping the visitor on the closet's own default.
const user = Astro.locals.user;
if (!user) {
  const next = `${Astro.url.pathname}${Astro.url.search}`;
  return Astro.redirect(`${SIGN_IN_PATH}?next=${encodeURIComponent(next)}`);
}

// CSRF: same protection as sign-in.astro and account/index.astro — Astro's on-demand
// origin check (security.checkOrigin, set explicitly in astro.config.mjs) plus the
// session cookie's sameSite: 'lax'. No separate CSRF token is needed on top of that
// pair for the same reason it isn't on those pages.
const client = createAuthClient(Astro.cookies, Astro.request);

// Never render a raw PostgREST/Supabase error string — mirrors src/lib/auth/index.ts
// and src/lib/gear/form.ts's own "NEVER A RAW POSTGRES OR POSTGREST STRING" rule.
const GENERIC_LOAD_ERROR = 'Something went wrong loading your gear. Please try again.';
const GENERIC_WRITE_ERROR = 'Something went wrong updating your gear. Please try again.';

let bulkError: string | null = null;
/** Set only for a `bulk-delete` submission that has not yet been confirmed — see
 *  "Method discipline" below. Carries exactly the ids `parseBulkAction` validated, so
 *  the confirmation form can re-post the identical, already-validated selection rather
 *  than re-reading (and re-trusting) anything from the request a second time. */
let pendingDelete: { readonly ids: readonly string[] } | null = null;

// ---------------------------------------------------------------------------
// POST: bulk actions and undo.
//
// Method discipline: this page answers GET and POST, nothing else — Astro itself
// returns 405 for any other method, since no other handler is exported. Every
// state-changing branch below redirects with 303, so a refresh can never resubmit a
// mutation; the one branch that does NOT redirect (an unconfirmed bulk-delete) has not
// changed anything yet, which is the entire point of it.
// ---------------------------------------------------------------------------
if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const rawIntent = form.get(BULK_FORM_FIELD.intent);

  if (rawIntent === UNDO_INTENT) {
    // Reject anything malformed rather than passing it to a query — parseUndoToken is
    // total, so a missing, tampered or merely-plausible token all become `null` here
    // rather than reaching undoBulkDelete.
    const rawToken = form.get(UNDO_PARAM);
    const token = parseUndoToken(typeof rawToken === 'string' ? rawToken : null);
    if (token === null) {
      // Nothing valid to act on: redirect to a clean URL the same way a successful
      // undo does, rather than surfacing an error for input that was never trusted
      // enough to reach a query in the first place.
      return Astro.redirect(gearListPath(parseGearQuery(Astro.url.searchParams)), 303);
    }

    // I5 (PK-4 review): the write's result is now checked like every other write on
    // this page, rather than discarded — an undo that fails at the database no longer
    // looks byte-identical to one that succeeded.
    const { error } = await undoBulkDelete(client, user.id, token);
    if (error) {
      bulkError = GENERIC_WRITE_ERROR;
    } else {
      // Redirect to the SAME filtered/sorted/paged view the undo banner was shown on,
      // not a bare GEAR_PATH. Astro.url.searchParams here still carries `undo`/`count`
      // alongside whatever real filter was active; parsing it with parseGearQuery and
      // handing the result to gearListPath is what drops those two (so a refresh
      // cannot re-trigger the undo) while keeping every other filter — see
      // gearListPath's own comment for why this is done through GearQuery rather than
      // deleting `undo`/`count` off a copied URLSearchParams by name.
      return Astro.redirect(gearListPath(parseGearQuery(Astro.url.searchParams)), 303);
    }
  }

  const result = parseBulkAction(form);
  if (!result.ok) {
    bulkError = Object.values(result.errors)[0] ?? 'Choose a valid bulk action.';
  } else {
    const action = result.action;
    const ids = [...action.ids];

    if (action.intent === BULK_INTENT.delete) {
      // Bulk delete is destructive, so — following the house precedent in
      // account/index.astro's own two-step account deletion — the first submission
      // never writes anything. It only reveals a confirmation naming the count, built
      // from the SAME validated `ids` the second submission will re-post as hidden
      // fields. No client-side confirm() dialog anywhere in this.
      const confirmed = form.get(BULK_FORM_FIELD.confirm) === '1';
      if (!confirmed) {
        pendingDelete = { ids };
      } else {
        const token = makeUndoToken();
        // bulkSoftDelete (src/lib/gear/mutations.ts) carries the same
        // .is('deleted_at', null) guard the inline write here used to: re-submitting
        // an already-processed delete must not re-stamp rows an earlier batch already
        // put in the trash with THIS batch's new token — see bulk.ts's own "THE CALLER
        // MUST GUARD" comment.
        const { error, count } = await bulkSoftDelete(client, user.id, ids, token);
        if (error) {
          bulkError = GENERIC_WRITE_ERROR;
        } else {
          // The same filtered/sorted/paged view the visitor was on, plus the fresh
          // undo token and count — built from gearQueryToSearchParams(parseGearQuery
          // (...)) rather than copying Astro.url.searchParams and deleting/re-setting
          // UNDO_PARAM/UNDO_COUNT_PARAM by hand, so this can never accidentally carry
          // forward an EARLIER, unrelated undo/count pair that happened to already be
          // sitting in the current URL (e.g. a second bulk delete performed while a
          // previous delete's undo banner was still showing).
          //
          // I6 (PK-4 review): `count` is the number of rows bulkSoftDelete actually
          // touched, read off its own `.select('id')` — not `ids.length`, the number
          // the visitor merely asked for. A stale selection racing another tab now
          // reports honestly instead of claiming every requested id was moved.
          const redirectParams = gearQueryToSearchParams(parseGearQuery(Astro.url.searchParams));
          redirectParams.set(UNDO_PARAM, token);
          redirectParams.set(UNDO_COUNT_PARAM, String(count));
          return Astro.redirect(`${GEAR_PATH}?${redirectParams.toString()}`, 303);
        }
      }
    } else if (action.intent === BULK_INTENT.setCategory) {
      const { error } = await bulkSetCategory(client, user.id, ids, action.category);
      if (error) {
        bulkError = GENERIC_WRITE_ERROR;
      } else {
        // Same filtered/sorted/paged view, via gearListPath rather than
        // `${GEAR_PATH}${Astro.url.search}` verbatim — the difference matters
        // whenever the undo banner is currently showing (this form's own action
        // defaults to the current document URL, undo/count included): the verbatim
        // form would carry that now-unrelated undo/count pair forward into this
        // redirect, reviving a banner for an action that has nothing to do with it.
        // gearListPath drops both, the same way it does for the undo POST itself.
        return Astro.redirect(gearListPath(parseGearQuery(Astro.url.searchParams)), 303);
      }
    } else if (action.intent === BULK_INTENT.setStatus) {
      const { error } = await bulkSetStatus(client, user.id, ids, action.status);
      if (error) {
        bulkError = GENERIC_WRITE_ERROR;
      } else {
        // Same reasoning as bulk-set-category immediately above.
        return Astro.redirect(gearListPath(parseGearQuery(Astro.url.searchParams)), 303);
      }
    } else {
      // restore / delete-permanently: valid BULK_INTENT values, but they belong to
      // GEAR_TRASH_PATH, not this page — this list never renders a control that posts
      // either one. Reachable only by a hand-crafted or stale request, so it is
      // reported the same way an unrecognised intent is, not silently no-opped.
      bulkError = 'Choose a valid bulk action.';
    }
  }
}

// ---------------------------------------------------------------------------
// GET (and the render that follows every POST that did not redirect): parse the
// query, fetch the filter options and the current page of rows.
// ---------------------------------------------------------------------------
const query: GearQuery = parseGearQuery(Astro.url.searchParams);

// Both queries are owner-scoped and live in src/lib/gear/ now — loadGearOptions
// (src/lib/gear/options.ts) and loadGearCloset (src/lib/gear/query.ts) — so a test can
// reach the `.eq('user_id', user.id)` scoping directly rather than only through a page
// vitest.config.ts excludes. See loadGearCloset's own module comment for why that
// filter is load-bearing rather than belt-and-braces (the short version: gear_items
// carries a second SELECT policy, granted to authenticated visitors too, that a bare
// `.select()` would UNION in — "your gear closet" silently showing a stranger's gear
// the moment that stranger publishes a pack).
//
// loadGearCloset ALSO performs the C2 (PK-4 review) page clamp: `page` below is
// whatever page was actually queried, which may be LOWER than `query.page` if the
// visitor's own `?page=` was past the end of the result set — see that function's own
// comment for why this makes an over-range page land on the last real page instead of
// PGRST103's "Requested range not satisfiable" replacing the whole render with an error
// that could never resolve.
const { data: optionRows, error: optionsError } = await loadGearOptions(client, user.id);
const { items: rows, error: listError, count, page } = await loadGearCloset(client, user.id, query);

const loadError = optionsError || listError ? GENERIC_LOAD_ERROR : null;
const items = rows ?? [];
const totalCount = count ?? 0;
const totalPages = Math.max(1, Math.ceil(totalCount / GEAR_PAGE_SIZE));
const rangeStart = totalCount === 0 ? 0 : (page - 1) * GEAR_PAGE_SIZE + 1;
const rangeEnd = totalCount === 0 ? 0 : rangeStart + items.length - 1;

// "The closet has no active items at all" is exactly optionRows being empty: that
// query carries no filter beyond deleted_at is null, so an empty result there can only
// mean there is nothing to filter — never that today's filters merely matched nothing.
// This is what lets the two empty states below say two different, honest things
// instead of collapsing "you have no gear" and "no gear matches these filters" into
// one sentence that would be wrong for whichever case it wasn't written for.
const closetIsEmpty = !loadError && (optionRows ?? []).length === 0;

// ZERO CHECKED RENDERS AS ALL THREE CHECKED (PK-62) — the rule itself lives in
// `checkedGearStatuses` (src/lib/gear/fields.ts), not here, because it is one of this
// ticket's acceptance criteria and `vitest.config.ts` excludes `src/pages/**` from
// collection. See that function's own comment for the reasoning.
const checkedStatuses = checkedGearStatuses(query.statuses);

// See `unsurfacedFilterParams` (src/lib/gear/query.ts) for what these are and why the
// page has to both re-emit and disclose them. `[...params]` rather than the object form
// because `category` and `brand` legitimately repeat.
const unsurfacedFilters = [...unsurfacedFilterParams(query)];
const closetIsSilentlyFiltered = hasUnsurfacedFilters(query);

// The undo banner: only rendered for a token that survives validation — a malformed
// or tampered `undo` param is silently ignored rather than shown to anybody, exactly
// as parseUndoToken's own "reject anything malformed" contract promises the caller.
const undoToken = parseUndoToken(Astro.url.searchParams.get(UNDO_PARAM));
const undoCount = parseUndoCount(Astro.url.searchParams.get(UNDO_COUNT_PARAM));
const undoMessage =
  undoCount !== null
    ? `${undoCount} item${undoCount === 1 ? '' : 's'} moved to the trash.`
    : 'Items moved to the trash.';

/**
 * The labelled column headers live in `GEAR_LIST_COLUMNS` (src/lib/gear/fields.ts), not
 * here, so that "the Brand header is a sort link" is a testable claim rather than a line
 * in a file `vitest.config.ts` excludes. See that constant's own comment — including its
 * warning that the `<tbody>` cells below are a separate hand-maintained list in the same
 * order that nothing checks. The first and last cells (the select-all checkbox and the
 * Photo column's sr-only heading) are not in it, because neither carries a visible label.
 */

function sortHref(key: GearSortKey): string {
  return `${GEAR_PATH}?${sortLinkSearchParams(query, key).toString()}`;
}

function sortAriaSort(key: GearSortKey): 'ascending' | 'descending' | undefined {
  if (query.sort !== key) return undefined;
  return query.direction === 'asc' ? 'ascending' : 'descending';
}

function sortIndicator(key: GearSortKey): string {
  if (query.sort !== key) return '';
  return query.direction === 'asc' ? ' ▲' : ' ▼';
}

function pageHref(target: number): string {
  return `${GEAR_PATH}?${gearQueryToSearchParams({ ...query, page: target }).toString()}`;
}
---

<Layout
  title="Your gear closet — Packsheet"
  description="Search, filter and manage the gear in your Packsheet closet."
>
  <GearNav />
  <main class="mx-auto max-w-5xl px-6 py-10">
    <div class="flex items-center justify-between gap-4">
      <h1 class="text-3xl">Your gear closet</h1>
      {
        /* C1 (PK-4 review): a primary action in the heading row, rendered whether the
           closet is empty or full. THIS IS NOW THE ONLY LINK TO GEAR_NEW_PATH ON THIS
           PAGE'S CHROME — PK-62 removed GearNav's "Add item" link (see that file's own
           comment for why), so this button is load-bearing rather than the second, more
           prominent copy of a nav link it used to be. Do not remove it on the grounds
           that the nav covers it; the nav no longer does. The empty state below carries
           its own copy for the case where there is no table to put this above.
           border-blue-deep matches the empty state's already-established button styling
           rather than inventing a second vocabulary for "add an item". */
      }
      <a
        href={GEAR_NEW_PATH}
        class="border-blue-deep text-blue-deep hover:bg-blue-tint shrink-0 rounded-[var(--r-sm)] border px-4 py-2 text-sm font-medium transition-colors"
      >
        Add item
      </a>
    </div>

    {
      undoToken && (
        <div
          role="status"
          class="border-hairline bg-sunk text-ink mt-6 flex items-center justify-between gap-4 rounded-[var(--r-sm)] border px-4 py-3 text-sm"
        >
          <p>{undoMessage}</p>
          <form method="POST">
            <input type="hidden" name={BULK_FORM_FIELD.intent} value={UNDO_INTENT} />
            <input type="hidden" name={UNDO_PARAM} value={undoToken} />
            <button
              type="submit"
              class="border-blue-deep text-blue-deep hover:bg-blue-tint rounded-[var(--r-sm)] border px-3 py-1.5 text-sm font-medium transition-colors"
            >
              Undo
            </button>
          </form>
        </div>
      )
    }

    {
      bulkError && (
        <p
          role="alert"
          class="border-rust/40 bg-rust/10 text-ink mt-6 rounded-[var(--r-sm)] border px-4 py-3 text-sm"
        >
          {bulkError}
        </p>
      )
    }

    {
      loadError && (
        <p
          role="alert"
          class="border-rust/40 bg-rust/10 text-ink mt-6 rounded-[var(--r-sm)] border px-4 py-3 text-sm"
        >
          {loadError}
        </p>
      )
    }

    {
      loadError ? null : pendingDelete ? (
        <div class="border-rust/40 bg-rust/10 mt-6 rounded-[var(--r)] border px-5 py-4">
          <h2 class="text-rust text-lg">Confirm delete</h2>
          <p class="text-ink-2 mt-2 text-sm">
            Move {pendingDelete.ids.length} item{pendingDelete.ids.length === 1 ? '' : 's'} to the
            trash? You can undo this from the closet list right after.
          </p>
          <form method="POST" class="mt-4 flex gap-3">
            <input type="hidden" name={BULK_FORM_FIELD.intent} value={BULK_INTENT.delete} />
            <input type="hidden" name={BULK_FORM_FIELD.confirm} value="1" />
            {pendingDelete.ids.map((id) => (
              <input type="hidden" name={BULK_FORM_FIELD.id} value={id} />
            ))}
            <button
              type="submit"
              class="bg-rust text-paper rounded-[var(--r-sm)] px-4 py-2 text-sm font-medium transition-colors hover:brightness-95"
            >
              Move to trash
            </button>
            <a
              href={`${GEAR_PATH}${Astro.url.search}`}
              class="border-hairline text-ink-2 hover:text-ink rounded-[var(--r-sm)] border px-4 py-2 text-sm transition-colors"
            >
              Cancel
            </a>
          </form>
        </div>
      ) : closetIsEmpty ? (
        <div class="border-hairline bg-surface mt-8 rounded-[var(--r)] border px-6 py-12 text-center">
          <p class="text-ink-2">Your closet is empty.</p>
          <a
            href={GEAR_NEW_PATH}
            class="border-blue-deep text-blue-deep hover:bg-blue-tint mt-4 inline-block rounded-[var(--r-sm)] border px-4 py-2 text-sm font-medium transition-colors"
          >
            Add your first item
          </a>
        </div>
      ) : (
        <>
          {/* The search-plus-status bar (PK-62), all that is left of what was a filter
              panel heavier than the closet it filtered: Category, Brand and
              Weight-range fieldsets, over a list that is a few hundred rows at most.
              Search and three status checkboxes replace the lot — brand is now a column
              sort instead of a checkbox per brand the visitor owns.

              STILL A SINGLE GET FORM, so applying it is a plain, bookmarkable
              navigation. sort/dir are carried as hidden fields so changing the search
              or a status does not silently reset the visitor's chosen sort; page is
              deliberately NOT carried, since a new filter set changes what "page 3"
              even means.

              NO "Apply filters" BUTTON ONCE SCRIPTING IS CONFIRMED WORKING, AND THE FORM
              STILL WORKS WITHOUT IT. Two independent mechanisms, neither relying on the
              other:

                - The search field submits on Enter. HTML's implicit submission fires for
                  a form with no submit button when AT MOST ONE field blocks it (zero
                  blocking fields submits too; two or more is what does nothing). Here
                  there is exactly one: `type="search"` is on the blocking list, and
                  neither the three checkboxes nor the two `type="hidden"` inputs are.
                  Add a second text-like input and Enter silently stops working — and
                  note the rule keys off FORM OWNERSHIP, not nesting, so an input
                  elsewhere in the document carrying form="gear-filters" breaks it just
                  as surely as one added between these tags.
                - The status checkboxes are submitted by the Apply button below when the
                  inline script has not removed it, and by that script's own change
                  listener when it has. See the button's comment for why this is not a
                  <noscript>, which guards the wrong condition.

              CHANGING A STATUS RELOADS THE LIST, and WCAG 3.2.2 (On Input, Level A)
              allows that only where the visitor "has been advised of the behavior before
              using the component" — which is what the hint beside the checkboxes is for.
              It is not decoration and it is not a tooltip: remove it and this auto-submit
              becomes an unannounced change of context. The honest cost of the design even
              so is that each tick is a navigation that resets focus to the top of the
              document, so unticking two statuses means two reloads and two traversals. A
              visitor who would rather batch the changes can turn the script off; there is
              no in-page way to opt out. */}
          <form
            method="GET"
            action={GEAR_PATH}
            id="gear-filters"
            class="border-hairline bg-surface mt-6 rounded-[var(--r)] border p-5"
          >
            <div class="flex flex-col gap-4 sm:flex-row sm:items-end sm:gap-6">
              <div class="flex-1">
                <label for="q" class="text-ink-2 block text-sm">
                  Search
                </label>
                <input
                  id="q"
                  name="q"
                  type="search"
                  value={query.search}
                  placeholder="Search name or brand"
                  class="border-hairline bg-surface text-ink mt-1 w-full rounded-[var(--r-sm)] border px-3 py-2 text-sm"
                />
              </div>

              {/* A fieldset with an sr-only legend rather than no grouping at all: the
                  three boxes are one control ("which statuses am I looking at"), and a
                  screen reader needs that said once rather than inferred from three
                  adjacent labels. The legend is visually hidden because the bar's whole
                  point is to be lighter than what it replaced, and "Owned / Wishlist /
                  Retired" beside a search field is self-describing on sight. */}
              <fieldset class="sm:pb-2">
                <legend class="sr-only">Status</legend>
                <div class="flex flex-wrap items-center gap-x-5 gap-y-2">
                  {GEAR_STATUSES.map((status) => (
                    <label class="text-ink flex items-center gap-2 text-sm">
                      <input
                        type="checkbox"
                        name="status"
                        value={status}
                        checked={checkedStatuses.includes(status)}
                        class="accent-blue"
                      />
                      {formatGearStatus(status)}
                    </label>
                  ))}
                </div>
                {/* The WCAG 3.2.2 advisory. Rendered unconditionally rather than only
                    when scripting is on, because the server cannot know that — and the
                    sentence stays true either way: with the script off, the Apply button
                    is present and it is that button which updates the list. */}
                <p class="text-ink-3 mt-1.5 text-xs">Changing a status updates the list.</p>
              </fieldset>
            </div>

            <input type="hidden" name="sort" value={query.sort} />
            <input type="hidden" name="dir" value={query.direction} />

            {/* Category, brand and the weight range: honoured by the query layer, with
                no control on this page since PK-62. Re-emitted so that submitting this
                form preserves them exactly as the sort headers and the pager already do,
                instead of being the one path that silently discards them. The notice
                below is what stops that from being an undisclosed filter. */}
            {unsurfacedFilters.map(([name, value]) => (
              <input type="hidden" name={name} value={value} />
            ))}

            {/* ALWAYS RENDERED, AND REMOVED BY THE SCRIPT BELOW ONCE IT HAS ACTUALLY
                WIRED THE CHECKBOXES UP. This started as a <noscript> block, which was
                wrong in a way worth recording so it does not come back: <noscript> keys
                on SCRIPTING BEING ENABLED, not on this page's script having run. Those
                are different conditions, and every way they diverge left all three
                checkboxes as dead controls with no button and no feedback — a blocked or
                404'd bundle after a deploy, a Content-Security-Policy that refuses the
                script, an extension, or simply an exception thrown earlier in the same
                bundle. Rendering the button unconditionally and deleting it only on the
                success path inverts that: the worst case is now one redundant button,
                not a filter bar that silently does nothing. */}
            <button
              type="submit"
              id="gear-filters-apply"
              class="border-blue-deep text-blue-deep hover:bg-blue-tint mt-4 rounded-[var(--r-sm)] border px-4 py-2 text-sm font-medium transition-colors"
            >
              Apply
            </button>

            {/* THE ONLY DISCLOSURE, AND THE ONLY ESCAPE, for a filter with no control.
                Without this, a visitor arriving on a bookmarked `?category=Shelter` — a
                URL PK-4 shipped and this ticket removed the UI for — sees a closet
                missing most of its gear with nothing on the page saying why, and the
                "Clear filters" link in the no-results state never renders because the
                filter DID match something. Deliberately not a reconstruction of the old
                filter panel: it says the closet is filtered and offers one link that
                removes every such filter, which is the whole of what a visitor can
                usefully do about a control that no longer exists. */}
            {closetIsSilentlyFiltered && (
              <p role="status" class="text-ink-2 mt-4 text-sm">
                This closet is filtered by settings this page no longer shows.{' '}
                <a href={GEAR_PATH} class="text-blue-deep hover:text-blue-ink underline">
                  Clear filters
                </a>
              </p>
            )}
          </form>

          {items.length === 0 ? (
            <div class="border-hairline bg-surface mt-6 rounded-[var(--r)] border px-6 py-12 text-center">
              <p class="text-ink-2">No items match these filters.</p>
              <a
                href={GEAR_PATH}
                class="text-blue-deep hover:text-blue-ink mt-2 inline-block text-sm underline"
              >
                Clear filters
              </a>
            </div>
          ) : (
            <>
              <form method="POST" class="mt-6">
                <div class="border-hairline bg-surface overflow-x-auto rounded-[var(--r)] border">
                  <table class="w-full text-left text-sm">
                    <caption class="sr-only">Your gear closet</caption>
                    <thead>
                      <tr class="border-hairline text-ink-2 border-b">
                        <th scope="col" class="px-3 py-2">
                          <input
                            type="checkbox"
                            id="select-all"
                            aria-label="Select all items on this page"
                            class="accent-blue"
                          />
                        </th>
                        {GEAR_LIST_COLUMNS.map(({ key, label }) => (
                          <th
                            scope="col"
                            aria-sort={key === null ? undefined : sortAriaSort(key)}
                            class="px-3 py-2 font-medium"
                          >
                            {key === null ? (
                              label
                            ) : (
                              <a href={sortHref(key)} class="hover:text-ink text-ink-2">
                                {label}
                                {sortIndicator(key)}
                              </a>
                            )}
                          </th>
                        ))}
                        <th scope="col" class="px-3 py-2 font-medium">
                          <span class="sr-only">Photo</span>
                        </th>
                      </tr>
                    </thead>
                    <tbody>
                      {items.map((item) => (
                        <tr class="border-hairline hover:bg-sunk border-b last:border-b-0">
                          <td class="px-3 py-2">
                            <input
                              type="checkbox"
                              name={BULK_FORM_FIELD.id}
                              value={item.id}
                              aria-label={`Select ${item.name}`}
                              class="accent-blue"
                            />
                          </td>
                          <td class="px-3 py-2">
                            {/* THE RAGGED LEFT EDGE HERE IS DELIBERATE. `gap-1.5`
                                applies BETWEEN children, so an owned row — which
                                renders no icon at all — has its name start flush at the
                                cell's padding while wishlist and retired rows are
                                indented by the glyph. PK-62 accepts that and explicitly
                                forbids evening it up with a spacer or a placeholder
                                glyph; see GearStatusIcon.astro for why owned is the
                                unmarked default. */}
                            <span class="flex items-center gap-1.5">
                              <GearStatusIcon status={item.status} />
                              {/* THE ONLY PLACE AN ACTIVE ROW'S MALFORMED STATUS STILL
                                  SURFACES. Removing the Status column took away the one
                                  cell that rendered `item.status` as text, and
                                  `gearStatusMarker` draws nothing for a value it does
                                  not recognise — identical to `owned`. The trash page
                                  still renders a status verbatim, but it only ever shows
                                  SOFT-DELETED rows, so without this an out-of-constraint
                                  status would be invisible everywhere an active item
                                  appears. sr-only costs no layout, so the deliberately
                                  ragged left edge is untouched; nothing renders here at
                                  all for the three real statuses. */}
                              {!isGearStatus(item.status) && (
                                <span class="sr-only">{formatGearStatus(item.status)}</span>
                              )}
                              <a
                                href={gearItemPath(item.id)}
                                class="text-blue-deep hover:text-blue-ink underline"
                              >
                                {item.name}
                              </a>
                            </span>
                          </td>
                          <td class="px-3 py-2">{item.brand ?? '—'}</td>
                          <td class="px-3 py-2">{item.category ?? '—'}</td>
                          <td class="numeric px-3 py-2">{item.quantity}</td>
                          <td class="numeric px-3 py-2">
                            {item.weight} {item.weight_unit}
                          </td>
                          <td class="numeric px-3 py-2">
                            {formatGearPrice(item.price, item.currency)}
                          </td>
                          <td class="numeric px-3 py-2">
                            {formatGearAcquiredOn(item.acquired_on)}
                          </td>
                          <td class="px-3 py-2">
                            {item.photo_path ? (
                              <span
                                class="border-hairline bg-sunk text-ink-3 inline-flex h-8 w-8 items-center justify-center rounded-[var(--r-sm)] border text-[10px] font-medium"
                                aria-hidden="true"
                              >
                                IMG
                              </span>
                            ) : null}
                            <span class="sr-only">
                              {item.photo_path ? 'Has a photo' : 'No photo'}
                            </span>
                          </td>
                        </tr>
                      ))}
                    </tbody>
                  </table>
                </div>

                <div class="mt-4 flex flex-wrap items-center gap-3">
                  <input
                    id="bulk-category"
                    name={BULK_FORM_FIELD.category}
                    type="text"
                    placeholder="New category"
                    aria-label="New category for selected items"
                    class="border-hairline bg-surface text-ink rounded-[var(--r-sm)] border px-2 py-1.5 text-sm"
                  />
                  <button
                    type="submit"
                    name={BULK_FORM_FIELD.intent}
                    value={BULK_INTENT.setCategory}
                    class="border-hairline bg-surface text-ink-2 hover:text-ink hover:bg-sunk rounded-[var(--r-sm)] border px-3 py-1.5 text-sm font-medium transition-colors"
                  >
                    Set category
                  </button>

                  <select
                    id="bulk-status"
                    name={BULK_FORM_FIELD.status}
                    aria-label="New status for selected items"
                    class="border-hairline bg-surface text-ink rounded-[var(--r-sm)] border px-2 py-1.5 text-sm"
                  >
                    {GEAR_STATUSES.map((status) => (
                      <option value={status}>{formatGearStatus(status)}</option>
                    ))}
                  </select>
                  <button
                    type="submit"
                    name={BULK_FORM_FIELD.intent}
                    value={BULK_INTENT.setStatus}
                    class="border-hairline bg-surface text-ink-2 hover:text-ink hover:bg-sunk rounded-[var(--r-sm)] border px-3 py-1.5 text-sm font-medium transition-colors"
                  >
                    Set status
                  </button>

                  <button
                    type="submit"
                    name={BULK_FORM_FIELD.intent}
                    value={BULK_INTENT.delete}
                    class="border-rust text-rust hover:bg-rust/10 rounded-[var(--r-sm)] border px-3 py-1.5 text-sm font-medium transition-colors"
                  >
                    Delete selected
                  </button>
                </div>
              </form>

              <nav aria-label="Pagination" class="mt-4 flex items-center justify-between gap-4">
                <p class="text-ink-2 text-sm">
                  Showing {rangeStart}–{rangeEnd} of {totalCount}
                </p>
                <div class="flex gap-2">
                  {page > 1 && (
                    <a
                      href={pageHref(page - 1)}
                      class="border-hairline bg-surface text-ink-2 hover:text-ink hover:bg-sunk rounded-[var(--r-sm)] border px-3 py-1.5 text-sm transition-colors"
                    >
                      Previous
                    </a>
                  )}
                  {page < totalPages && (
                    <a
                      href={pageHref(page + 1)}
                      class="border-hairline bg-surface text-ink-2 hover:text-ink hover:bg-sunk rounded-[var(--r-sm)] border px-3 py-1.5 text-sm transition-colors"
                    >
                      Next
                    </a>
                  )}
                </div>
              </nav>
            </>
          )}
        </>
      )
    }
  </main>
</Layout>

{
  /* THE STATUS FILTER'S OWN SCRIPT, is:inline and deliberately NOT in the bundled module
    below. Two properties depend on both of those choices:

      1. An inline script cannot fail to load. The failure this design replaces was
         exactly "scripting is enabled but the module never arrived" — a hashed bundle
         404ing after a deploy, a CSP or extension refusing it, or an exception thrown
         earlier in the same bundle. <noscript> cannot see any of those, which is why the
         Apply button is a real button removed here rather than <noscript> content.
      2. It runs during parsing rather than after it, so the Apply button is gone before
         first paint instead of appearing and then vanishing. It sits at the FOOT of the
         document, after the form it operates on has been parsed — an inline script is
         synchronous, so "later in the document" is all the guarantee it needs.

    The removal happens FIRST, so anything that throws afterwards leaves the button in
    place and the form still usable. requestSubmit() is preferred over submit(), which
    skips both the submit event and constraint validation, but it is absent in Safari
    below 16 — where calling it unguarded would throw inside the change handler and
    produce the very dead control this exists to prevent. */
}
<script is:inline>
  (function () {
    const form = document.getElementById('gear-filters');
    if (!form) return;
    const apply = document.getElementById('gear-filters-apply');
    if (apply) apply.remove();
    const submit = function () {
      if (typeof form.requestSubmit === 'function') form.requestSubmit();
      else form.submit();
    };
    form.querySelectorAll('input[type="checkbox"][name="status"]').forEach(function (box) {
      box.addEventListener('change', submit);
    });
  })();
</script>

<script>
  // Progressive enhancement only: every bulk action is a real form submission and
  // works with this script never running. All this does is let a visitor tick one box
  // instead of every row's own checkbox individually.
  const selectAll = document.getElementById('select-all');
  if (selectAll instanceof HTMLInputElement) {
    selectAll.addEventListener('change', () => {
      const checked = selectAll.checked;
      document.querySelectorAll('input[type="checkbox"][name="id"]').forEach((box) => {
        if (box instanceof HTMLInputElement) box.checked = checked;
      });
    });
  }

  // Progressive enhancement only, again (PK-62): ticking a status re-runs the search
  // immediately instead of waiting for a button nobody wants back. With this script
  // never running, the <noscript> Apply button in the same form does the identical
  // thing — that button is the no-JS path, this is the JS one, and they are never both
  // present, so there is no state where a tick can be applied twice.
  //
  // requestSubmit() rather than submit(): submit() bypasses the submit event and
  // constraint validation entirely, which is the wrong default even for a form that has
  // neither today. The instanceof guard covers the closet's own empty state, where this
  // form is not rendered at all and getElementById answers null.
  const filters = document.getElementById('gear-filters');
  if (filters instanceof HTMLFormElement) {
    filters.querySelectorAll('input[type="checkbox"][name="status"]').forEach((box) => {
      box.addEventListener('change', () => filters.requestSubmit());
    });
  }
</script>
