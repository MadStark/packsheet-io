---
// On-demand: this page requires a session, reads Astro.locals.user, inserts into
// gear_items on POST and redirects — none of which a prerendered file can do. See
// src/pages/gear/new.astro, whose shape this page follows, and src/middleware.ts for why
// GEAR_PATH carries the no-store rule.
export const prerender = false;

import Layout from '../../layouts/Layout.astro';
import GearNav from '../../components/GearNav.astro';
import { createAuthClient } from '../../lib/auth';
import { SIGN_IN_PATH } from '../../lib/auth-routes';
import { GEAR_IMPORTED_PARAM, GEAR_PATH } from '../../lib/gear/routes';
import {
  IMPORT_FORM_FIELD,
  IMPORT_INTENT,
  itemCount,
  problemHeading,
  readImportSubmission,
  readyHeading,
} from '../../lib/gear/import-form';
import {
  MAX_IMPORT_ITEMS,
  gearImportIsClean,
  gearImportProblemCount,
  gearImportRows,
  importableGearItems,
  parseGearItemsFile,
  type GearImportReport,
} from '../../lib/gear/json-import';
import { importGearItems } from '../../lib/gear/mutations';
// The preview renders the STATUS a row will be saved with, and a visitor reads labels
// rather than column values — see GEAR_STATUS_LABELS' own comment.
import { GEAR_STATUS_LABELS } from '../../lib/gear/fields';

// src/middleware.ts has already resolved this with a verified getUser() call. A null user
// redirects to sign-in with `next` set back to this URL, exactly as the other gear pages
// do, so signing in returns here.
const user = Astro.locals.user;
if (!user) {
  const next = `${Astro.url.pathname}${Astro.url.search}`;
  return Astro.redirect(`${SIGN_IN_PATH}?next=${encodeURIComponent(next)}`);
}

// CSRF: same protection as every other page that posts — Astro's on-demand origin check
// (security.checkOrigin, set explicitly in astro.config.mjs) plus the session cookie's
// sameSite: 'lax'.
const client = createAuthClient(Astro.cookies, Astro.request);

// Never render a raw PostgREST/Supabase error string — mirrors src/lib/auth/index.ts and
// src/lib/gear/form.ts's own "NEVER A RAW POSTGRES OR POSTGREST STRING" rule. This one
// deliberately promises nothing about whether the write landed, the way
// GEAR_DELETE_FAILED_MESSAGE does and for the same reason: an INSERT that commits and
// then loses its response arrives in this branch with the rows already there, so "please
// try again" would be an invitation to import everything twice.
const GENERIC_WRITE_ERROR =
  'We could not confirm whether that import went through. Check your gear closet before trying again.';

let submissionError: string | null = null;
let report: GearImportReport | null = null;
/** The exact text the current preview was built from, re-posted by the confirm step. See
 *  IMPORT_FORM_FIELD.text's own comment for why the bytes travel and the verdict does
 *  not. */
let submittedText = '';
/** What to put back in the paste box. Set only when the text CAME from the paste box —
 *  see the textarea's own comment for why a file's contents are not echoed into it. */
let pastedText = '';

// ---------------------------------------------------------------------------
// POST: preview, then import.
//
// Method discipline: only POST does anything. A PUT, PATCH or DELETE to this path
// RENDERS THE PAGE rather than being refused — a `.astro` page is not an endpoint, so
// there is no handler map for a method to be absent from, and the 405 that an `.ts` route
// gives you for an unexported method has no equivalent here. (Sibling gear pages carry a
// comment claiming the 405; it is wrong there too, verified against `astro dev`, and
// correcting them is not this change's business.) It is harmless because the frontmatter
// below acts on `=== 'POST'` alone, so every other method falls through to a plain render
// and changes nothing.
//
// The one branch that WRITES redirects with 303, so a refresh cannot resubmit it. The
// preview branch deliberately does NOT redirect: it has written nothing to redirect away
// from, and there is nowhere to carry a whole file through a redirect anyway.
//
// THE TWO STEPS ARE THE SAME GATE THE BULK DELETE USES, pointed the other way. There, the
// first submission reveals what is about to be destroyed; here it reveals what is about
// to be created, per row, with the reasons any of it would be refused. Both exist because
// the action underneath is one a visitor cannot inspect beforehand — a selection of ids
// they cannot see the contents of, a file they may not have written.
// ---------------------------------------------------------------------------
if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const submission = await readImportSubmission(form);

  if (!submission.ok) {
    submissionError = submission.error;
  } else {
    submittedText = submission.text;
    // Only echoed back for a paste — see the textarea's own comment.
    if (submission.source === 'text') pastedText = submission.text;
    // RE-PARSED AND RE-VALIDATED ON BOTH STEPS, from the same bytes, by the same
    // function. The confirm step does not trust the preview's verdict, or carry a count,
    // or carry the parsed items — it carries the FILE and reaches the same conclusion
    // again. There is no state to desynchronise, because there is no state.
    //
    // WHAT THAT DOES AND DOES NOT GUARANTEE, stated precisely because the loose version of
    // this claim is wrong. It guarantees NOTHING INVALID IS EVER WRITTEN: whatever text
    // arrives, it goes through the same parser and the same validator, so there is no
    // route by which a "confirm" writes something the preview would have refused. It does
    // NOT guarantee that what is written is what was previewed — editing the hidden field,
    // or POSTing `intent=import-confirm` with arbitrary text, imports content no preview
    // ever displayed. That is not a hole worth closing: the only thing a visitor can do
    // that way is import their own valid gear into their own closet, which is what the
    // button does anyway. The property worth having is the first one.
    report = parseGearItemsFile(submission.text);

    if (submission.intent === IMPORT_INTENT.confirm) {
      const items = importableGearItems(report);
      if (items === null) {
        // The file stopped being clean between the two steps — which in practice means it
        // was never clean and the confirm button was reached by other means, since the
        // preview only offers it for a clean file. Falling through to the render below
        // shows the same per-row reasons the preview would have; there is nothing to add.
        submissionError = null;
      } else {
        const { error, count } = await importGearItems(client, user.id, items);
        if (error) {
          submissionError = GENERIC_WRITE_ERROR;
        } else {
          // THE COUNT IS CARRIED, AND IT IS THE WRITE'S OWN COUNT (PK-65 review, F7).
          // `deleteGearItems` discards its count on the argument that "the item's absence
          // from the list IS the feedback" — which does not transfer here. The closet is
          // name-sorted and paged at 50, so 200 newly-imported items can be entirely
          // invisible on the page the visitor lands on, and an import that silently did
          // nothing looks exactly like one that worked. `count` comes off the insert's own
          // `.select('id')`, never off `items.length`, so the number the banner shows is
          // the number of rows the database actually returned.
          //
          // In the query string rather than a session flash because this project has no
          // session store to flash through, and a number is not sensitive. The closet
          // treats it as a display-only hint and re-derives nothing from it.
          //
          // Unfiltered: any filter carried from wherever the visitor started could hide
          // every imported row. 303 so a refresh cannot import the file a second time.
          return Astro.redirect(`${GEAR_PATH}?${GEAR_IMPORTED_PARAM}=${count}`, 303);
        }
      }
    }
  }
}

const previewRows = report === null ? [] : gearImportRows(report);
const problemCount = report === null ? 0 : gearImportProblemCount(report);
const isClean = report !== null && gearImportIsClean(report);
---

<Layout
  title="Import gear — Packsheet"
  description="Import gear items into your Packsheet closet from a JSON or JSONL file."
>
  {
    /* PK-64 (Notebook Paper). A form and a list are two parts of the document (DESIGN.md
       §2.3), so this is two sheets, not one: the first always carries the title and the
       choose-a-file / paste-JSON form, and the second — only once a file has produced rows
       — carries the preview ledger and the confirm button. Both error notes are siblings
       ABOVE the sheets, never inside one (§2.5: a note may only lie directly on the paper).
       See src/pages/gear/new.astro for the one-sheet-with-a-form precedent this borrows,
       and src/pages/gear/index.astro for the ledger this borrows. */
  }
  <GearNav />
  <main class="paper-col flex flex-col gap-[30px] py-[30px]">
    {
      submissionError && (
        <div class="note note-danger" role="alert">
          <p>{submissionError}</p>
        </div>
      )
    }

    {
      report?.fileError && (
        <div class="note note-danger" role="alert">
          <p>{report.fileError}</p>
        </div>
      )
    }

    <div class="sheet">
      <div class="sheet-body">
        <p class="eyebrow">Gear</p>
        <h1 class="page-title mt-2">Import gear</h1>
        <p class="aside mt-2">all at once</p>
        <p class="hint mt-2">
          Bring in gear from a Packsheet export, or from a JSON file you have written yourself.
          Nothing is added to your closet until you have seen what it would add.
        </p>
        <hr class="sheet-rule" />

        <section aria-labelledby="choose-heading">
          <h2 id="choose-heading" class="section-title">
            {report === null ? 'Choose a file' : 'Try another file'}
          </h2>

          <form method="POST" enctype="multipart/form-data" class="mt-4 space-y-6">
            <div>
              <label for="import-file" class="field-label"> Upload a file </label>
              <input
                id="import-file"
                type="file"
                name={IMPORT_FORM_FIELD.file}
                accept=".json,.jsonl,application/json,application/jsonl,text/plain"
                class="file-field mt-1"
              />
              <p class="field-hint">
                A Packsheet export, a JSON array of items, a single item, or JSONL with one item per
                line. Up to {MAX_IMPORT_ITEMS} items.
              </p>
            </div>

            <div>
              <label for="import-text" class="field-label"> Or paste it in </label>
              {
                /* PRE-FILLED WITH WHAT WAS PASTED, when this render followed a paste. A page
                   that says "fix the file and try again" while having just cleared the box the
                   visitor typed into is asking them to retype what it already has —
                   `src/lib/gear/form.ts` makes exactly this argument for the item form ("never
                   clear a form someone has just filled in") and it applies identically here.
                   Only for the paste path: a file input cannot be re-populated from the server,
                   so a submission that came from a file leaves this empty rather than dumping
                   the file's whole contents into a textarea the visitor never typed in. It is
                   the visitor's own data, so it takes the written face like every other value
                   they typed — `.field` gives it that. */
              }
              <textarea
                id="import-text"
                name={IMPORT_FORM_FIELD.text}
                rows="6"
                spellcheck="false"
                class="field mt-1 block w-full"
                placeholder={'{ "name": "Nemo Hornet 2P", "weight_grams": 907 }'}
                >{pastedText}</textarea
              >
            </div>

            <div class="flex items-center gap-3">
              <button
                type="submit"
                name={IMPORT_FORM_FIELD.intent}
                value={IMPORT_INTENT.preview}
                class="btn"
              >
                Preview
              </button>
              <a href={GEAR_PATH} class="text-ink-2 hover:text-ink text-sm">Cancel</a>
            </div>
          </form>
        </section>
      </div>
    </div>

    {
      /* THE PREVIEW. Rendered whenever a file parsed into rows at all, clean or not, so a
         visitor sees every problem in one pass rather than discovering them one submission
         at a time — the same reasoning parseGearFormValues gives for validating all
         thirteen fields rather than stopping at the first. */
    }
    {
      previewRows.length > 0 && (
        <div class="sheet">
          <div class="sheet-body">
            <section aria-labelledby="preview-heading">
              <h2 id="preview-heading" class="section-title">
                {isClean
                  ? readyHeading(previewRows.length)
                  : problemHeading(problemCount, previewRows.length)}
              </h2>
              <p class="hint mt-2">
                {isClean
                  ? 'This is exactly what will be added. Check it, then import.'
                  : 'Nothing is imported while any item has a problem. Fix the file and try again.'}
              </p>

              <div class="mt-6 overflow-x-auto">
                <table class="ledger">
                  <caption class="sr-only">
                    Every item in the file, with the values that would be saved and any problems
                    found in it
                  </caption>
                  <thead>
                    <tr>
                      <th scope="col">#</th>
                      <th scope="col">Item</th>
                      <th scope="col" class="text-right">
                        Qty
                      </th>
                      <th scope="col" class="text-right">
                        Weight
                      </th>
                      <th scope="col" class="text-right">
                        Price
                      </th>
                      <th scope="col">Status</th>
                      <th scope="col">Problem</th>
                    </tr>
                  </thead>
                  <tbody>
                    {previewRows.map((row) => (
                      <tr class={row.ok ? 'align-top' : 'row-invalid align-top'}>
                        <td class="numeric text-ink-3">{row.position}</td>
                        <td class="text-ink">{row.label}</td>
                        {row.ok ? (
                          <>
                            {/* THE VALUES THAT WILL BE WRITTEN, not the ones in the file — read
                                off the parsed GearItemInput, so every default this format
                                applies is VISIBLE here rather than applied silently. An item
                                with no weight_grams key shows "0 g", an item with no status
                                shows "Owned", an item with no quantity shows "1". The page
                                promises "nothing is added until you have seen what it would
                                add"; a table of names and problems did not keep that promise,
                                and the defaults were exactly the part a visitor could not have
                                guessed. */}
                            <td class="numeric text-ink-2 text-right">{row.values.quantity}</td>
                            <td class="numeric text-ink-2 text-right">
                              {row.values.weight_grams} g
                            </td>
                            <td class="numeric text-ink-2 text-right">
                              {row.values.price === null
                                ? '—'
                                : `${row.values.price} ${row.values.currency}`}
                            </td>
                            <td>{GEAR_STATUS_LABELS[row.values.status]}</td>
                            <td>
                              {/* A word, not only a colour or an icon: WCAG AA does not accept
                                  colour as the sole carrier of meaning, and this column is the
                                  one a visitor reads down to decide whether to import. System
                                  voice: this is the app's own verdict on the row, not part of
                                  the item's record. */}
                              <span class="system text-ink-3">No problems</span>
                            </td>
                          </>
                        ) : (
                          <>
                            {/* A row that did not validate has no values to show — showing the
                                file's raw ones would be showing values that are not going to be
                                written, in the columns that promise they are. */}
                            <td class="text-ink-3" colspan="4">
                              —
                            </td>
                            {/* THIS CELL WRAPS, and it is the only cell on the site that does.
                                .ledger forbids wrapping because §3's 40px row is a hard
                                rhythm: one folded cell turns a row into 60px and puts every
                                hairline below it off the 20px cell. That rule is about DATA
                                columns — a weight, a price, a name — where the fix is to drop
                                a column rather than let one fold.

                                A validation message is prose, not data. It has no fixed
                                length, there is no column to drop, and the alternative to
                                wrapping is clipping the sentence that tells the visitor what
                                to fix. A problem row is already off the rhythm by design
                                anyway: it carries a wash and a bar precisely because it is an
                                exception. */}
                            <td class="whitespace-normal">
                              {/* The app is the one objecting, so this reuses .field-error's
                                  own treatment — system voice, rust — rather than inventing a
                                  second one for the same kind of message. */}
                              <ul class="field-error space-y-1">
                                {Object.entries(row.errors).map(([field, message]) => (
                                  <li>
                                    <span class="text-ink-3">{field}</span> {message}
                                  </li>
                                ))}
                              </ul>
                            </td>
                          </>
                        )}
                      </tr>
                    ))}
                  </tbody>
                </table>
              </div>

              {isClean && (
                <form method="POST" class="mt-6">
                  {/* The bytes the preview above was built from, re-posted. The server parses
                      and validates them again from scratch — see the POST branch's own comment
                      on why nothing but the file travels. */}
                  <input type="hidden" name={IMPORT_FORM_FIELD.text} value={submittedText} />
                  <button
                    type="submit"
                    name={IMPORT_FORM_FIELD.intent}
                    value={IMPORT_INTENT.confirm}
                    class="btn btn-primary"
                  >
                    Import {itemCount(previewRows.length)}
                  </button>
                </form>
              )}
            </section>
          </div>
        </div>
      )
    }
  </main>
</Layout>
