---
// On-demand: this page requires a session, reads Astro.locals.user, and both updates
// and deletes gear_items on POST — none of which a prerendered file can do. See
// src/middleware.ts for why GEAR_PATH carries the no-store rule the same way /account
// does, and src/pages/gear/index.astro for the page this one shares its shape with.
export const prerender = false;

import Layout from '../../layouts/Layout.astro';
import GearNav from '../../components/GearNav.astro';
import GearItemForm from '../../components/GearItemForm.astro';
import { createAuthClient } from '../../lib/auth';
import { readWeightSystem } from '../../lib/profile';
import { SIGN_IN_PATH, NEXT_PARAM } from '../../lib/auth-routes';
import { GEAR_PATH, gearItemPath } from '../../lib/gear/routes';
import { loadGearItem } from '../../lib/gear/query';
import {
  gearItemToFormValues,
  parseGearItemForm,
  rawGearFormValues,
  type GearFormValues,
  type GearItemRow,
} from '../../lib/gear/form';
// PK-63 needs the options query here too, to back the Category input's datalist on the
// detail page the same way new.astro does.
import { extractGearOptions, loadGearOptions } from '../../lib/gear/options';
// The delete path is PK-60's, not PK-63's: `softDeleteGearItem`, `makeUndoToken` and the
// UNDO_* params no longer exist, because a delete is now final and there is no trash to
// undo it from.
import { deleteGearItems, updateGearItem } from '../../lib/gear/mutations';
import {
  BULK_FORM_FIELD,
  GEAR_DELETE_CONFIRMATION_VALUE,
  GEAR_DELETE_FAILED_MESSAGE,
  confirmsGearDeletion,
} from '../../lib/gear/bulk';
import {
  gearFormHrefReturningTo,
  gearReturnPathFromFormOrNull,
  gearReturnPathOrNull,
} from '../../lib/gear/return-path';

// src/middleware.ts has already resolved this with a verified getUser() call; reading
// it here rather than calling getUser() again is the whole point of doing it once in
// middleware. A null user redirects to sign-in with `next` set back to this exact URL,
// so signing in returns here rather than dropping the visitor on the closet's default.
const user = Astro.locals.user;
if (!user) {
  const next = `${Astro.url.pathname}${Astro.url.search}`;
  return Astro.redirect(`${SIGN_IN_PATH}?next=${encodeURIComponent(next)}`);
}

const id = Astro.params.id;
if (typeof id !== 'string' || id === '') {
  return new Response('Not found', { status: 404 });
}

// CSRF: same protection as sign-in.astro and src/pages/gear/index.astro — Astro's
// on-demand origin check (security.checkOrigin, set explicitly in astro.config.mjs)
// plus the session cookie's sameSite: 'lax'. No separate CSRF token is needed on top of
// that pair for the same reason it isn't on those pages.
const client = createAuthClient(Astro.cookies, Astro.request);

// Never render a raw PostgREST/Supabase error string — mirrors src/lib/auth/index.ts
// and src/lib/gear/form.ts's own "NEVER A RAW POSTGRES OR POSTGREST STRING" rule.
// This one covers the edit path and the unrecognised-intent path only. A failed DELETE
// reports GEAR_DELETE_FAILED_MESSAGE (src/lib/gear/bulk.ts) instead: this sentence says
// "updating", which a delete is not, and "please try again", which promises the write
// did not happen — see that constant's own comment for the case where that is false.
const GENERIC_WRITE_ERROR = 'Something went wrong updating this item. Please try again.';

// The category suggestions offered under the Category field's <datalist> — see
// GearItemForm's own comment on that field for why a datalist rather than a <select>.
// A query error here degrades to an empty suggestion list rather than failing the whole
// page: a missing suggestion list costs a visitor nothing but the convenience of
// autocomplete, and refusing to render the edit form over that would turn a minor
// inconvenience into a hard block on editing an item the visitor already owns.
const { data: optionRows, error: optionsError } = await loadGearOptions(client, user.id);

// PK-67: needed on both paths for the same reason new.astro states — the unit the Weight
// field is typed in must be the unit the parser converts from, and the edit page renders
// the form on the GET path as well as after a failed POST.
const { system: weightSystem } = await readWeightSystem(client, user.id);
const categories = optionsError ? [] : extractGearOptions(optionRows ?? []).categories;

// This page answers two different POSTs from two different forms — save the edit, or
// delete the item — told apart by this hidden `intent` field the same way
// src/lib/gear/bulk.ts's BULK_FORM_FIELD.intent tells the closet list's several bulk
// forms apart. Not exported from src/lib/gear/ because there is no decision buried in
// naming two strings — see GearItemForm's own "NO DECISION-MAKING LIVES HERE" for the
// line this page stays on the right side of.
//
// The delete CONFIRMATION field is a different matter and is no longer named here
// (PK-60 review, F1). This page used to declare its own private `DELETE_CONFIRM_FIELD =
// 'confirm'` and compare it inline — a second, independent copy of the guard in front
// of the only irreversible write in this product, kept in step with the closet list's
// copy by nothing, in the directory vitest.config.ts:64 excludes from the test run.
// Both pages now read BULK_FORM_FIELD.confirm through confirmsGearDeletion, which has
// a test.
const GEAR_ITEM_INTENT = { edit: 'edit-item', delete: 'delete-item' } as const;

let formErrors: Readonly<Record<string, string>> = {};
let formValuesOverride: GearFormValues | null = null;
let writeError: string | null = null;
let pendingDelete = false;

// The return-to-caller destination (PK-63) — "saving returns you where you were", and
// Cancel agrees with it: both this GET render's cancelHref/next and a POSTed edit's
// validation-failure re-render use the same value. `null` means "nothing usable was
// carried" — no `?next=` on this GET, or a refused/absent value on a POST — which the
// successful-edit fork below has to tell apart from a real carried destination; see
// that fork's own comment. Computed up front from the query string, then overwritten
// from the form's own carried value once a POST body is available — see
// gearReturnPathFromFormOrNull's own comment for why the form field takes precedence
// over the query string that produced this same page.
let returnPath: string | null = gearReturnPathOrNull(Astro.url.searchParams.get(NEXT_PARAM));

// ---------------------------------------------------------------------------
// POST: save an edit, or delete (with the same two-step reveal the closet list's own
// bulk delete uses — see src/pages/gear/index.astro's "Method discipline" comment,
// which applies here unchanged: every mutating branch redirects with 303, and the one
// branch that does not (an unconfirmed delete) has changed nothing yet.
// ---------------------------------------------------------------------------
if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  returnPath = gearReturnPathFromFormOrNull(form, Astro.url);
  const intent = form.get('intent');

  if (intent === GEAR_ITEM_INTENT.delete) {
    const confirmed = confirmsGearDeletion(form.get(BULK_FORM_FIELD.confirm));
    if (!confirmed) {
      pendingDelete = true;
    } else {
      // The same deleteGearItems the closet list's bulk delete calls, handed a
      // one-element array — there is deliberately no single-id variant, because a
      // delete of one row does nothing a delete of twelve does not (see that
      // function's own comment in src/lib/gear/mutations.ts, including what its BEFORE
      // DELETE trigger freezes into any pack still referencing this item). It adds an
      // explicit .eq('user_id', ...) alongside RLS (gear_items_delete_own) — see that
      // module's own comment for why the write side gets the same belt-and-braces the
      // read side (loadGearItem, below) needs for a different, load-bearing reason.
      // Its `count` is not read: there is no banner to report a figure into, so the
      // only thing this page needs from the write is whether it failed.
      const { error } = await deleteGearItems(client, user.id, [id]);

      if (error) {
        // Not GENERIC_WRITE_ERROR: this branch is also where a delete that COMMITTED and
        // then lost its response lands, so the message must not promise the item is
        // still here — see GEAR_DELETE_FAILED_MESSAGE's own comment. It points at the
        // closet rather than at this page on purpose: if the row did go, this URL is
        // about to start answering 404, and the list is what can actually say.
        writeError = GEAR_DELETE_FAILED_MESSAGE;
      } else {
        // Straight back to the closet, with nothing appended. The item's absence from
        // that list is the confirmation — a banner announcing a deletion the visitor
        // just asked for twice would say less than the empty space where the row was,
        // and every flash-message mechanism this page could grow for it (a query
        // param, a cookie, a session flash) is state that then has to be cleared, kept
        // off a shared/bookmarked URL, and stopped from reappearing on a refresh.
        return Astro.redirect(GEAR_PATH, 303);
      }
    }
  } else if (intent === GEAR_ITEM_INTENT.edit) {
    const result = parseGearItemForm(form, weightSystem);
    if (!result.ok) {
      formErrors = result.errors;
      formValuesOverride = result.values;
    } else {
      // updateGearItem (src/lib/gear/mutations.ts) scopes its own write with an
      // explicit .eq('user_id', ...) alongside RLS (gear_items_update_own), for the
      // reason that module's comment gives: a function whose contract is "edit THIS
      // visitor's row" enforces that itself rather than taking a policy's word for it.
      const { error } = await updateGearItem(client, user.id, id, result.values);

      if (error) {
        writeError = GENERIC_WRITE_ERROR;
        // The submission validated; the database write did not. Re-render with exactly
        // what the visitor typed — see rawGearFormValues's own comment for why this is
        // the right values to show back rather than reloading the pre-edit row.
        formValuesOverride = rawGearFormValues(form);
      } else {
        // PK-63: "saving returns you where you were" — but only when there IS a
        // "where you were" to return to. If a valid return target was carried on this
        // submission (via the hidden `next` field or the query string that rendered the
        // form), Cancel and Save now agree: both send the visitor back to the same
        // closet view. If NOT — this page was reached directly, with no `?next=`
        // anywhere, so `returnPath` is `null` — this keeps today's exact behaviour
        // instead: redirect to the item's own page with `?updated=1` and show "Saved."
        // there. That is a deliberate fork, not an oversight: bouncing a visitor who
        // has nowhere to go back to into the closet list would silently swallow the
        // "Saved." confirmation this page has always given a visitor who reached it
        // directly (a bookmark, a shared link, GearNav), trading a real feedback
        // message for a redirect nobody asked for.
        if (returnPath !== null) {
          return Astro.redirect(returnPath, 303);
        }
        return Astro.redirect(`${gearItemPath(id)}?updated=1`, 303);
      }
    }
  } else {
    // Neither recognised intent: a stale form from before a deploy, or a crafted
    // request. Reported the same way an unrecognised bulk intent is on the list page —
    // named, not silently ignored.
    writeError = GENERIC_WRITE_ERROR;
  }
}

// ---------------------------------------------------------------------------
// Load the item — for the GET render, and for every POST branch above that did not
// redirect (a validation failure, a write failure, or the delete confirmation reveal),
// since all three still need the row's own current data to render the page around.
//
// loadGearItem (src/lib/gear/query.ts) carries the load-bearing `.eq('user_id', ...)`
// — not belt-and-braces, see that function's own comment. gear_items carries TWO
// permissive SELECT policies: gear_items_select_own (owner only) and gear_items_
// select_via_public_pack, granted to anon AND authenticated so a shared pack link can
// render the gear behind it. Relying on RLS alone here would let this page render ANY
// visitor's gear item the moment it sits on someone's public pack — "your item"
// silently becoming a stranger's.
// ---------------------------------------------------------------------------
const { data: item, error: loadError } = await loadGearItem(client, user.id, id);

// A missing row (including one this page's own delete branch has just removed, if the
// visitor comes back to the URL), another visitor's row, and a malformed id (which
// PostgREST refuses with an error before RLS is even consulted) all collapse to the
// SAME response: a real 404, not a redirect and not a 200 that merely says "not found"
// in prose. None of the three is a distinction this page's visitor should be able to
// probe for — telling "belongs to someone else" apart from "never existed" is exactly
// the kind of leak a 404 for all three refuses to make.
if (loadError || item === null) {
  return new Response('Not found', { status: 404 });
}

const row: GearItemRow = item;
const values: GearFormValues = formValuesOverride ?? gearItemToFormValues(row, weightSystem);
const updated = Astro.url.searchParams.get('updated') === '1';
---

<Layout
  title={`${item.name} — Packsheet`}
  description={`Manage ${item.name} in your Packsheet gear closet.`}
>
  <GearNav />
  <main class="mx-auto max-w-2xl px-6 py-10">
    <h1 class="text-3xl">{item.name}</h1>

    {
      updated && (
        <p
          role="status"
          class="border-hairline bg-sunk text-ink mt-6 rounded-[var(--r-sm)] border px-4 py-3 text-sm"
        >
          Saved.
        </p>
      )
    }

    {
      writeError && (
        <p
          role="alert"
          class="border-rust/40 bg-rust/10 text-ink mt-6 rounded-[var(--r-sm)] border px-4 py-3 text-sm"
        >
          {writeError}
        </p>
      )
    }

    <div class="mt-6">
      <GearItemForm
        weightSystem={weightSystem}
        values={values}
        errors={formErrors}
        submitLabel="Save changes"
        cancelHref={returnPath ?? GEAR_PATH}
        intentField={{ name: 'intent', value: GEAR_ITEM_INTENT.edit }}
        categories={categories}
        next={returnPath ?? undefined}
      />
    </div>

    <div class="border-hairline mt-12 border-t pt-8">
      {
        pendingDelete ? (
          <div>
            <h2 class="text-rust text-lg">Confirm delete</h2>
            {/* The same two ideas the closet list's bulk confirmation carries after the
                question itself (src/pages/gear/index.astro), in the same order and
                narrowed to one named item: the irreversibility first, then the one thing
                a visitor might reasonably fear losing alongside it.
                gear_items_snapshot_before_delete
                (core_schema.sql) freezes this row's name, weight and price into every
                pack_items row still pointing at it, so a pack that lists this item
                keeps its line rather than losing it. No typed-word confirmation, for
                the reason that page's own comment gives. */}
            <p class="text-ink-2 mt-2 text-sm">
              Delete {item.name} permanently? This cannot be undone. If it appears on a saved pack,
              that pack keeps a frozen copy.
            </p>
            <form method="POST" class="mt-4 flex gap-3">
              <input type="hidden" name="intent" value={GEAR_ITEM_INTENT.delete} />
              {/* Field name and value both from src/lib/gear/bulk.ts, never spelled out
                  here: this hidden input is the WRITER of the same gate
                  confirmsGearDeletion READS, and the two must not be able to drift. */}
              <input
                type="hidden"
                name={BULK_FORM_FIELD.confirm}
                value={GEAR_DELETE_CONFIRMATION_VALUE}
              />
              <button
                type="submit"
                class="bg-rust text-paper rounded-[var(--r-sm)] px-4 py-2 text-sm font-medium transition-colors hover:brightness-95"
              >
                Delete permanently
              </button>
              {/* CARRIES `next` BACK TO ITSELF. Backing out of a delete must not cost
                  the visitor their return target: this link re-enters the same page, and
                  a bare `gearItemPath(id)` would drop the `?next=` the rest of the page
                  is careful to preserve. The failure that caused was silent and
                  outlived the interaction — filter the closet, open an item, click
                  Delete, change your mind, and from then on Save landed on `?updated=1`
                  and Cancel on a bare `/gear`, because the return target had been
                  dropped by a link that has nothing to do with either. */}
              <a
                href={
                  returnPath === null
                    ? gearItemPath(id)
                    : gearFormHrefReturningTo(gearItemPath(id), returnPath)
                }
                class="border-hairline text-ink-2 hover:text-ink rounded-[var(--r-sm)] border px-4 py-2 text-sm transition-colors"
              >
                Cancel
              </a>
            </form>
          </div>
        ) : (
          <div>
            <h2 class="text-lg">Delete</h2>
            <p class="text-ink-2 mt-2 text-sm">
              Deletes this item permanently. It cannot be restored.
            </p>
            <form method="POST" class="mt-4">
              <input type="hidden" name="intent" value={GEAR_ITEM_INTENT.delete} />
              <button
                type="submit"
                class="border-rust text-rust hover:bg-rust/10 rounded-[var(--r-sm)] border px-4 py-2 text-sm font-medium transition-colors"
              >
                Delete
              </button>
            </form>
          </div>
        )
      }
    </div>
  </main>
</Layout>
