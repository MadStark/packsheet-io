---
// On-demand for the same reason as sign-in.astro — this page reads a POST body and the
// call it makes writes cookies (the PKCE verifier the reset link will be exchanged
// against), neither of which a prerendered file can do. See src/middleware.ts for why
// that costs nothing on the anonymous read path.
export const prerender = false;

import Layout from '../layouts/Layout.astro';
import { PASSWORD_RESET_REQUESTED_MESSAGE, requestPasswordReset } from '../lib/auth';
import { SIGN_IN_PATH, SIGN_UP_PATH } from '../lib/auth-routes';

/**
 * "Forgot your password?" — the request half of the reset journey (PK-56). The other half
 * is src/pages/update-password.astro, which the emailed link reaches by way of
 * src/pages/auth/callback.ts.
 *
 * ---------------------------------------------------------------------------
 * THIS PAGE ANSWERS IDENTICALLY WHETHER OR NOT THE ADDRESS EXISTS
 * ---------------------------------------------------------------------------
 *
 * It is the only form on the site that accepts an email address from somebody who is not
 * signed in and then does something with it, which makes it the natural home for the
 * account-enumeration oracle this codebase has already closed twice — once at
 * BAD_CREDENTIALS_MESSAGE (sign-in) and once at SIGN_UP_UNAVAILABLE_MESSAGE (sign-up),
 * both in src/lib/auth/index.ts. Read those before changing anything below.
 *
 * There is exactly ONE rendered outcome for a POST, and it is not a decision this page
 * re-makes on every branch: `requestPasswordReset` returns `Promise<{ ok: true }>`, so
 * there is no failure arm to render, no error object to be tempted by, and nothing here
 * that a future edit could accidentally make conditional. See that function's own comment
 * for why the collapse happens there rather than here — the short version is that a
 * rate-limit code is reachable ONLY for an address that really got an email, so "too many
 * attempts just now", rendered honestly on this one page, publishes the accounts table one
 * guess at a time.
 *
 * The remaining way to leak from here would be to vary the page some OTHER way — a
 * different status code, a redirect on one path and a render on the other, a "we could not
 * find that" hint in the copy. The confirmation state below is therefore a single block
 * rendered from a single boolean, and PASSWORD_RESET_REQUESTED_MESSAGE is imported rather
 * than typed out so the one sentence that has to be true in both cases is pinned by a test
 * rather than by this comment.
 *
 * NOT CLOSED, and out of scope for this ticket rather than overlooked: response TIMING.
 * Sending mail takes longer than not sending it, so a determined attacker with a stopwatch
 * has a signal this page does not remove. Closing that means queueing the send behind the
 * response, which needs infrastructure this project does not have yet; it is a different
 * order of effort from a stranger reading an answer off the screen, which is what the
 * above closes.
 */
let requested = false;

// CSRF: same protection as sign-in.astro and sign-up.astro — Astro's on-demand origin
// check (security.checkOrigin, on by default and set explicitly in astro.config.mjs)
// rejects a cross-site submission before this code runs, and the session cookie's
// sameSite: 'lax' (src/lib/auth/index.ts) is not sent cross-site in the first place. No
// separate CSRF token is needed on top of that pair.
//
// Worth being explicit about what a forged POST here could achieve even so, since this
// route is reachable signed-out: at most it mails a reset link to an address the attacker
// typed. It cannot read the answer (the response goes to the visitor, and says the same
// thing regardless) and it cannot change anything — the link goes to the address's own
// inbox. The rate limits in supabase/config.toml are what bound the nuisance.
if (Astro.request.method === 'POST') {
  const email = String((await Astro.request.formData()).get('email') ?? '');
  await requestPasswordReset({ cookies: Astro.cookies, request: Astro.request, email });
  requested = true;
}
---

<Layout
  title="Reset your password — Packsheet"
  description="Ask for a link to choose a new Packsheet password."
>
  <main class="mx-auto flex min-h-svh max-w-sm flex-col justify-center px-6 py-16">
    <a href="/" class="text-ink-3 font-mono text-xs tracking-[0.18em] uppercase">Packsheet</a>
    <h1 class="mt-6 text-3xl">Reset your password</h1>

    {
      requested ? (
        <Fragment>
          <p class="text-ink-2 mt-6 text-sm">{PASSWORD_RESET_REQUESTED_MESSAGE}</p>
          <p class="text-ink-2 mt-8 text-sm">
            <a href={SIGN_IN_PATH} class="text-blue-deep hover:text-blue-ink underline">
              Back to sign in
            </a>
          </p>
        </Fragment>
      ) : (
        <Fragment>
          <p class="text-ink-2 mt-4 text-sm">
            Type the address you signed up with and we will send a link to choose a new password.
          </p>

          <form method="POST" class="mt-8 space-y-4">
            <div>
              <label for="email" class="text-ink-2 block text-sm">
                Email
              </label>
              <input
                id="email"
                name="email"
                type="email"
                autocomplete="email"
                required
                class="border-hairline bg-surface text-ink mt-1 w-full rounded-[var(--r-sm)] border px-3 py-2 text-sm"
              />
            </div>
            <button
              type="submit"
              class="border-blue-deep text-blue-deep hover:bg-blue-tint w-full rounded-[var(--r-sm)] border px-4 py-2 text-sm font-medium transition-colors"
            >
              Send reset link
            </button>
          </form>

          <p class="text-ink-2 mt-8 text-sm">
            Remembered it?{' '}
            <a href={SIGN_IN_PATH} class="text-blue-deep hover:text-blue-ink underline">
              Sign in
            </a>{' '}
            — or{' '}
            <a href={SIGN_UP_PATH} class="text-blue-deep hover:text-blue-ink underline">
              create an account
            </a>
            .
          </p>
        </Fragment>
      )
    }
  </main>
</Layout>
