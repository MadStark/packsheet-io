---
import Layout from '../layouts/Layout.astro';
import ThemeToggle from '../components/ThemeToggle.vue';

const title = 'Packsheet — a free, open gear tracker for hikers';
const description =
  'A free, open-source gear tracker and pack builder for hikers. Build your closet once, compose unlimited lists, and share a page reviewers actually want to read.';

// Sample rows exist to prove the token wiring renders: category colour, weight
// class colour, and tabular figures. They are not real data and go away in PS-7.
const sampleRows = [
  { name: 'Shelter', token: 'var(--c-shelter)', grams: 964 },
  { name: 'Sleep', token: 'var(--c-sleep)', grams: 712 },
  { name: 'Pack', token: 'var(--c-pack)', grams: 845 },
  { name: 'Cooking', token: 'var(--c-cooking)', grams: 268 },
];

const totalGrams = sampleRows.reduce((sum, row) => sum + row.grams, 0);
---

<Layout title={title} description={description}>
  <main class="mx-auto flex min-h-svh max-w-2xl flex-col justify-center px-6 py-16">
    <header class="flex items-baseline justify-between gap-4">
      <p class="text-ink-3 font-mono text-xs tracking-[0.18em] uppercase">Coming soon</p>
      <ThemeToggle client:load />
    </header>

    <h1 class="mt-8 text-4xl leading-[1.1] sm:text-5xl">Packsheet</h1>

    <p class="text-ink-2 mt-4 max-w-prose text-lg">
      A free, open gear tracker and pack builder for hikers. Build your closet once, compose
      unlimited lists from it, and share a page reviewers actually want to read.
    </p>

    <!-- Token proof. Categories carry their own colour; blue is reserved for base weight. -->
    <section
      class="border-hairline bg-surface mt-10 overflow-hidden rounded-[var(--r)] border"
      aria-label="Example pack breakdown"
    >
      <table class="w-full text-sm">
        <caption class="sr-only">
          An example pack breakdown showing category colours and tabular weights
        </caption>
        <tbody>
          {
            sampleRows.map((row) => (
              <tr class="border-hairline border-b last:border-0">
                <th scope="row" class="flex items-center gap-3 px-4 py-3 text-left font-normal">
                  <span
                    class="h-2.5 w-2.5 shrink-0 rounded-full"
                    style={`background:${row.token}`}
                    aria-hidden="true"
                  />
                  {row.name}
                </th>
                <td class="numeric text-ink-2 px-4 py-3 text-right">{row.grams} g</td>
              </tr>
            ))
          }
        </tbody>
        <tfoot>
          <tr class="bg-sunk">
            <th scope="row" class="text-ink px-4 py-3 text-left font-normal">Base weight</th>
            <!--
              --blue-deep rather than --blue/--w-base: on the --sunk footer ground,
              plain --blue is 4.11:1 in light mode, under the 4.5 AA floor. --blue-deep
              clears it in both themes (5.75 light / 7.75 dark) and reads as the same
              blue, so the "blue marks base weight" rule still holds.
            -->
            <td class="numeric px-4 py-3 text-right font-medium" style="color:var(--blue-deep)">
              {totalGrams} g
            </td>
          </tr>
        </tfoot>
      </table>
    </section>

    <ul class="text-ink-2 mt-8 space-y-2 text-sm">
      <li>Free forever. No paywall, no ads.</li>
      <li>Open source from the first commit.</li>
      <li>Your data is always exportable.</li>
    </ul>
  </main>
</Layout>
