---
// On-demand: this route answers differently depending on who is asking, which is the
// one thing a prerendered file cannot do. That is a deliberate downgrade from what `/`
// used to be — a static, edge-cached landing page — and src/lib/routes.ts's header sets
// out what it costs and what holds the bill down. The landing page itself did not lose
// that property; it moved to WELCOME_PATH and is prerendered exactly as this file was.
export const prerender = false;

// Path constants only — no auth SDK, so this route needs no AUTH_CONSUMERS entry in
// tests/anonymous-read-path.test.ts. It is the busiest route on the site and the one it
// would be most expensive to get wrong.
import { homeDestination, HOME_PATH } from '../lib/routes';

// src/middleware.ts has already resolved this for the request — with a verified
// getUser() call when the request carried a Supabase cookie, and with a plain `null` when
// it did not (see src/lib/session-cookie.ts, which is what keeps an anonymous visit to
// the front door off the auth server entirely). Reading `Astro.locals.user` here rather
// than asking again is the same rule every other route in this codebase follows.
//
// Coerced to a boolean at the boundary: `homeDestination` is pure over two states and
// deliberately knows nothing about Supabase's `User` type.
const destination = homeDestination(Astro.locals.user !== null);

// Belt to the braces around `homeDestination`'s "must never return HOME_PATH" contract.
// That contract is asserted directly for both arms in tests/home-routing.test.ts, but the
// failure it prevents is a redirect loop on the site's front door — a browser bouncing
// `/` → `/` until it refuses to continue, which presents as the site being down rather
// than as a routing bug. A thrown error here is a 500 on one route with a message naming
// the cause, which is strictly better than that, and it costs one comparison.
if (destination === HOME_PATH) {
  throw new Error(
    'homeDestination returned HOME_PATH, which would redirect `/` to itself — see src/lib/routes.ts.',
  );
}

// 302 and not 301. Where `/` sends somebody is a function of their session, so it is by
// definition not permanent, and a 301 is the one redirect browsers cache indefinitely and
// ignore the server on afterwards — a visitor who arrived signed out once would keep
// being sent to the landing page after signing in, with nothing server-side able to
// correct it. `Astro.redirect` defaults to 302; it is passed explicitly because the
// default being right is not the same as the choice having been made.
return Astro.redirect(destination, 302);
---
