---
import Layout from '../layouts/Layout.astro';
import ThemeToggle from '../components/ThemeToggle.vue';

const title = 'Packsheet — a free, open gear tracker for hikers';
const description =
  'A free, open-source gear tracker and pack builder for hikers. Build your closet once, compose unlimited lists, and share a page reviewers actually want to read.';

const repoUrl = 'https://github.com/MadStark/packsheet-io';
---

<Layout title={title} description={description}>
  <main class="mx-auto flex min-h-svh max-w-2xl flex-col justify-center px-6 py-16">
    <header class="flex items-baseline justify-between gap-4">
      <p class="text-ink-3 font-mono text-xs tracking-[0.18em] uppercase">Coming soon</p>
      <ThemeToggle client:load />
    </header>

    <h1 class="mt-8 text-4xl leading-[1.1] sm:text-5xl">Packsheet</h1>

    <p class="text-ink-2 mt-4 max-w-prose text-lg">
      A free, open gear tracker for hikers. Build a gear closet once, then compose it into a
      packsheet for each trip — the list you plan with, and the page you share.
    </p>

    <ul class="text-ink-2 mt-8 space-y-2 text-sm">
      <li>Free forever. No paywall, no ads.</li>
      <li>Open source from the first commit.</li>
      <li>Your data is always exportable.</li>
    </ul>

    <p class="mt-10 text-sm">
      <!--
        --blue-deep rather than the default link --blue: on the --paper page ground,
        plain --blue is 4.48:1, under the 4.5 AA floor. --blue-deep clears it (6.27:1)
        and still reads as the same blue, so "blue marks interactive" still holds.
      -->
      <a href={repoUrl} style="color:var(--blue-deep)">Source on GitHub</a>
    </p>
  </main>
</Layout>
