---
// On-demand for the same reason as sign-in.astro — see that file and
// src/middleware.ts for why this costs nothing on the anonymous read path.
export const prerender = false;

import Layout from '../layouts/Layout.astro';
import { getGoogleAuthorizationUrl, getUser, signUpWithPassword } from '../lib/auth';
import {
  AUTH_CALLBACK_PATH,
  googleAuthUnavailableMessage,
  nextFromForm,
  NEXT_PARAM,
  SIGN_IN_PATH,
  safeNextPath,
} from '../lib/auth-routes';

// Same handling as sign-in.astro, and for the same reason — see safeNextPath and
// nextFromForm in src/lib/auth-routes.ts. Seeded from the query string, re-read from the
// submitted form below, and never trusted in its raw form from either source.
let next = safeNextPath(Astro.url.searchParams.get(NEXT_PARAM));

const oauthFailed = Astro.url.searchParams.has('oauth_error');

let errorMessage: string | null = oauthFailed
  ? 'Something went wrong signing up with Google. Please try again, or use email and password below.'
  : null;

// Shown instead of redirecting when sign-up succeeded but did NOT itself produce a
// session — i.e. the Supabase project this build talks to has "Confirm email" on and the
// new account is genuinely waiting on a confirmation email before it can sign in. See the
// branch below for why that is checked with a second call rather than assumed either way,
// and why createAuthClient's per-request cookie overlay (src/lib/auth/index.ts) is what
// makes the check trustworthy.
//
// WHICH BRANCH RUNS DEPENDS ON THE ENVIRONMENT, and since PK-56 the two disagree. Both
// hosted projects confirm email (enable_confirmations = true under [remotes.staging.
// auth.email] and [remotes.production.auth.email] in supabase/config.toml), so this is
// the ordinary path there. The local stack keeps the file's top-level
// enable_confirmations = false, so `npm run dev` and `npm test` never reach this branch
// at all — signUpWithPassword's own cookies already carry a real session and this page
// redirects straight past it. Asking getUser() rather than assuming either setting is
// what lets one page be correct in both.
let awaitingConfirmation = false;

// CSRF: same protection as sign-in.astro — Astro's on-demand origin check
// (security.checkOrigin, set explicitly in astro.config.mjs) plus the session
// cookie's sameSite: 'lax'. See the comment there for why no separate token is
// needed on top of that pair.
if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  // Re-read from the submitted form, falling back to the query string. The hidden field
  // below is the carrier; the query string is the safety net for a form that lost it.
  // See nextFromForm in src/lib/auth-routes.ts for why the field is read rather than
  // deleted, and note that both sources go through safeNextPath — a hidden field is not
  // a trusted one.
  next = nextFromForm(form, Astro.url);
  const intent = form.get('intent');

  if (intent === 'google') {
    const callbackUrl = new URL(AUTH_CALLBACK_PATH, Astro.url.origin);
    callbackUrl.searchParams.set(NEXT_PARAM, next);
    const result = await getGoogleAuthorizationUrl({
      cookies: Astro.cookies,
      request: Astro.request,
      redirectTo: callbackUrl.toString(),
    });
    if (result.ok) {
      return Astro.redirect(result.url);
    }
    // Google is configured and enabled on both hosted Supabase projects, so this is
    // the exceptional path, not the everyday one — Supabase unreachable, the provider
    // disabled again in the dashboard, a malformed redirect. Never render
    // result.error, which is Supabase's own text; say what a visitor can do about it.
    errorMessage = googleAuthUnavailableMessage('up');
  } else {
    const email = String(form.get('email') ?? '');
    const password = String(form.get('password') ?? '');
    const result = await signUpWithPassword({
      cookies: Astro.cookies,
      request: Astro.request,
      email,
      password,
    });
    if (result.ok) {
      // signUpWithPassword's own AuthResult only ever carries `{ user }`, and
      // Supabase hands back a non-null user for BOTH outcomes of a project's
      // "Confirm email" setting — the only way to tell "a session now exists" from
      // "a user row exists but is waiting on a confirmation email" is to ask again,
      // which getUser() does by checking the cookies createAuthClient's setAll just
      // wrote a moment ago, IN THIS SAME REQUEST. That read-after-write is only
      // trustworthy because createAuthClient overlays cookies written earlier in the
      // request on top of the raw inbound header (see that function's own comment in
      // src/lib/auth/index.ts) — without it this call would re-read the request's
      // ORIGINAL Cookie header, see none of what signUpWithPassword just wrote, and
      // report no session even when one genuinely exists (enable_confirmations =
      // false locally). This is one extra auth-server round trip on an on-demand
      // route that was never on the anonymous read path, not a repeat of the cost
      // this project otherwise guards against.
      const signedInUser = await getUser({ cookies: Astro.cookies, request: Astro.request });
      if (signedInUser) {
        return Astro.redirect(next);
      }
      awaitingConfirmation = true;
    } else {
      // Already neutralised by signUpErrorMessage in src/lib/auth/index.ts, the same way
      // sign-in.astro's error is already BAD_CREDENTIALS_MESSAGE by the time it gets
      // here: chosen from the error's CODE, never relayed from Supabase's own text. This
      // page used to render `result.error` on the reasoning that sign-up is not the
      // enumeration-sensitive case sign-in is — which holds only where "Confirm email" is
      // ON, and it is OFF on the local stack, where a duplicate address comes back as a
      // verbatim `user_already_exists` and this form was an account-enumeration oracle.
      // PK-56 turned confirmations on for both HOSTED projects, which closes the oracle
      // there at the source (a duplicate now takes the awaitingConfirmation branch above
      // instead of this one) and changes nothing about this line: see the "THE PREMISE
      // MOVED IN PK-56" section on SIGN_UP_UNAVAILABLE_MESSAGE for why the mapping
      // survives its own premise, and for what is and is not closed in each environment.
      errorMessage = result.error;
    }
  }
}
---

<Layout title="Create an account — Packsheet" description="Create a free Packsheet account.">
  <main class="mx-auto flex min-h-svh max-w-sm flex-col justify-center px-6 py-16">
    <a href="/" class="text-ink-3 font-mono text-xs tracking-[0.18em] uppercase">Packsheet</a>
    <h1 class="mt-6 text-3xl">Create an account</h1>

    {
      awaitingConfirmation ? (
        <p class="text-ink-2 mt-6 text-sm">
          Almost there — check your inbox for a confirmation email, then{' '}
          <a href={SIGN_IN_PATH} class="text-blue-deep hover:text-blue-ink underline">
            sign in
          </a>
          .
        </p>
      ) : (
        <Fragment>
          {errorMessage && (
            <p
              role="alert"
              class="border-rust/40 bg-rust/10 text-ink mt-6 rounded-[var(--r-sm)] border px-4 py-3 text-sm"
            >
              {errorMessage}
            </p>
          )}

          <form method="POST" class="mt-8 space-y-4">
            <input type="hidden" name={NEXT_PARAM} value={next} />
            <div>
              <label for="email" class="text-ink-2 block text-sm">
                Email
              </label>
              <input
                id="email"
                name="email"
                type="email"
                autocomplete="email"
                required
                class="border-hairline bg-surface text-ink mt-1 w-full rounded-[var(--r-sm)] border px-3 py-2 text-sm"
              />
            </div>
            <div>
              <label for="password" class="text-ink-2 block text-sm">
                Password
              </label>
              <input
                id="password"
                name="password"
                type="password"
                autocomplete="new-password"
                required
                minlength="6"
                class="border-hairline bg-surface text-ink mt-1 w-full rounded-[var(--r-sm)] border px-3 py-2 text-sm"
              />
            </div>
            <button
              type="submit"
              class="border-blue-deep text-blue-deep hover:bg-blue-tint w-full rounded-[var(--r-sm)] border px-4 py-2 text-sm font-medium transition-colors"
            >
              Create account
            </button>
          </form>

          <div class="my-6 flex items-center gap-3" aria-hidden="true">
            <span class="border-hairline h-px flex-1 border-t" />
            <span class="text-ink-3 text-xs tracking-wide uppercase">or</span>
            <span class="border-hairline h-px flex-1 border-t" />
          </div>

          <form method="POST">
            <input type="hidden" name="intent" value="google" />
            <input type="hidden" name={NEXT_PARAM} value={next} />
            <button
              type="submit"
              class="border-hairline bg-surface text-ink-2 hover:text-ink hover:bg-sunk w-full rounded-[var(--r-sm)] border px-4 py-2 text-sm font-medium transition-colors"
            >
              Continue with Google
            </button>
          </form>

          <p class="text-ink-2 mt-8 text-sm">
            Already have an account?{' '}
            <a
              href={`${SIGN_IN_PATH}?next=${encodeURIComponent(next)}`}
              class="text-blue-deep hover:text-blue-ink underline"
            >
              Sign in
            </a>
          </p>
        </Fragment>
      )
    }
  </main>
</Layout>
