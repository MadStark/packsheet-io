---
// On-demand: this page requires a session, reads Astro.locals.user, inserts into packs on
// POST and redirects — none of which a prerendered file can do. See src/middleware.ts for
// why PACKS_PATH carries the no-store rule the same way GEAR_PATH and /account do, and
// src/pages/gear/index.astro for the page this one shares its shape with.
export const prerender = false;

import Layout from '../../layouts/Layout.astro';
import GearNav from '../../components/GearNav.astro';
import { createAuthClient } from '../../lib/auth';
import { readWeightSystem } from '../../lib/profile';
import { formatWeight } from '../../lib/units';
import { NEXT_PARAM, SIGN_IN_PATH } from '../../lib/auth-routes';
// This page IS `PACKS_PATH`, and a `<form method="POST">` with no action posts to the URL
// it was served from — so the constant is needed only for the dialog's Cancel link, which
// has to name this page explicitly in order to leave the `?new` parameter behind.
import { PACKS_PATH, PACK_CREATE_PARAM, packCreateHref, packPath } from '../../lib/packs/routes';
import { loadPackList } from '../../lib/packs/query';
import { createPack } from '../../lib/packs/mutations';
import {
  EMPTY_PACK_FORM_VALUES,
  parsePackForm,
  rawPackFormValues,
  type PackFormValues,
} from '../../lib/packs/form';
import { packTripTypeLabel } from '../../lib/packs/fields';
import PackDetailsDialog from '../../components/PackDetailsDialog.astro';

// src/middleware.ts has already resolved this with a verified getUser() call; reading it
// here rather than calling getUser() again is the whole point of doing it once in
// middleware. A null user redirects to sign-in with `next` set back to this exact URL
// (path + query), so signing in returns here rather than dropping the visitor somewhere
// they did not ask for.
const user = Astro.locals.user;
if (!user) {
  const next = `${Astro.url.pathname}${Astro.url.search}`;
  return Astro.redirect(`${SIGN_IN_PATH}?${NEXT_PARAM}=${encodeURIComponent(next)}`);
}

// CSRF: same protection as sign-in.astro and src/pages/gear/index.astro — Astro's
// on-demand origin check (security.checkOrigin, set explicitly in astro.config.mjs) plus
// the session cookie's sameSite: 'lax'. No separate CSRF token is needed on top of that
// pair for the same reason it isn't on those pages.
const client = createAuthClient(Astro.cookies, Astro.request);

// Never render a raw PostgREST/Supabase error string — the house rule stated in
// src/lib/packs/form.ts's "NEVER A RAW POSTGRES OR POSTGREST STRING" section.
const GENERIC_LOAD_ERROR = 'Something went wrong loading your packs. Please try again.';
const GENERIC_WRITE_ERROR = 'Something went wrong creating that pack. Please try again.';

let formErrors: Readonly<Record<string, string>> = {};
let formValues: PackFormValues = EMPTY_PACK_FORM_VALUES;
let writeError: string | null = null;

// ---------------------------------------------------------------------------
// POST: create one pack.
//
// Method discipline: this page answers GET and POST, nothing else — Astro returns 405 for
// any other method, since no other handler is exported. The one state-changing branch
// redirects with 303, so a refresh can never resubmit the create; a validation failure
// re-renders without having written anything, which is the whole point of it.
// ---------------------------------------------------------------------------
if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const result = parsePackForm(form);

  if (!result.ok) {
    formErrors = result.errors;
    formValues = result.values;
  } else {
    // createPack (src/lib/packs/mutations.ts) issues exactly one INSERT and counts nothing
    // first: THERE IS NO CAP on how many packs an account may have, and that module's
    // header says so explicitly because a limit is the kind of thing that gets added to a
    // create path by reflex. tests/packs-mutations.test.ts asserts the absence.
    const { id, error } = await createPack(client, result.values);

    if (error || id === null) {
      writeError = GENERIC_WRITE_ERROR;
      // The submission validated; the write did not. Re-render with exactly what the
      // visitor typed — see rawPackFormValues' own comment for why this is the right thing
      // to show back rather than a value reconstructed from the parsed input.
      formValues = rawPackFormValues(form);
    } else {
      // Straight into the new pack's editor. A pack created from this form is empty, and
      // the next thing its owner wants is a category to put something in — landing back on
      // the list would make them find the row they just made and click it.
      return Astro.redirect(packPath(id), 303);
    }
  }
}

// ---------------------------------------------------------------------------
// GET (and the render after a POST that did not redirect): every pack this visitor owns,
// each with its own totals.
// ---------------------------------------------------------------------------

// One round trip for the whole list, totals included — loadPackList embeds the tree each
// pack's totals are computed from, so this is not an N+1 waiting to happen. Its
// `.eq('user_id', ...)` is load-bearing rather than belt-and-braces: `packs_select_public`
// would union in every stranger's public pack under a heading that says "your packs". See
// that function's own comment.
const { packs, error: listError } = await loadPackList(client, user.id);

// PK-67: the account's system, read once for the whole list rather than per row — it is
// one value for the page, and a query per pack to render one column would be a round trip
// for a display preference.
const { system: weightSystem } = await readWeightSystem(client, user.id);

const loadError = listError ? GENERIC_LOAD_ERROR : null;

/**
 * Whether the create-pack dialog renders already-open (PK-72).
 *
 * THREE WAYS IN, AND THE LAST TWO ARE WHY THIS IS NOT JUST THE PARAMETER. `?new` is the
 * ordinary one: the trigger is a real `<a href>` (Modal.astro upgrades anchors and refuses
 * anything else, so the control works with JavaScript off), and with no script the click
 * is a plain navigation that lands here.
 *
 * The other two are the failure paths, and forgetting them is how a dialog eats someone's
 * typing. A POST that fails validation, or that validates and then fails to write, falls
 * through to a re-render of THIS page — at the URL the form posted to, which carries no
 * `?new`. Without these two clauses the visitor would get the list back with their text
 * gone and, in the validation case, no error visible anywhere, because the only thing that
 * renders `formErrors` is inside the dialog.
 */
const showCreateDialog =
  Astro.url.searchParams.has(PACK_CREATE_PARAM) ||
  Object.keys(formErrors).length > 0 ||
  writeError !== null;

/** Joins the trigger's `data-modal-open` to the dialog's `id`. One dialog on this page. */
const CREATE_DIALOG_ID = 'create-pack';

// "This visitor has no packs" is exactly an empty list from a read that did not fail, and
// it is an ordinary state rather than an error — a new account has no packs, and the first
// thing it should see is an invitation to make one, not a blank page.
const listIsEmpty = !loadError && packs.length === 0;
---

<Layout
  title="Your packs — Packsheet"
  description="Every pack list you have built in Packsheet, with its weight and item count."
>
  <GearNav />
  <main class="paper-col flex flex-col gap-[30px] py-[30px]">
    {
      /* PK-64 (Notebook Paper). A cover sheet carrying the title and the create action,
         and a sheet holding the list as a ledger — the "a sheet holding a
         list" and "a sheet holding a form" patterns src/pages/gear/index.astro already
         sets. Both alerts are notes lying directly on the paper (§2.5), never inside a
         sheet. */
    }
    {
      writeError && (
        <div class="note note-danger" role="alert">
          <p>{writeError}</p>
        </div>
      )
    }
    {
      loadError && (
        <div class="note note-danger" role="alert">
          <p>{loadError}</p>
        </div>
      )
    }

    {
      /* The cover sheet, now carrying the create action as well as the title — the shape
         src/pages/gear/index.astro's header already has, and the reason this is a header
         row rather than a bare <h1>: the button that makes a pack belongs beside the name
         of the thing it makes, not in a sheet of its own further down the page.

         The eyebrow ("Packs") and the aside ("one for each trip") are gone at the design
         feedback's request. Nothing replaces them — the <h1> already says "Your packs", so
         the eyebrow was saying it twice. */
    }
    <div class="sheet">
      <div class="sheet-body">
        <header class="flex items-start justify-between gap-6">
          <h1 class="page-title">Your packs</h1>
          {
            /* A LINK, NOT A BUTTON, and that is Modal.astro's rule rather than a
               preference: it upgrades `<a href>` triggers and refuses anything else, so
               that the control still does something when the upgrade never happens. With
               JavaScript off this navigates to `/packs?new`, which renders the same dialog
               already open. It used to be a submit button for the inline form this
               replaces. */
          }
          <a
            href={packCreateHref()}
            data-modal-open={CREATE_DIALOG_ID}
            class="btn btn-primary shrink-0"
          >
            Create pack
          </a>
        </header>
      </div>
    </div>

    {
      loadError ? null : listIsEmpty ? (
        <div class="sheet">
          {/* .blank stands in for .sheet-body — see paper.css's own comment on the class —
              per DESIGN.md §9. Not a bordered box. */}
          <div class="blank">
            <p class="section-title">You have not built a pack yet.</p>
            <p class="hint mt-2">
              A pack is a list of what you are taking on one trip, grouped into categories and
              weighed as you build it.
            </p>
          </div>
        </div>
      ) : (
        <div class="sheet">
          <div class="sheet-body">
            <table class="ledger">
              <caption class="sr-only">Your packs</caption>
              <thead>
                <tr>
                  <th scope="col">Name</th>
                  <th scope="col">Trip type</th>
                  <th scope="col" class="text-right">
                    Base
                  </th>
                  <th scope="col" class="text-right">
                    Total
                  </th>
                  <th scope="col" class="text-right">
                    Items
                  </th>
                </tr>
              </thead>
              <tbody>
                {packs.map(({ pack, totals }) => {
                  // EVERY NUMBER ON THIS ROW COMES FROM `totals`, which loadPackList
                  // produced with computeTotals (src/lib/totals.ts) from the same tree the
                  // row was fetched with. Nothing on this page adds up a weight or counts an
                  // item itself — a second summation here is exactly the duplication that
                  // makes the list and the editor disagree about a figure a visitor can see
                  // on both screens within one click of each other.
                  const tripType = packTripTypeLabel(pack.trip_type);
                  return (
                    <tr>
                      <td>
                        <a
                          href={packPath(pack.id)}
                          class="text-blue-deep hover:text-blue-ink underline"
                        >
                          {pack.name}
                        </a>
                      </td>
                      <td>{tripType === '' ? '—' : tripType}</td>
                      {/* Blue for a base weight is the one non-interactive use the palette
                          allows (CONTRIBUTING.md); the total beside it stays ink, because a
                          total is not a base weight and colouring it blue would spend the
                          signal on the number that needs it least. */}
                      <td class="numeric text-w-base text-right">
                        {formatWeight(totals.base, weightSystem)}
                      </td>
                      <td class="numeric text-right">{formatWeight(totals.total, weightSystem)}</td>
                      <td class="numeric text-right">{totals.itemCount}</td>
                    </tr>
                  );
                })}
              </tbody>
            </table>
          </div>
        </div>
      )
    }

    {
      /* LAST IN THE DOCUMENT, AND OUTSIDE EVERY SHEET. A presented <dialog> sits in the
         top layer, so where it appears in the flow does not affect where it is drawn — but
         it does affect the no-JS fallback, which renders in place as an ordinary sheet.
         After the list is the right place for that: the visitor has the page they asked
         for, with the form beneath it, rather than the form shoving the list off-screen.

         The form inside posts to this page with no `action`, so the POST branch at the top
         of this file answers it — the same branch, and the same `parsePackForm`, that the
         inline form used before it became this. */
    }
    <PackDetailsDialog
      id={CREATE_DIALOG_ID}
      open={showCreateDialog}
      title="Create a pack"
      values={formValues}
      errors={formErrors}
      submitLabel="Create pack"
      cancelHref={PACKS_PATH}
    />
  </main>
</Layout>
