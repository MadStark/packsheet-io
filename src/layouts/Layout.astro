---
import '../styles/global.css';
// Imported rather than hardcoded: Vite fingerprints the filename at build time,
// so a literal /_astro/... path would 404 in production.
import hankenGroteskUrl from '../assets/fonts/hanken-grotesk-latin-var.woff2?url';

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;

// Astro.site is the configured production origin (astro.config.mjs); Astro.url is
// this request's path. Composing them here, rather than hardcoding a domain, means
// this keeps working unchanged once PS-39 binds packsheet.io and once any page
// beyond index.astro exists.
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Packsheet" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />

    <!--
      summary, not summary_large_image: there is deliberately no og:image yet (a
      follow-up ticket adds one). summary_large_image with no image renders as a
      broken card in link previews; summary degrades to a text-only card instead.
    -->
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />

    <!--
      Preload the body face only. Preloading all four would have them compete for
      bandwidth with the HTML on first paint; Hanken is the one that renders the
      most pixels above the fold.
    -->
    <link rel="preload" href={hankenGroteskUrl} as="font" type="font/woff2" crossorigin />

    <!--
      Set the theme before first paint so a dark-mode user never sees a flash of
      warm paper. Inline and synchronous by necessity — a deferred script runs too
      late to prevent the flash.
    -->
    <script is:inline>
      (function () {
        try {
          const stored = localStorage.getItem('packsheet-theme');
          if (stored === 'light' || stored === 'dark') {
            document.documentElement.setAttribute('data-theme', stored);
          }
        } catch {
          /* Private mode blocks localStorage; the CSS media query still applies. */
        }
      })();
    </script>
  </head>
  <body>
    <slot />
  </body>
</html>
