---
// The shared status glyph for the three `GearStatus` values. Two tickets created this
// file independently — PK-62 for the closet list, PK-63 for the item form's radio group —
// and this is the reconciled version. Read the split of responsibility below before
// changing either half, because the two callers want genuinely different things and the
// resolution was a deliberate decision rather than a merge artefact.
//
// THIS COMPONENT DRAWS; IT DOES NOT DECIDE. Every status has a glyph here, `owned`
// included. Whether a given caller *renders* one is the caller's business:
//
//   - The item form's radio group (PK-63) draws all three. It presents Owned, Wishlist
//     and Retired as equal, explicit choices, so an icon-less "Owned" option would read
//     as a rendering bug sitting next to two that have one.
//   - The closet list (PK-62) draws NOTHING for `owned`, and asks `gearStatusMarker`
//     (src/lib/gear/format.ts) rather than this file which rows get a glyph. `owned` is
//     that list's unmarked default — the overwhelming majority of a closet — so marking
//     it would put a tick on nearly every row to say "nothing unusual here". The ragged
//     left edge that produces is PK-62's accepted design and must not be padded away.
//
// An earlier pair of versions put that policy INSIDE this component (PK-62 returned null
// for `owned`), which made the form's requirement unsatisfiable without changing the
// shared file. Policy lives with each caller now; drawing lives here.
//
// KEEP THIS A PLAIN .astro COMPONENT. It takes no `client:*` directive anywhere it is
// used and must never gain one — the same rule GearNav and GearItemForm hold themselves
// to. In particular this does NOT import `lucide-vue-next`, which the repo carries for
// other, hydrated parts of the app: pulling a Vue component library in to draw shapes a
// dozen inline `<path>`s can draw would buy nothing and risk hydration reaching a page
// that renders fine without any.
//
// STATUS IS NEVER CONVEYED BY COLOUR ALONE (WCAG 1.4.1), which is why there are two
// rendering modes rather than a preference for one. An icon that is the ONLY indicator
// of status must carry its own accessible name, exactly as any icon-only control would —
// that is the default mode (`role="img"` plus a `<title>`), and it is what the closet
// list uses. When the glyph instead sits beside visible text that already names the
// status — the radio group, whose label reads "Owned"/"Wishlist"/"Retired" right next to
// it — a second accessible name would be read out twice for one control, so that caller
// passes `decorative` and the SVG leaves the accessibility tree entirely. The three
// glyphs also differ in SHAPE, so neither mode depends on hue being perceivable.
//
// WHY WISHLIST IS --ochre-ink AND NOT --ochre. This glyph sits on four different grounds
// across the two surfaces that draw it, and the colour has to clear the bar on the worst
// of them. On the CLOSET a wishlist glyph only ever appears on a wishlist row, so its
// grounds are the 5.5% ochre wash and that row hovered at 9%; the plain sheet and the 4%
// ink hover are the ITEM FORM's, where the same glyph sits in an unselected segment.
// Measured against all four:
//
//     --ochre     #b5822e   3.39 / 3.14 / 3.20 / 3.09
//     --ochre-ink #8a6118   5.52 / 5.11 / 5.21 / 5.03
//
// WCAG 1.4.11 asks 3:1 for a graphical object, so --ochre technically passes and clears it
// by 0.09 at worst — which is not a margin worth shipping for the mark that IS the only
// carrier of "wishlist" on a row. --ochre-ink clears it by two to one everywhere.
//
// (The earlier version of this note reasoned about --surface and --sunk. Both tokens were
// deleted by PK-64 along with the elevation model that needed them; the conclusion did not
// change, but the grounds it was measured against no longer existed, so the numbers above
// are re-measured rather than carried over.)
//
// Same palette, nothing invented. --moss and --rust needed no such change. Never --blue:
// blue marks something INTERACTIVE, and a status marker is not clickable.
import { GEAR_STATUS_LABELS, isGearStatus, type GearStatus } from '../lib/gear/fields';

interface Props {
  /** A `gear_items` row's `status`, typed as the bare `string` the database client hands
   *  back rather than a `GearStatus`. The generated row type says `string` and the CHECK
   *  constraint behind it is not proven to still hold by the time a row is read, so the
   *  closet list has nothing narrower to pass; the radio group passes a `GearStatus`,
   *  which widens for free. A value `isGearStatus` rejects renders NOTHING — there is no
   *  honest glyph for a status this product has never heard of, and a defect badge would
   *  mark a row whose only fault is having been written straight against PostgREST. The
   *  closet list pairs this with a screen-reader-only rendering of the raw value so such
   *  a status is not invisible; see src/pages/gear/index.astro. */
  readonly status: string;
  /** True when a sighted, visible label already names this status beside the icon (see
   *  the module comment): the SVG then renders `aria-hidden="true"` / `focusable="false"`
   *  and carries no accessible name of its own. Omitted renders `role="img"` with a
   *  `<title>`, for the icon-only case. */
  readonly decorative?: boolean;
  /** Merged onto the `<svg>` AFTER a default size, so a caller can size and position the
   *  glyph without this component needing to know every context it is used in — and,
   *  because Tailwind emits both classes and the later utility wins, a caller's own
   *  `size-*` / `h-*`/`w-*` still overrides. The default matters: an `<svg>` with a
   *  viewBox and no dimensions lays out at 300x150, so a caller who forgets renders an
   *  enormous glyph rather than a slightly wrong one. An earlier version of this
   *  component carried the size internally and lost it in a merge; this keeps the
   *  override without reintroducing that cliff. */
  readonly class?: string;
}

const { status, decorative = false, class: className } = Astro.props;

/**
 * Colour class and path data per status, as a map that is TOTAL over `GearStatus`. That
 * totality is the enforcement: add a fourth status to `GEAR_STATUSES` and this stops
 * compiling until somebody decides what it looks like, rather than silently rendering
 * nothing — which is exactly how a fourth status would have failed against the pair of
 * `===` checks an earlier version of this file used. Colours are the tokens tokens.css
 * reserves for this meaning, exposed as Tailwind utilities by global.css's `@theme
 * inline` block, never hex typed out again here.
 */
const ICONS: Record<
  GearStatus,
  { readonly colorClass: string; readonly paths: readonly string[] }
> = {
  // A single check mark, one plain stroke rather than a filled badge so it stays legible
  // at the size the radio group draws it. Only the form renders this one — see the
  // module comment on why the closet list deliberately does not.
  owned: {
    colorClass: 'text-moss',
    paths: ['M5 13l4 4L19 7'],
  },
  // A shopping trolley, in the two-strokes-plus-two-wheels arrangement most icon sets
  // use for "wanted, not yet acquired" — recognisable at a glance rather than this file
  // inventing a novel glyph for a familiar idea.
  wishlist: {
    colorClass: 'text-ochre-ink',
    paths: [
      'M3 4h2l2.68 11.39a2 2 0 0 0 2 1.61h8.72a2 2 0 0 0 2-1.61L22 8H6',
      'M9 21a1 1 0 1 0 0-2 1 1 0 0 0 0 2z',
      'M19 21a1 1 0 1 0 0-2 1 1 0 0 0 0 2z',
    ],
  },
  // A waste bin: out of active use but STILL IN THE CLOSET. "Retired" is a status the
  // row keeps, not a deletion — PK-60 made deleting an item final, with no trash to
  // recover it from, which is all the more reason the two must not read alike.
  retired: {
    colorClass: 'text-rust',
    paths: [
      'M3 6h18',
      'M8 6V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2',
      'M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6',
      'M10 11v6',
      'M14 11v6',
    ],
  },
};

const icon = isGearStatus(status) ? ICONS[status] : null;
const label = isGearStatus(status) ? GEAR_STATUS_LABELS[status] : null;
/** `size-4` first so a caller's own sizing utility, appended after it, wins. */
const svgClass = [icon?.colorClass, 'size-4 shrink-0', className].filter(Boolean).join(' ');
---

{
  icon &&
    (decorative ? (
      <svg
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        class={svgClass}
        aria-hidden="true"
        focusable="false"
      >
        {icon.paths.map((d) => (
          <path d={d} />
        ))}
      </svg>
    ) : (
      <svg
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        class={svgClass}
        role="img"
      >
        <title>{label}</title>
        {icon.paths.map((d) => (
          <path d={d} />
        ))}
      </svg>
    ))
}
