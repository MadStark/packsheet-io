---
// A shared, hand-written inline-SVG icon for the three `GearStatus` values (PK-63),
// factored out so the item form's status radio group and PK-62's closet list draw the
// same tick/cart/trash-can shapes from one place rather than two components quietly
// drifting apart on which glyph means what.
//
// KEEP THIS A PLAIN .astro COMPONENT. It takes no `client:*` directive anywhere it is
// used and must never gain one — the same "no hydration" rule GearNav and GearItemForm
// hold themselves to: this icon is static markup, every field on this form works with
// JavaScript disabled, and nothing about a status glyph needs a browser-side decision to
// render. For the same reason this does not import `lucide-vue-next`, which the repo
// carries as a dependency for other, hydrated parts of the app: importing a Vue
// component library here to draw a shape that a dozen lines of inline `<path>` can draw
// just as well would buy nothing and risk everything, so the SVGs below are written out
// by hand instead.
//
// STATUS MUST NEVER BE CONVEYED BY COLOUR ALONE, and that accessibility contract is why
// this component has two rendering modes rather than one, not a preference for either.
// An icon that is the ONLY indicator of status on the page must carry its own accessible
// name, exactly as any icon-only control would — so when nothing else nearby names the
// status, the caller renders the non-decorative mode below (`role="img"` plus a
// `<title>`). When the icon instead sits beside visible text that already names the
// status — this ticket's three-way radio group, where the label reads
// "Owned"/"Wishlist"/"Retired" right next to the glyph — a second accessible name on the
// SVG would be duplicate noise a screen reader reads out twice for the same radio
// option, so the caller passes `decorative` and the icon disappears from the
// accessibility tree entirely. PK-62's closet list, where a row has no adjacent
// "Wishlist" text next to its icon, is expected to be the first caller of the
// non-decorative mode — an example of when the contract applies, not the reason it
// exists.
//
// EVERY STATUS GETS A GLYPH HERE, `owned` INCLUDED, because this form's own radio group
// presents all three statuses as equal, explicit choices — nothing here treats `owned`
// as a silent default the way a list row might, so an icon-less "owned" option would
// stand out as the one choice with no visual marker next to it. That holds regardless of
// what any other caller of this component decides to do with the `owned` icon.
// PK-62, as scoped, is expected to render no icon at all for `owned` on the closet list:
// `owned` is that list's default, unmarked state, so an icon there is expected to be
// needed only for the two exceptions, `wishlist` and `retired`. That is a decision for
// PK-62's own page to make, not a fact this file enforces — the `owned` icon stays
// defined here regardless, for this form's use.
import { GEAR_STATUS_LABELS, type GearStatus } from '../lib/gear/fields';

interface Props {
  status: GearStatus;
  /** True when a sighted, visible label already names this status next to the icon (see
   *  the module comment above) — the SVG then renders `aria-hidden="true"` and
   *  `focusable="false"` and carries no accessible name of its own. False or omitted
   *  renders `role="img"` with a `<title>`, for the icon-only case. */
  decorative?: boolean;
  /** Merged onto the `<svg>` so a caller can size or position it without this component
   *  needing to know every context it is used in. */
  class?: string;
}

const { status, decorative = false, class: className } = Astro.props;

/** Colour class and path data per status. Colours are the tokens `tokens.css` reserves
 *  for exactly this meaning — `--moss` for a positive/owned state, `--ochre` for a
 *  wanted-but-not-yet state, `--rust` for the same red the rest of this form already
 *  uses for "gone"/error — exposed as Tailwind utilities via `global.css`'s
 *  `@theme inline` block (`text-moss`, `text-ochre`, `text-rust`), not hex values typed
 *  out again here. */
const ICONS: Record<GearStatus, { colorClass: string; paths: readonly string[] }> = {
  // A single check mark. Kept to one plain stroke rather than a filled badge so it reads
  // at the small sizes this form's radio group renders it at.
  owned: {
    colorClass: 'text-moss',
    paths: ['M5 13l4 4L19 7'],
  },
  // A shopping cart, in the same two-stroke-shapes-plus-two-wheels arrangement most
  // icon sets use for "wanted, not yet acquired" — recognisable at a glance rather than
  // this file inventing its own novel glyph for the same idea.
  wishlist: {
    colorClass: 'text-ochre',
    paths: [
      'M3 4h2l2.68 11.39a2 2 0 0 0 2 1.61h8.72a2 2 0 0 0 2-1.61L22 8H6',
      'M9 21a1 1 0 1 0 0-2 1 1 0 0 0 0 2z',
      'M19 21a1 1 0 1 0 0-2 1 1 0 0 0 0 2z',
    ],
  },
  // A trash can, mirroring the "retired" copy in GEAR_STATUS_MEANINGS: gone from active
  // use but kept on record, the same distinction the closet's own trash (soft-delete)
  // draws elsewhere in this app.
  retired: {
    colorClass: 'text-rust',
    paths: [
      'M3 6h18',
      'M8 6V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2',
      'M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6',
      'M10 11v6',
      'M14 11v6',
    ],
  },
};

const icon = ICONS[status];
const label = GEAR_STATUS_LABELS[status];
const svgClass = [icon.colorClass, className].filter(Boolean).join(' ');
---

{
  decorative ? (
    <svg
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
      class={svgClass}
      aria-hidden="true"
      focusable="false"
    >
      {icon.paths.map((d) => (
        <path d={d} />
      ))}
    </svg>
  ) : (
    <svg
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
      class={svgClass}
      role="img"
    >
      <title>{label}</title>
      {icon.paths.map((d) => (
        <path d={d} />
      ))}
    </svg>
  )
}
