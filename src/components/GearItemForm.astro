---
// The gear item create/edit form (PK-4), shared by src/pages/gear/new.astro and
// src/pages/gear/[id].astro so the two pages cannot silently drift apart on field
// names, labels, error wiring or markup — the entire reason this exists as one
// component rather than two copies. It renders every editable `gear_items` field
// EXCEPT a photo: Ref 10 owns the photo upload and no storage exists yet, so there is
// deliberately no file input here — its absence is a decision, not an oversight.
//
// KEEP THIS A PLAIN .astro COMPONENT, mirroring GearNav's own rule. It takes no
// `client:*` directive anywhere it is used and must never gain one: every field here
// works with JavaScript disabled because the whole form is a real POST, and nothing in
// it needs a browser-side decision to render or to submit.
//
// NO DECISION-MAKING LIVES HERE. Every prop this component reads is already a decided
// value — `values` and `errors` come from `parseGearItemForm` or `gearItemToFormValues`
// in src/lib/gear/form.ts, both covered by tests/gear-form.test.ts. This component only
// arranges markup around them; see that module's own "WHY THIS LIVES IN src/lib/ RATHER
// THAN IN THE PAGE" for why the validation itself could not live here instead.
import { GEAR_FORM_FIELD, type GearFormValues } from '../lib/gear/form';
import { GEAR_STATUS_MEANINGS, GEAR_STATUSES } from '../lib/gear/fields';
import { formatGearStatus } from '../lib/gear/format';
import { WEIGHT_UNITS } from '../lib/units';
import GearStatusIcon from './GearStatusIcon.astro';
// `NEXT_PARAM` only — src/lib/auth-routes.ts is dependency-free BY DESIGN (see its own
// header comment, "the constants live out here, one door away from the choke point"),
// which is exactly what lets a plain gear-item form import a single string constant from
// it without that import becoming a reason `tests/anonymous-read-path.test.ts`'s
// Invariant A would ever have to object to. Nothing here touches an auth SDK or a
// Supabase client; this form does not become an AUTH_CONSUMERS entry by reading a path.
import { NEXT_PARAM } from '../lib/auth-routes';

interface Props {
  values: GearFormValues;
  errors: Readonly<Record<string, string>>;
  submitLabel: string;
  cancelHref: string;
  /** A hidden field this page's own POST handler needs to tell this submission apart
   *  from another form on the same page — e.g. `src/pages/gear/[id].astro`'s edit form
   *  next to its own separate delete form. Omitted on `new.astro`, whose page has only
   *  one form and so nothing to disambiguate. */
  intentField?: { readonly name: string; readonly value: string };
  /** The category names already in use, offered as `<datalist>` suggestions under the
   *  Category field (PK-63) — see that field's own comment below for why a `datalist`
   *  rather than a `<select>`. The page that renders this form is responsible for
   *  querying which categories exist; this component only arranges them into options. */
  categories: readonly string[];
  /** The post-submit return path, rendered as a hidden field when the caller supplies
   *  one — see the field itself, further down, for why this travels through the form
   *  rather than the page reading it straight off the URL. Which pages pass this is a
   *  later task's job; this component only accepts and renders it. */
  next?: string;
}

const { values, errors, submitLabel, cancelHref, intentField, categories, next } = Astro.props;

const errorEntries = Object.entries(errors);

const INPUT_CLASS =
  'border-hairline bg-surface text-ink mt-1 w-full rounded-[var(--r-sm)] border px-3 py-2 text-sm aria-invalid:border-rust';
const SELECT_CLASS = INPUT_CLASS;
const TEXTAREA_CLASS = `${INPUT_CLASS} min-h-24`;
const LABEL_CLASS = 'text-ink-2 block text-sm';
const ERROR_CLASS = 'text-rust mt-1 text-sm';
/** One option in the status fieldset (PK-63) — a bordered, clickable card around the
 *  radio input and its label, echoing INPUT_CLASS's own border/radius vocabulary rather
 *  than inventing a second visual language just for this one field. Pulled out as a
 *  named constant, not inlined, because it is long enough that repeating it once per
 *  `GEAR_STATUSES` entry would make the markup below harder to scan than the value
 *  itself. */
const STATUS_OPTION_CLASS =
  'border-hairline has-[:checked]:border-blue-deep has-[:checked]:bg-blue-tint flex cursor-pointer items-center gap-2 rounded-[var(--r-sm)] border px-3 py-2 text-sm';

function describedBy(field: string): string | undefined {
  return errors[field] ? `${field}-error` : undefined;
}

function invalid(field: string): 'true' | undefined {
  return errors[field] ? 'true' : undefined;
}
---

<form method="POST" class="space-y-5">
  {intentField && <input type="hidden" name={intentField.name} value={intentField.value} />}
  {
    /* The same mechanism sign-in.astro and sign-up.astro use for their own `next`
       fields (see NEXT_PARAM's comment in src/lib/auth-routes.ts): a
       `<form method="POST">` with no `action` posts to the current URL, so a `next`
       carried only in the query string would already survive an ordinary submit, but
       putting it in the form as well means it also survives an `action` being added to
       this form later for any reason — the exact silent-drop failure mode
       `nextFromForm`'s own comment describes for those two pages. Which page passes
       `next`, and where it points, is a later task's decision; this component only
       renders whatever it is given. */
  }
  {next !== undefined && <input type="hidden" name={NEXT_PARAM} value={next} />}

  {
    errorEntries.length > 0 && (
      <div
        role="alert"
        class="border-rust/40 bg-rust/10 text-ink rounded-[var(--r-sm)] border px-4 py-3 text-sm"
      >
        <p class="font-medium">Fix the following before saving:</p>
        <ul class="mt-2 list-disc space-y-1 pl-5">
          {errorEntries.map(([, message]) => (
            <li>{message}</li>
          ))}
        </ul>
      </div>
    )
  }

  <div>
    <label for="name" class={LABEL_CLASS}>
      Name <span aria-hidden="true" class="text-rust">*</span>
    </label>
    <input
      id="name"
      name={GEAR_FORM_FIELD.name}
      type="text"
      value={values.name}
      aria-required="true"
      aria-describedby={describedBy('name')}
      aria-invalid={invalid('name')}
      class={INPUT_CLASS}
    />
    {
      /* NOT the HTML `required` attribute, deliberately. `required` triggers native
         constraint validation, which blocks the form submit entirely in-browser the
         moment Name is blank — the visitor never leaves the page, `parseGearItemForm`
         never runs, and this ticket's own acceptance criterion ("a blank Name re-renders
         the form with the field outlined in --rust") could never be observed, because
         the server round-trip that produces it would never happen. `aria-required`
         communicates the same thing to assistive tech without touching submission
         behaviour, and the red asterisk communicates it visually; the actual
         enforcement — and the --rust outline on `errors.name` below — stays entirely
         server-side in parseGearItemForm, same as every other field on this form. */
    }
    {
      errors.name && (
        <p id="name-error" class={ERROR_CLASS}>
          {errors.name}
        </p>
      )
    }
  </div>

  <div class="grid gap-5 sm:grid-cols-2">
    <div>
      <label for="brand" class={LABEL_CLASS}> Brand </label>
      <input
        id="brand"
        name={GEAR_FORM_FIELD.brand}
        type="text"
        value={values.brand}
        class={INPUT_CLASS}
      />
    </div>
    <div>
      <label for="category" class={LABEL_CLASS}> Category </label>
      {
        /* `list`/`<datalist>`, not a `<select>` (PK-63). A datalist only SUGGESTS —
           the input stays free text, so typing a brand-new category a visitor's closet
           has never seen works exactly as it did before this field grew suggestions, and
           `parseGearItemForm` goes on receiving a bare string it validates the same way
           regardless of whether it came from a click or was typed by hand. A `<select>`
           would have to either invent an "Other" escape hatch or reject any category not
           already in `categories`, and this ticket asks for neither. */
      }
      <input
        id="category"
        name={GEAR_FORM_FIELD.category}
        type="text"
        list="category-options"
        value={values.category}
        class={INPUT_CLASS}
      />
      <datalist id="category-options">
        {categories.map((category) => <option value={category} />)}
      </datalist>
    </div>
  </div>

  <div>
    <label for="description" class={LABEL_CLASS}> Description </label>
    <textarea id="description" name={GEAR_FORM_FIELD.description} class={TEXTAREA_CLASS}
      >{values.description}</textarea
    >
  </div>

  <div class="grid gap-5 sm:grid-cols-3">
    <div>
      <label for="quantity" class={LABEL_CLASS}> Quantity </label>
      <input
        id="quantity"
        name={GEAR_FORM_FIELD.quantity}
        type="text"
        inputmode="numeric"
        value={values.quantity}
        aria-describedby={describedBy('quantity')}
        aria-invalid={invalid('quantity')}
        class={INPUT_CLASS}
      />
      {
        errors.quantity && (
          <p id="quantity-error" class={ERROR_CLASS}>
            {errors.quantity}
          </p>
        )
      }
    </div>
    <div>
      <label for="weight" class={LABEL_CLASS}> Weight </label>
      <input
        id="weight"
        name={GEAR_FORM_FIELD.weight}
        type="text"
        inputmode="decimal"
        value={values.weight}
        aria-describedby={describedBy('weight')}
        aria-invalid={invalid('weight')}
        class={INPUT_CLASS}
      />
      {
        errors.weight && (
          <p id="weight-error" class={ERROR_CLASS}>
            {errors.weight}
          </p>
        )
      }
    </div>
    <div>
      <label for="weight_unit" class={LABEL_CLASS}> Weight unit </label>
      <select
        id="weight_unit"
        name={GEAR_FORM_FIELD.weightUnit}
        aria-describedby={describedBy('weight_unit')}
        aria-invalid={invalid('weight_unit')}
        class={SELECT_CLASS}
      >
        {
          WEIGHT_UNITS.map((unit) => (
            <option value={unit} selected={unit === values.weight_unit}>
              {unit}
            </option>
          ))
        }
      </select>
      {
        errors.weight_unit && (
          <p id="weight_unit-error" class={ERROR_CLASS}>
            {errors.weight_unit}
          </p>
        )
      }
    </div>
  </div>

  <div class="grid gap-5 sm:grid-cols-2">
    <div>
      <label for="price" class={LABEL_CLASS}> Price </label>
      <input
        id="price"
        name={GEAR_FORM_FIELD.price}
        type="text"
        inputmode="decimal"
        value={values.price}
        aria-describedby={describedBy('price')}
        aria-invalid={invalid('price')}
        class={INPUT_CLASS}
      />
      {
        errors.price && (
          <p id="price-error" class={ERROR_CLASS}>
            {errors.price}
          </p>
        )
      }
    </div>
    <div>
      <label for="currency" class={LABEL_CLASS}> Currency </label>
      <input
        id="currency"
        name={GEAR_FORM_FIELD.currency}
        type="text"
        placeholder="GBP"
        value={values.currency}
        aria-describedby={describedBy('currency')}
        aria-invalid={invalid('currency')}
        class={INPUT_CLASS}
      />
      {
        errors.currency && (
          <p id="currency-error" class={ERROR_CLASS}>
            {errors.currency}
          </p>
        )
      }
    </div>
  </div>

  <div class="grid gap-5 sm:grid-cols-2">
    <div>
      <label for="volume_litres" class={LABEL_CLASS}> Volume (litres) </label>
      <input
        id="volume_litres"
        name={GEAR_FORM_FIELD.volumeLitres}
        type="text"
        inputmode="decimal"
        value={values.volume_litres}
        aria-describedby={describedBy('volume_litres')}
        aria-invalid={invalid('volume_litres')}
        class={INPUT_CLASS}
      />
      {
        errors.volume_litres && (
          <p id="volume_litres-error" class={ERROR_CLASS}>
            {errors.volume_litres}
          </p>
        )
      }
    </div>
    <div>
      {
        /* A radio group, not a `<select>` (PK-63). This makes "exactly one status" a
           STRUCTURAL property of the markup — the browser itself refuses to let two
           radios in the same `name` group be checked at once — rather than one this
           component or a script would have to enforce. It works identically with
           JavaScript disabled, same as every other field on this form: the group posts
           whichever `value` was checked, or nothing at all if none was, and
           `parseGearItemForm` is exactly as able to make sense of either outcome as it
           was reading a `<select>`'s single value. */
      }
      <fieldset aria-describedby={describedBy('status')} aria-invalid={invalid('status')}>
        <legend class={LABEL_CLASS}>Status</legend>
        <div class="mt-1 grid gap-2">
          {
            GEAR_STATUSES.map((status) => (
              <label class={STATUS_OPTION_CLASS} title={GEAR_STATUS_MEANINGS[status]}>
                <input
                  type="radio"
                  name={GEAR_FORM_FIELD.status}
                  value={status}
                  checked={status === values.status}
                />
                <GearStatusIcon status={status} decorative class="size-4 shrink-0" />
                {formatGearStatus(status)}
              </label>
            ))
          }
        </div>
      </fieldset>
      {
        /* If `values.status` matches none of GEAR_STATUSES — a tampered or otherwise
           stale submission `parseGearItemForm` has already rejected via `errors.status`
           — NO radio ends up checked here. That is correct, not a bug to paper over: this
           component makes no decisions (see the header comment), so it has no business
           inventing a silent fallback to `owned` for a value the parser itself refused.
           The visitor sees the error below and an unchecked group, which is an honest
           reflection of "you did not tell us a valid status", not a wrong answer picked
           on their behalf. */
      }
      {
        errors.status && (
          <p id="status-error" class={ERROR_CLASS}>
            {errors.status}
          </p>
        )
      }
    </div>
  </div>

  <div>
    <label for="url" class={LABEL_CLASS}> Web address </label>
    <input
      id="url"
      name={GEAR_FORM_FIELD.url}
      type="text"
      placeholder="https://"
      value={values.url}
      aria-describedby={describedBy('url')}
      aria-invalid={invalid('url')}
      class={INPUT_CLASS}
    />
    {
      errors.url && (
        <p id="url-error" class={ERROR_CLASS}>
          {errors.url}
        </p>
      )
    }
  </div>

  <div>
    <label for="notes" class={LABEL_CLASS}> Notes </label>
    <textarea id="notes" name={GEAR_FORM_FIELD.notes} class={TEXTAREA_CLASS}
      >{values.notes}</textarea
    >
  </div>

  <div class="flex gap-3 pt-2">
    <button
      type="submit"
      class="border-blue-deep text-blue-deep hover:bg-blue-tint rounded-[var(--r-sm)] border px-4 py-2 text-sm font-medium transition-colors"
    >
      {submitLabel}
    </button>
    <a
      href={cancelHref}
      class="border-hairline text-ink-2 hover:text-ink rounded-[var(--r-sm)] border px-4 py-2 text-sm transition-colors"
    >
      Cancel
    </a>
  </div>
</form>
