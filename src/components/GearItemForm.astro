---
// The gear item create/edit form (PK-4), shared by src/pages/gear/new.astro and
// src/pages/gear/[id].astro so the two pages cannot silently drift apart on field
// names, labels, error wiring or markup — the entire reason this exists as one
// component rather than two copies. It renders every editable `gear_items` field
// EXCEPT a photo: Ref 10 owns the photo upload and no storage exists yet, so there is
// deliberately no file input here — its absence is a decision, not an oversight.
//
// KEEP THIS A PLAIN .astro COMPONENT, mirroring GearNav's own rule. It takes no
// `client:*` directive anywhere it is used and must never gain one: every field here
// works with JavaScript disabled because the whole form is a real POST, and nothing in
// it needs a browser-side decision to render or to submit.
//
// NO DECISION-MAKING LIVES HERE. Every prop this component reads is already a decided
// value — `values` and `errors` come from `parseGearItemForm` or `gearItemToFormValues`
// in src/lib/gear/form.ts, both covered by tests/gear-form.test.ts. This component only
// arranges markup around them; see that module's own "WHY THIS LIVES IN src/lib/ RATHER
// THAN IN THE PAGE" for why the validation itself could not live here instead.
// `acquiredOnFutureCutoff` is PK-61's; `GEAR_STATUS_MEANINGS` is PK-63's, for the title
// tooltip on each radio option.
import { GEAR_FORM_FIELD, acquiredOnFutureCutoff, type GearFormValues } from '../lib/gear/form';
import { GEAR_STATUS_MEANINGS, GEAR_STATUSES } from '../lib/gear/fields';
import { formatGearStatus } from '../lib/gear/format';
import { WEIGHT_ENTRY_UNIT, type WeightSystem } from '../lib/units';
import GearStatusIcon from './GearStatusIcon.astro';
// `NEXT_PARAM` only — safe not because src/lib/auth-routes.ts is dependency-free (it is
// not: it imports `./routes`, its own header comment's "the one import this file has"),
// but because it sits OUTSIDE `src/lib/auth/`, the only directory Invariant A in
// `tests/anonymous-read-path.test.ts` guards edges into. That is what "one door away
// from the choke point" (auth-routes.ts's own phrase) means — a module that can import
// freely because it never crosses the guarded boundary, not one with no imports of its
// own. Nothing here touches an auth SDK or a Supabase client; this form does not become
// an AUTH_CONSUMERS entry by reading a path.
import { NEXT_PARAM } from '../lib/auth-routes';

interface Props {
  values: GearFormValues;
  errors: Readonly<Record<string, string>>;
  submitLabel: string;
  cancelHref: string;
  /** A hidden field this page's own POST handler needs to tell this submission apart
   *  from another form on the same page — e.g. `src/pages/gear/[id].astro`'s edit form
   *  next to its own separate delete form. Omitted on `new.astro`, whose page has only
   *  one form and so nothing to disambiguate. */
  intentField?: { readonly name: string; readonly value: string };
  /** The category names already in use, offered as `<datalist>` suggestions under the
   *  Category field (PK-63) — see that field's own comment below for why a `datalist`
   *  rather than a `<select>`. The page that renders this form is responsible for
   *  querying which categories exist; this component only arranges them into options. */
  categories: readonly string[];
  /** The post-submit return path, rendered as a hidden field when the caller supplies
   *  one — see the field itself, further down, for why this travels through the form
   *  rather than the page reading it straight off the URL. This component only accepts
   *  and renders it; both new.astro and [id].astro pass it. */
  next?: string;
  /** The account's weight system (PK-67), which decides the unit the Weight field is
   *  typed in and the suffix beside it. Passed in rather than read here for the reason
   *  this component's header comment gives: it makes no decisions and holds no client —
   *  the page has already loaded the preference through `readWeightSystem`, and the same
   *  value has to reach `parseGearItemForm` on that page's POST for the round trip to be
   *  exact. Two readers, one value, supplied by whoever owns the request. */
  weightSystem: WeightSystem;
}

const { values, errors, submitLabel, cancelHref, intentField, categories, next, weightSystem } =
  Astro.props;

/** `g` for a metric account, `oz` for an imperial one — the unit this form's Weight field
 *  is typed in, and the suffix rendered beside it. Entry is always in the system's base
 *  unit and never scales: an item the closet lists as `1.85 kg` opens here as `1850` with
 *  a `g` suffix, which PK-67 calls out so it is not later filed as a bug. */
const entryUnit = WEIGHT_ENTRY_UNIT[weightSystem];

// PK-64 (Notebook Paper): every control below reads its box, label, hint and error
// styling straight off src/styles/paper.css's vocabulary — `.field` / `.field-label` /
// `.field-error` / `.field-required` for every text input, textarea and the date input,
// and `.segmented` / `.segment` for Status (see that field's own comment further down).
// There is no local class-constant table any more: the INPUT_CLASS / LABEL_CLASS /
// ERROR_CLASS / STATUS_OPTION_CLASS strings this used to declare duplicated exactly what
// paper.css now names once. The one rule to hold onto from that era: NEVER reach for the
// `font:` shorthand anywhere in this file — see paper.css's own header comment for why a
// later shorthand naming the system face silently overrides an earlier written-face rule
// of equal specificity. That bug put every field in this exact form into the wrong voice
// twice in the prototype this file's language is ported from.
//
// The error SUMMARY that used to render here — "Fix the following before saving:" — is
// gone from this component entirely, not merely restyled. DESIGN.md §2.5: a note may
// only lie directly on the paper, never on a sheet, and this component is always
// rendered from inside one (see the shape both new.astro and [id].astro now share). Both
// pages already hold the same `errors`/`formErrors` this component receives as a prop, so
// each renders that summary itself, as a `.note.note-danger` ABOVE its `.sheet`, exactly
// where the PK-64 reference shots put it — see either page's own frontmatter for where. What
// stays here is the field-level error text beside each control, which the mockup keeps
// inside the sheet because it is scoped to one box rather than the whole submission.

function describedBy(field: string): string | undefined {
  return errors[field] ? `${field}-error` : undefined;
}

function invalid(field: string): 'true' | undefined {
  return errors[field] ? 'true' : undefined;
}

// The date input's `max`, computed from the SAME rule `src/lib/gear/form.ts`'s
// `isAcquiredOnInFuture` enforces server-side (today in UTC, plus one day of
// cross-time-zone slack — see that function's own comment for why the slack exists).
// This is a CONVENIENCE ONLY, not a second source of truth for the rule: a native date
// picker that discourages picking a future day in the first place is a nicer
// experience than always round-tripping to the server to find out, but a crafted POST
// ignores `max` entirely, so `parseGearItemForm` remains the one place this is actually
// enforced. Reading `acquiredOnFutureCutoff()` rather than recomputing the bound here
// is what keeps the hint from silently drifting out of step with the real check.
const acquiredOnMax = acquiredOnFutureCutoff();
---

<form method="POST">
  {intentField && <input type="hidden" name={intentField.name} value={intentField.value} />}
  {
    /* The same mechanism sign-in.astro and sign-up.astro use for their own `next`
       fields (see NEXT_PARAM's comment in src/lib/auth-routes.ts): a
       `<form method="POST">` with no `action` posts to the current URL, so a `next`
       carried only in the query string would already survive an ordinary submit, but
       putting it in the form as well means it also survives an `action` being added to
       this form later for any reason — the exact silent-drop failure mode
       `nextFromForm`'s own comment describes for those two pages. This component only
       renders whatever it is given; new.astro and [id].astro decide where it points. */
  }
  {next !== undefined && <input type="hidden" name={NEXT_PARAM} value={next} />}

  <div class="flex flex-col gap-5">
    <div>
      <label for="name" class="field-label">
        Name <span aria-hidden="true" class="field-required">*</span>
      </label>
      <input
        id="name"
        name={GEAR_FORM_FIELD.name}
        type="text"
        value={values.name}
        aria-required="true"
        aria-describedby={describedBy('name')}
        aria-invalid={invalid('name')}
        class="field mt-1 w-full"
      />
      {
        /* NOT the HTML `required` attribute, deliberately. `required` triggers native
           constraint validation, which blocks the form submit entirely in-browser the
           moment Name is blank — the visitor never leaves the page, `parseGearItemForm`
           never runs, and this ticket's own acceptance criterion ("a blank Name re-renders
           the form with the field outlined in --rust") could not be demonstrated in a
           browser, because the browser would refuse the submit first — constraint
           validation is bypassed by `novalidate` and by any non-browser client, so the
           server path this comment describes always runs regardless. `aria-required`
           communicates the same thing to assistive tech without touching submission
           behaviour, and the red asterisk communicates it visually; the actual
           enforcement — and the --rust border `.field[aria-invalid='true']` draws on
           `errors.name` below — stays entirely server-side in parseGearItemForm, same as
           every other field on this form. */
      }
      {
        errors.name && (
          <p id="name-error" class="field-error">
            {errors.name}
          </p>
        )
      }
    </div>

    <div class="grid gap-5 sm:grid-cols-2">
      <div>
        <label for="brand" class="field-label"> Brand </label>
        <input
          id="brand"
          name={GEAR_FORM_FIELD.brand}
          type="text"
          value={values.brand}
          class="field mt-1 w-full"
        />
      </div>
      <div>
        <label for="category" class="field-label"> Category </label>
        {
          /* `list`/`<datalist>`, not a `<select>` (PK-63). A datalist only SUGGESTS —
             the input stays free text, so typing a brand-new category a visitor's closet
             has never seen works exactly as it did before this field grew suggestions, and
             `parseGearItemForm` goes on receiving a bare string it validates the same way
             regardless of whether it came from a click or was typed by hand. A `<select>`
             would have to either invent an "Other" escape hatch or reject any category not
             already in `categories`, and this ticket asks for neither. */
        }
        <input
          id="category"
          name={GEAR_FORM_FIELD.category}
          type="text"
          list="category-options"
          value={values.category}
          class="field mt-1 w-full"
        />
        <datalist id="category-options">
          {categories.map((category) => <option value={category} />)}
        </datalist>
      </div>
    </div>

    <div>
      <label for="description" class="field-label"> Description </label>
      <textarea id="description" name={GEAR_FORM_FIELD.description} class="field mt-1 w-full"
        >{values.description}</textarea
      >
    </div>

    {
      /* Two columns, not three: PK-67 removed the weight-unit `<select>` that was the third,
        so Quantity and Weight now share the row evenly rather than leaving a gap where the
        unit picker used to be. */
    }
    <div class="grid gap-5 sm:grid-cols-2">
      <div>
        <label for="quantity" class="field-label"> Quantity </label>
        <input
          id="quantity"
          name={GEAR_FORM_FIELD.quantity}
          type="text"
          inputmode="numeric"
          value={values.quantity}
          aria-describedby={describedBy('quantity')}
          aria-invalid={invalid('quantity')}
          class="field mt-1 w-full"
        />
        {
          errors.quantity && (
            <p id="quantity-error" class="field-error">
              {errors.quantity}
            </p>
          )
        }
      </div>
      {
        /* PK-67: one control where there were two. The `<select>` of four units that stood
          beside this input is gone with the column behind it — the unit is one account-level
          setting now, so re-picking it per item was asking a per-person question once per
          row. What replaces it is not a control at all but a SUFFIX: the account's entry
          unit, rendered beside the box so the visitor can see which unit they are typing in
          without being able to change it here. `/account` is where it changes.

          THE SUFFIX IS LABEL TEXT, NOT DECORATION, which is why it is inside the `<label>`
          rather than floated next to the input. A screen reader announcing "Weight" and
          nothing else would leave the one fact this field depends on unspoken, and a purely
          visual suffix is exactly the shape that happens in. Putting it in the label makes
          the accessible name "Weight (g)" — the sighted and unsighted readings are then the
          same string rather than two things kept in step by hand.

          `aria-describedby` still points only at the error, deliberately: the unit is part of
          what this field IS, not a hint about it.

          THE FLOATING SUFFIX SPAN BELOW TAKES `.written.written` (PK-64), not the system
          face the label above it keeps: DESIGN.md §4 calls out a unit beside a weight as
          written because it is half of a value the visitor did type — the closet renders
          "539 g" entirely in the hand, and setting the box's own "539" in Klee One while
          this floating "g" stayed in Inter would split one quantity across two voices, the
          exact split this design's two-voices rule exists to prevent. `.field` already
          sets the box's own value to the written face; this span is a sibling of the
          `<input>`, not inside it, so it needs the escape hatch rather than inheriting one. */
      }
      <div>
        <label for="weight" class="field-label">
          Weight ({entryUnit})
        </label>
        <div class="relative">
          <input
            id="weight"
            name={GEAR_FORM_FIELD.weight}
            type="text"
            inputmode="decimal"
            value={values.weight}
            aria-describedby={describedBy('weight')}
            aria-invalid={invalid('weight')}
            class="field mt-1 w-full pr-10"
          />
          {
            /* aria-hidden because the label above already says the unit; announcing it twice
              would read as "Weight g, edit text, g". Purely the visual half of the pairing. */
          }
          <span
            aria-hidden="true"
            class="written written text-ink-3 pointer-events-none absolute inset-y-0 right-3 flex items-center text-sm"
          >
            {entryUnit}
          </span>
        </div>
        {
          errors.weight && (
            <p id="weight-error" class="field-error">
              {errors.weight}
            </p>
          )
        }
      </div>
    </div>

    <div class="grid gap-5 sm:grid-cols-2">
      <div>
        <label for="price" class="field-label"> Price </label>
        <input
          id="price"
          name={GEAR_FORM_FIELD.price}
          type="text"
          inputmode="decimal"
          value={values.price}
          aria-describedby={describedBy('price')}
          aria-invalid={invalid('price')}
          class="field mt-1 w-full"
        />
        {
          errors.price && (
            <p id="price-error" class="field-error">
              {errors.price}
            </p>
          )
        }
      </div>
      <div>
        <label for="currency" class="field-label"> Currency </label>
        <input
          id="currency"
          name={GEAR_FORM_FIELD.currency}
          type="text"
          placeholder="GBP"
          value={values.currency}
          aria-describedby={describedBy('currency')}
          aria-invalid={invalid('currency')}
          class="field mt-1 w-full"
        />
        {
          errors.currency && (
            <p id="currency-error" class="field-error">
              {errors.currency}
            </p>
          )
        }
      </div>
    </div>

    <div class="grid gap-5 sm:grid-cols-2">
      <div>
        <label for="acquired_on" class="field-label"> Added </label>
        {
          /* A native <input type="date">, not a JS date-picker component (PK-61) — the
             calendar popup a visitor sees here is the BROWSER'S OWN, which is the entire
             reason this is a native date input rather than anything fancier: it needs no
             script to render or to submit, exactly like every other field in this
             component (see the module comment's "KEEP THIS A PLAIN .astro COMPONENT"
             rule), and it keeps working with JavaScript disabled the same way. */
        }
        <input
          id="acquired_on"
          name={GEAR_FORM_FIELD.acquiredOn}
          type="date"
          value={values.acquired_on}
          max={acquiredOnMax}
          aria-describedby={describedBy('acquired_on')}
          aria-invalid={invalid('acquired_on')}
          class="field mt-1 w-full"
        />
        {
          /* Echoes the REJECTED value back inside the error message rather than trusting
             the box above to still show it. HTML's value-sanitization algorithm for
             `type="date"` blanks the input's value to "" whenever it is not a syntactically
             valid date string — so a rejected `2026-02-30` (or `2026-2-3`, or any other
             malformed shape ACQUIRED_ON_PATTERN refuses) makes the browser clear the box
             on THIS re-render, even though `values.acquired_on` still faithfully carries
             what was typed. Without this echo, the visitor would see "Enter a valid date
             (...)" above a box the browser had already emptied for them — the rejected
             date silently downgraded to "I don't know", and simply resubmitting from there
             stores `null` instead of the correction they meant to make. Quoting the value
             back inside the message keeps that state legible even when the box itself goes
             blank, and keeps faith with parseGearItemForm's own promise that `values`
             carries back exactly what the visitor typed. (A genuinely future date like
             `9999-12-31` IS a syntactically valid date, so the browser does not blank that
             one — but echoing it here too costs nothing and keeps the message's wording
             uniform across both rejection reasons.) */
        }
        {
          errors.acquired_on && (
            <p id="acquired_on-error" class="field-error">
              {values.acquired_on.trim() === ''
                ? errors.acquired_on
                : `“${values.acquired_on}” is not a date this form can store. ${errors.acquired_on}`}
            </p>
          )
        }
      </div>
      <div>
        {
          /* PK-64: presented as ONE SEGMENTED CONTROL (DESIGN.md §6), not the bordered
             radio cards this used to draw — a choice of three or fewer says "exactly one
             of these is true", which a stack of independently-bordered options only
             implies. What is UNCHANGED is more load-bearing than what is not: these are
             still real `<input type="radio">` elements sharing one `name`, so "exactly
             one status" stays a STRUCTURAL property of the markup — the browser itself
             refuses to let two radios in the same group be checked at once — rather than
             one this component or a script would have to enforce, and it works
             identically with JavaScript disabled, same as every other field on this form:
             the group posts whichever `value` was checked, or nothing at all if none was,
             and `parseGearItemForm` is exactly as able to make sense of either outcome as
             it was reading a `<select>`'s single value. `.segment`'s own CSS positions
             each `<input>` as an invisible full-size overlay on its `<label>` (see
             paper.css) — the segment styling goes on the label, the radio itself is
             untouched markup. */
        }
        {
          /* aria-describedby AND aria-invalid GO ON THE RADIOS, NOT THE FIELDSET. A
             `<fieldset>` maps to role `group`, which does not support `aria-invalid` — put
             it there and assistive technology ignores it, so the field reads as valid while
             an error is showing. `aria-describedby` on the fieldset is likewise unreliable
             here: a screen-reader user arrowing between radios is inside the group, not on
             it, so the description is not necessarily re-announced. Both attributes are
             therefore repeated on every `<input type="radio">`, which is where a visitor's
             focus actually lands. The fieldset keeps the `<legend>`, which is what it is
             genuinely for. */
        }
        <fieldset>
          <legend class="field-label">Status</legend>
          <div class="segmented mt-1 w-full">
            {
              GEAR_STATUSES.map((status) => {
                const checked = status === values.status;
                return (
                  <label class="segment" title={GEAR_STATUS_MEANINGS[status]}>
                    <input
                      type="radio"
                      name={GEAR_FORM_FIELD.status}
                      value={status}
                      checked={checked}
                      aria-describedby={describedBy('status')}
                      aria-invalid={invalid('status')}
                    />
                    {/* GearStatusIcon bakes its own accent colour (moss/ochre-ink/rust)
                         onto the `<svg>` as a plain Tailwind colour utility, unconditionally
                         — see that component's `svgClass`. Left alone, that utility sits in
                         the UTILITIES layer and beats `.segment:has(input:checked)`'s
                         `color: var(--paper)` regardless of source order or specificity
                         (paper.css's own warning on `.segmented`), so the checked segment's
                         icon would stay coloured instead of reversing out white on the ink
                         fill the way the PK-64 reference shots show it. The `text-paper!` override
                         below is scoped to exactly the checked case for exactly that
                         reason: Tailwind v4's trailing `!` forces `!important`, which is
                         the one thing that reliably outranks another utility of the same
                         property regardless of generation order. Left undefined on an
                         unchecked segment, GearStatusIcon's own accent is exactly the
                         colour the mockup wants there, so nothing further is needed. */}
                    <GearStatusIcon
                      status={status}
                      decorative
                      class={checked ? 'text-paper!' : undefined}
                    />
                    {formatGearStatus(status)}
                  </label>
                );
              })
            }
          </div>
        </fieldset>
        {
          /* If `values.status` matches none of GEAR_STATUSES — a tampered or otherwise
             stale submission `parseGearItemForm` has already rejected via `errors.status`
             — NO segment ends up checked here. That is correct, not a bug to paper over:
             this component makes no decisions (see the header comment), so it has no
             business inventing a silent fallback to `owned` for a value the parser itself
             refused. The visitor sees the error below and an unchecked group, which is an
             honest reflection of "you did not tell us a valid status", not a wrong answer
             picked on their behalf. */
        }
        {
          errors.status && (
            <p id="status-error" class="field-error">
              {errors.status}
            </p>
          )
        }
      </div>
    </div>

    <div>
      <label for="url" class="field-label"> Web address </label>
      <input
        id="url"
        name={GEAR_FORM_FIELD.url}
        type="text"
        placeholder="https://"
        value={values.url}
        aria-describedby={describedBy('url')}
        aria-invalid={invalid('url')}
        class="field mt-1 w-full"
      />
      {
        errors.url && (
          <p id="url-error" class="field-error">
            {errors.url}
          </p>
        )
      }
    </div>

    <div>
      <label for="notes" class="field-label"> Notes </label>
      <textarea id="notes" name={GEAR_FORM_FIELD.notes} class="field mt-1 w-full"
        >{values.notes}</textarea
      >
    </div>
  </div>

  <hr class="sheet-rule" />

  <div class="flex gap-3">
    <button type="submit" class="btn btn-primary">
      {submitLabel}
    </button>
    <a href={cancelHref} class="btn"> Cancel </a>
  </div>
</form>
